cmd({
  pattern: "privacy",
  desc: "send ptv Message of video",
  category: "whatsapp",
  filename: __filename
}, async (ctx, text, {
  cmdName: cmdName
}) => {
  try {
    const privacy = await ctx.bot.fetchPrivacySettings();
    txt = "*[WHATSAPP PRIVACY SETTINGS]*\n\n*PROFILE:* " + privacy.profile + "\n*STATUS:* " + privacy.status + "\n*ONLINE:* " + privacy.online + "\n*LASTSEEN:* " + privacy.last + "\n*MESSAGE READ:* " + privacy.readreceipts + "\n\n*Who can add in group:* " + privacy.groupadd + "\n*Who can call:* " + privacy.calladd + "\n    ";
    await ctx.send(txt);
  } catch (err) {
    await ctx.error(err + "\n\ncommand : privacy", err);
  }
});
let mtypes = ["imageMessage"];
smd({
  pattern: "pp",
  desc: "Set profile picture",
  category: "whatsapp",
  use: "<reply to image>",
  fromMe: true,
  filename: __filename
}, async ctx => {
  try {
    let quoted = mtypes.includes(ctx.mtype) ? ctx : ctx.reply_message;
    if (!quoted || !mtypes.includes(quoted?.mtype || "need_Media")) {
      return await ctx.reply("*Reply to an image, dear*");
    }
    return await updateProfilePicture(ctx, ctx.user, quoted, "pp");
  } catch (err) {
    await ctx.error(err + "\n\ncommand : pp", err);
  }
});
