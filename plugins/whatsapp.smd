cmd({
  pattern: "ptv",
  desc: "send ptv Message of video",
  category: "whatsapp",
  filename: __filename
}, async (ctx, text, {
  cmdName: cmdName
}) => {
  try {
    if (!ctx.quoted) {
      return await ctx.send("*Uhh Please, reply to video*");
    }
    let quotedType = ctx.quoted.mtype;
    if (quotedType !== "videoMessage") {
      return await ctx.send("*Uhh Dear, reply to a video message*");
    }
    return await ctx.bot.forwardOrBroadCast2(ctx.chat, ctx.quoted, {}, cmdName);
  } catch (err) {
    await ctx.error(err + "\n\ncommand : ptv", err);
  }
});
