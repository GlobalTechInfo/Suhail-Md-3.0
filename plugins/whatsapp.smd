cmd({
  pattern: "vv",
  alias: ["viewonce", "retrive"],
  desc: "download viewOnce Message.",
  category: "whatsapp",
  use: "<query>",
  filename: __filename
}, async (ctx, text) => {
  try {
    var viewOnceMsg = ctx.reply_message && ctx.reply_message.viewOnce ? ctx.reply_message : false;
    if (!viewOnceMsg) {
      return ctx.reply("```Please Reply A ViewOnce Message```");
    }
    let quoted = {
      key: viewOnceMsg.key,
      message: {
        conversation: "```[VIEWONCE FOUND DOWNLOAD 100%]```"
      }
    };
    let mediaPath = await ctx.bot.downloadAndSaveMediaMessage(viewOnceMsg.msg);
    await ctx.bot.sendMessage(ctx.jid, {
      [viewOnceMsg.mtype2.split("Mes")[0]]: {
        url: mediaPath
      },
      caption: viewOnceMsg.body
    }, {
      quoted: quoted
    });
  } catch (err) {
    // was `message.error` - there is no `message` in this handler (it is `ctx`), so any failure
    // inside .vv threw a second ReferenceError and the actual cause was lost.
    await ctx.error(err + "\n\ncommand: vv", err);
  }
});
