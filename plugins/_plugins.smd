let Suhail_Md = "Suhail MD Whatsapp bot md";
const axios = require("axios");
const fs = require("fs-extra");
const {
  exec
} = require("child_process");
const {
  plugins,
  isUrl,
  smd,
  tlang,
  Config,
  smdJson,
  smdBuffer,
  thumbPath
} = require("../lib");
let s_ser = true;
smd({
  cmdname: "restart",
  info: "To restart bot",
  type: "tools",
  fromMe: s_ser,
  filename: __filename
}, async ctx => {
  const {
    exec: restart
  } = require("child_process");
  ctx.reply("Restarting");
  restart("pm2 restart all");
});
smd({
  cmdname: "listplugin",
  type: "owner",
  info: "Shows list of all external modules",
  filename: __filename,
  use: "<name>"
}, async ctx => {
  try {
    let remotePlugins = await smdJson("https://raw.githubusercontent.com/SuhailTechInfo/Suhail-Md-Media/main/plugins/listPlugin.json");
    if (remotePlugins && remotePlugins.result && remotePlugins.result[0]) {
      let caption = "";
      for (let i = 0; i < remotePlugins.result.length; i++) {
        caption += remotePlugins.result[i].name + ": _" + remotePlugins.result[i].url + "_\n\n";
      }
      let pluginsImage = await smdBuffer(thumbPath);
      var contextInfo = {
        ...(await ctx.bot.contextInfo("ꜱᴜʜᴀɪʟ-ᴍᴅ", "Pʟᴜɢɪɴꜱ", pluginsImage ? pluginsImage : log0, 1, gurl, "1"))
      };
      await ctx.reply(caption, {
        contextInfo: contextInfo
      });
    }
    if (remotePlugins && remotePlugins.external && remotePlugins.external[0]) {
      let caption = "";
      let externalImage = await smdBuffer(thumbPath);
      var contextInfo = {
        ...(await ctx.bot.contextInfo("ꜱᴜʜᴀɪʟ-ᴍᴅ", "ᴇxᴛᴇʀɴᴀʟ ᴍᴏᴅᴜʟᴇ", externalImage ? externalImage : log0, 1, gurl, "1"))
      };
      for (let i = 0; i < remotePlugins.external.length; i++) {
        caption += remotePlugins.external[i].name + ": _" + remotePlugins.external[i].url + "_\n\n";
      }
      await ctx.reply(caption, {
        contextInfo: contextInfo
      });
    }
  } catch (err) {
    ctx.error(err + " \n\ncmdName listplugin", err);
  }
});
smd({
  cmdname: "plugins",
  alias: ["plugin"],
  type: "owner",
  info: "Shows list of all externally installed modules",
  fromMe: s_ser,
  filename: __filename,
  use: "<name>"
}, async (ctx, text) => {
  try {
    let installed = await plugins(ctx, "plugins", text);
    return await ctx.send(!installed ? "*_There's no plugin install in " + Config.botname + "_*" : !text ? "*All Installed Modules are:-*\n\n" + installed : installed);
  } catch (err) {
    ctx.error(err + " \n\ncmdName plugins\n");
  }
});
smd({
  pattern: "remove",
  alias: ["uninstall"],
  type: "owner",
  info: "removes external modules.",
  fromMe: s_ser,
  filename: __filename,
  use: "<plugin name>"
}, async (ctx, text) => {
  if (!text) {
    return await ctx.reply("*_Uhh Please, Provide Me Plugin Name_*");
  }
  if (text === "alls") {
    return await ctx.reply(await plugins("remove", "all", __dirname));
  }
  try {
    await ctx.send(await plugins(ctx, "remove", text, __dirname), {}, "", ctx);
  } catch {}
});
smd({
  cmdname: "install",
  type: "owner",
  info: "Installs external modules..",
  fromMe: s_ser,
  filename: __filename,
  use: "<gist url>"
}, async (ctx, text) => {
  let quotedText = text ? text : ctx.quoted ? ctx.quoted.text : "";
  if (!quotedText.toLowerCase().includes("https")) {
    return await ctx.send("*_Uhh Please, Provide Me Plugin Url_*");
  }
  await ctx.reply(await plugins(ctx, "install", quotedText, __dirname));
});
