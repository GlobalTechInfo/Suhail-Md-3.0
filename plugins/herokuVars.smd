smd({
  pattern: "getvar",
  desc: "To Get A Heroku Var",
  category: "tools",
  fromMe: true,
  filename: __filename
}, async (ctx, text, {
  cmdName: cmdName
}) => {
  try {
    if (!text) {
      return ctx.reply("*Please give me Variable Name*\n*Example : " + (prefix + cmdName) + " CAPTION*");
    }
    const key = text.split(" ")[0].toUpperCase();
    let getResult = await heroku.getvar(key);
    if (getResult.status) {
      if (getResult.data) {
        return ctx.reply("*" + key + " :* " + getResult.data);
      } else {
        return ctx.reply("*" + key + "* does not exist in Heroku *" + appName + "* app.");
      }
    } else if (!getResult || !getResult.status) {
      console.error(result.data);
      await ctx.reply("*_There's no responce from HEROKU_*, \n  _please check that you put valid_\n  _*HEROKU_APP_NAME* & *HEROKU_API_KEY*_");
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: " + cmdName, err);
  }
});
smd({
  pattern: "setvar",
  desc: "To Set Heroku Vars",
  category: "tools",
  fromMe: true,
  filename: __filename
}, async (ctx, text, {
  smd: smdHelper
}) => {
  try {
    if (!text) {
      return ctx.reply("*Uhh dear, Give me variable name*\n*Example : " + prefix + "setvar PREFIX:null*");
    }
    const separatorIndex = text.indexOf(":");
    const envKey = text.slice(0, separatorIndex).toUpperCase().trim();
    const envValue = text.slice(separatorIndex + 1).trim();
    if (!envValue) {
      return msg.reply("*Uhh Please, Provide value after ':' !*\n*Example : " + (prefix + smdHelper) + " AUTO_READ_STATUS:true*");
    }
    process.env[envKey] = envValue;
    updateConfig();
    let setResult = await heroku.setvar(envKey, envValue);
    if (setResult.status) {
      await ctx.reply("*" + envKey + ":* [ " + envValue + " ]  *updated successfully.*");
    } else if (!setResult || !setResult.status) {
      console.error(setResult.data);
      await ctx.reply(setResult.data);
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: " + smdHelper, err);
  }
});
