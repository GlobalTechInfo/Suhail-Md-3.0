let Suhail_Md = "Suhail MD Whatsapp bot md";
const Config = require("../config");
let {
  fancytext,
  tlang,
  tiny,
  runtime,
  formatp,
  botpic,
  prefix,
  sck1,
  smd,
  lidMap,
  thumbPath
} = require("../lib");
const axios = require("axios");
const appName = Config.HEROKU_APP_NAME ? Config.HEROKU_APP_NAME.toLowerCase() : "";
const authToken = Config.HEROKU_API_KEY;
const HEROKU = authToken && appName ? true : false;
const fetch = require("node-fetch");
let updateConfig = () => {
  try {
    let configPath = "../config";
    delete require.cache[configPath];
    require(configPath);
    return true;
  } catch (err) {
    console.log(err);
  }
};
const heroku = {};
heroku.addvar = async (key, value) => {
  try {
    const headers = {
      Accept: "application/vnd.heroku+json; version=3",
      Authorization: "Bearer " + authToken,
      "Content-Type": "application/json"
    };
    const response = await fetch("https://api.heroku.com/apps/" + appName + "/config-vars", {
      method: "PATCH",
      headers: headers,
      body: JSON.stringify({
        [key]: value
      })
    });
    const configVars = await response.json();
    return {
      status: true,
      data: configVars
    };
  } catch (err) {
    return {
      status: false,
      data: err
    };
  }
};
heroku.getallvar = async () => {
  try {
    const headers = {
      Accept: "application/vnd.heroku+json; version=3",
      Authorization: "Bearer " + authToken
    };
    const response = await fetch("https://api.heroku.com/apps/" + appName + "/config-vars", {
      headers: headers
    });
    const configVars = await response.json();
    let varsHeader = "   『 *" + appName + " VARS* 』 \n*________________________________________*\n";
    Object.keys(configVars).forEach(item => {
      varsHeader += "*" + item + " :*  " + (configVars[item] ? "```" + configVars[item] + "```" : "") + " \n";
    });
    return {
      status: true,
      data: varsHeader
    };
  } catch (err) {
    return {
      status: false,
      data: err.message || err
    };
  }
};
heroku.getvar = async key => {
  try {
    const headers = {
      Accept: "application/vnd.heroku+json; version=3",
      Authorization: "Bearer " + authToken
    };
    const response = await fetch("https://api.heroku.com/apps/" + appName + "/config-vars", {
      headers: headers
    });
    const configVars = await response.json();
    return {
      status: true,
      data: configVars[key]
    };
  } catch (err) {
    return {
      status: false,
      data: err.message || err
    };
  }
};
heroku.setvar = async (key, value) => {
  try {
    const headers = {
      Accept: "application/vnd.heroku+json; version=3",
      Authorization: "Bearer " + authToken,
      "Content-Type": "application/json"
    };
    fetch("https://api.heroku.com/apps/" + appName + "/config-vars", {
      method: "GET",
      headers: headers
    }).then(apiResult => {
      if (apiResult.ok) {
        return apiResult.json();
      } else {
        return {
          status: false,
          data: "Failed to fetch app variables. Status: " + apiResult.status
        };
      }
    }).then(apiResult => {
      if (apiResult.hasOwnProperty(key)) {
        const payload = {
          ...apiResult
        };
        payload[key] = value;
        return fetch("https://api.heroku.com/apps/" + appName + "/config-vars", {
          method: "PATCH",
          headers: headers,
          body: JSON.stringify(payload)
        });
      } else {
        return {
          status: false,
          data: "Variable not found in app"
        };
      }
    }).then(apiResult => {
      if (apiResult.ok) {
        return {
          status: true,
          data: apiResult
        };
      }
    }).catch(err => {
      return {
        status: false,
        data: err
      };
    });
  } catch (err) {
    return {
      status: false,
      data: err
    };
  }
};
heroku.setvar = async (key, value) => {
  try {
    const headers = {
      Accept: "application/vnd.heroku+json; version=3",
      Authorization: "Bearer " + authToken,
      "Content-Type": "application/json"
    };
    const response = await fetch("https://api.heroku.com/apps/" + appName + "/config-vars", {
      method: "GET",
      headers: headers
    });
    if (!response.ok) {
      return {
        status: false,
        data: "Variable not found in heroku app"
      };
    }
    const configVars = await response.json();
    if (configVars.hasOwnProperty(key)) {
      const payload = {
        ...configVars
      };
      payload[key] = value;
      const setResponse = await fetch("https://api.heroku.com/apps/" + appName + "/config-vars", {
        method: "PATCH",
        headers: headers,
        body: JSON.stringify(payload)
      });
      if (setResponse.ok) {
        return {
          status: true,
          data: setResponse
        };
      } else {
        return {
          status: false,
          data: "Failed to update app variable. Status: " + setResponse.status
        };
      }
    } else {
      return {
        status: false,
        data: "Variable not found in app"
      };
    }
  } catch (err) {
    return {
      status: false,
      data: err.message || err
    };
  }
};
smd({
  cmdname: "getsudo",
  alias: ["mods", "gsudo"],
  info: "get sudo users list.",
  fromMe: true,
  type: "tools",
  filename: __filename
}, async ctx => {
  let sudoList = global.sudo.split(",").filter(item => item && item !== "null").map(item => item.trim());
  let sudoLines = sudoList.map((item, index) => "  " + (index + 1) + " 〄 @" + item + "\n\n").join("");
  let mentions = [ctx.sender, ...sudoList.map(item => item + "@s.whatsapp.net")];
  if (!sudoLines || !sudoList || !sudoList[0]) {
    return await ctx.reply("*There's no mods/sudo added for your bot!*");
  }
  let modsCaption = ("\n   👤 *" + (Config.botname ? Config.botname : "SUHAIL-MD ") + " MODS* 👤\n   \n" + sudoLines).trim();
  // was a telegra.ph URL; that host is unreachable here so the reply silently never arrived.
  return await ctx.reply(thumbPath, {
    caption: modsCaption,
    mentions: mentions
  }, "img", ctx);
});
smd({
  pattern: "setsudo",
  alias: ["ssudo", "setmod"],
  fromMe: true,
  desc: "Make sudo to a user",
  category: "tools",
  filename: __filename
}, async ctx => {
  try {
    let sender = ctx.reply_message ? ctx.reply_message.sender : ctx.mentionedJid[0] ? ctx.mentionedJid[0] : "";
    if (!sender) {
      return await ctx.reply("*Uhh dear, reply/mention an User*");
    }
    // Store the PHONE number: previously a @lid mention passed the "@s.whatsapp.net" guard and
    // the raw lid digits were written into global.sudo, which then never matched anything.
    const sudoNumber = lidMap.numberOf(sender);
    if (global.sudo.split(",").map(n => n.trim()).includes(sudoNumber)) {
      return ctx.reply("*Number Already Exist In Sudo!*");
    }
    global.sudo += "," + sudoNumber;
    let addResult = HEROKU ? await heroku.addvar("SUDO", global.sudo) : {
      status: false
    };
    if (addResult && addResult.status) {
      return ctx.reply("*" + sudoNumber + " Added Succesfully.*\nSudo Numbers : ```" + global.sudo + "```");
    } else if (!addResult || !addResult?.status) {
      if (HEROKU) {
        await ctx.reply("*_Request terminated due to error!_*\n\n  There's no responce from _HEROKU_, \n  please check that you put valid _HEROKU_APP_NAME_ and _HEROKU_API_KEY_");
      }
      await ctx.reply("*User temporary added in sudo.*");
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: setsudo", err);
  }
});
smd({
  pattern: "delsudo",
  alias: ["dsudo", "delmod"],
  fromMe: true,
  desc: "delete sudo user.",
  category: "tools",
  filename: __filename
}, async ctx => {
  try {
    let sender = ctx.reply_message ? ctx.reply_message.sender : ctx.mentionedJid[0] ? ctx.mentionedJid[0] : "";
    if (!sender || !sender.includes("@s.whatsapp.net")) {
      return await ctx.reply("*Uhh dear, reply/mention an User*");
    }
    let sudoNumber = sender.split("@")[0];
    let sudoEntry = "," + sudoNumber;
    if (global.sudo.includes(sudoEntry)) {
      global.sudo = global.sudo.replace(sudoEntry, "");
    } else {
      return await ctx.reply("*_User not found in the Sudo List!_*");
    }
    let addResult = HEROKU ? await heroku.addvar("SUDO", global.sudo) : {
      status: false
    };
    if (addResult && addResult.status) {
      return ctx.reply("*" + sudoNumber + " Deleted Succesfully.*\nSudo Numbers : ```" + global.sudo + "```");
    } else if (!addResult || !addResult?.status) {
      if (HEROKU) {
        await ctx.reply("*_Request terminated due to error!_*\n\n  There's no responce from _HEROKU_, \n  please check that you put valid _HEROKU_APP_NAME_ and _HEROKU_API_KEY_");
      }
      await ctx.reply("*User removed from sudo.*");
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: delsudo", err);
  }
});
