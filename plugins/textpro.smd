const axios = require("axios");
let { smd, prefix } = require("../lib");

// qasimdev Ephoto360 "Custom Effect" API. Note: the public docs list the route as
// /api/ephoto/custom, but that path returns "Route not found" on the live server —
// /api/ephoto/customEffect is the route that actually resolves. Each effect is addressed by its
// full en.ephoto360.com page URL. 1-text effects take `text`; 2-text effects take `text1`/`text2`.
const EPHOTO_API = "https://api.qasimdev.dpdns.org/api/ephoto/customEffect";
const EPHOTO_KEY = "qasim-dev";
const EPHOTO_TIMEOUT = 120000;

// cmdname -> { url, texts }. `texts` is how many inputs the effect expects (1 or 2).
const EFFECTS = {
  slice: { url: "https://en.ephoto360.com/create-sliced-light-text-effect-online-712.html", texts: 1 },
  glow: { url: "https://en.ephoto360.com/create-glowing-text-effects-online-706.html", texts: 1 },
  gitch1: { url: "https://en.ephoto360.com/create-pixel-glitch-text-effect-online-769.html", texts: 1 },
  steal: { url: "https://en.ephoto360.com/dragon-steel-text-effect-online-347.html", texts: 1 },
  avenger: { url: "https://en.ephoto360.com/create-logo-3d-style-avengers-online-427.html", texts: 2 },
  marvel: { url: "https://en.ephoto360.com/create-marvel-style-logo-419.html", texts: 2 },
  phub: { url: "https://en.ephoto360.com/create-pornhub-style-logos-online-free-549.html", texts: 2 },
  glitch: { url: "https://en.ephoto360.com/create-digital-glitch-text-effects-online-767.html", texts: 1 },
  glitch2: { url: "https://en.ephoto360.com/create-impressive-neon-glitch-text-effects-online-768.html", texts: 1 },
  grafiti: { url: "https://en.ephoto360.com/create-a-cartoon-style-graffiti-text-effect-online-668.html", texts: 1 }
};

// Calls the API and returns the generated image URL. `input` is the raw user text; two-text
// effects split it on ";".
async function ephotoEffect(url, texts, input) {
  const params = { apiKey: EPHOTO_KEY, url };
  if (texts === 2) {
    const parts = String(input || "").split(";").map(s => s.trim());
    params.text1 = parts[0] || "";
    params.text2 = parts[1] || "";
  } else {
    params.text = String(input || "").trim();
  }
  const res = await axios.get(EPHOTO_API, {
    params,
    timeout: EPHOTO_TIMEOUT,
    validateStatus: () => true,
    transformResponse: d => d
  });
  const raw = String(res.data === undefined || res.data === null ? "" : res.data);
  if (!raw.trim().startsWith("{")) {
    throw new Error("Ephoto360 API returned a non-JSON response (HTTP " + res.status + ")");
  }
  const body = JSON.parse(raw);
  if (body.success !== true || !body.data || !body.data.image_url) {
    throw new Error(body.error || body.message || "effect generation failed");
  }
  return body.data.image_url;
}

// Register one command per effect. `for...of` over Object.entries gives each iteration its own
// cmdName/effect bindings, so the closures capture the right values.
for (const [cmdName, effect] of Object.entries(EFFECTS)) {
  smd({
    cmdname: cmdName,
    type: "logo",
    info: "Some text to image feature with various styles.",
    filename: __filename
  }, async (ctx, text) => {
    try {
      const input = String(text || "").trim();
      if (effect.texts === 2) {
        const [a, b] = input.split(";").map(s => s.trim());
        if (!a || !b) {
          return ctx.reply("*_Example : " + (prefix + cmdName) + " text1;text2_*");
        }
      } else if (!input) {
        return ctx.reply("*_Example : " + (prefix + cmdName) + " Suhail_*");
      }
      const imageUrl = await ephotoEffect(effect.url, effect.texts, input);
      const logoData = (await ctx.bot.contextInfo("ᴛᴇxᴛ ᴛᴏ ʟᴏɢᴏ", "Hello " + ctx.senderName)) || {};
      return await ctx.bot.sendMessage(ctx.jid, {
        image: { url: imageUrl },
        contextInfo: logoData
      }, { messageId: ctx.bot.messageId() });
    } catch (err) {
      return await ctx.error(err + "\n\ncmdName: " + cmdName, err);
    }
  });
}
