let Suhail_Md = "Suhail MD Whatsapp bot md";
const Config = require("../config");
let {
  smd,
  lang,
  textToLogoGenerator,
  prefix
} = require("../lib");
smd({
  cmdname: "slice",
  type: "logo",
  info: "Some text to image feature with various styles.",
  filename: __filename
}, async (ctx, text, {
  cmdName: cmdName
}) => {
  try {
    if (!text) {
      return ctx.reply("*_Example : " + (prefix + cmdName) + " Suhail_*");
    }
    return await textToLogoGenerator(ctx, "create-light-glow-sliced-text-effect-online-1068", text);
  } catch (err) {
    return await ctx.error(err + "\n\ncmdName: " + cmdName, err);
  }
});
