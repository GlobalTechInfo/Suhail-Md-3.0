smd({
  pattern: "pokemon",
  category: "Anime Pics",
  filename: __filename,
  desc: "Sends info of pokemon in current chat."
}, async (ctx, text) => {
  try {
    if (!text) {
      return ctx.reply("*Uhh Please Give Me Poki Name/num*");
    }
    try {
      let {
        data: character
      } = await axios.get("https://pokeapi.co/api/v2/pokemon/" + text);
      if (!character.name) {
        return ctx.reply("❌ Could not found any pokemon with that name");
      }
      let caption = "*•Name: " + character.name + "*\n*•Pokedex ID: " + character.id + "*\n*•Height: " + character.height + "*\n*•Weight: " + character.weight + "*\n*•Abilities: " + character.abilities[0].ability.name + ", " + character.abilities[1].ability.name + "*\n*•Base Experience: " + character.base_experience + "*\n*•Type: " + character.types[0].type.name + "*\n*•Base Stat: " + character.stats[0].base_stat + "*\n*•Attack: " + character.stats[1].base_stat + "*\n*•Defense: " + character.stats[2].base_stat + "*\n*•Special Attack: " + character.stats[3].base_stat + "*\n*•Special Defense:" + character.stats[4].base_stat + "*\n*•Speed: " + character.stats[5].base_stat + "*\n";
      // was `Suhail.bot` - Suhail is module-scoped inside lib/smd.js, so in this file it was an
      // undefined identifier. Every other handler here uses ctx.bot.
      return await ctx.bot.sendMessage(ctx.jid, {
        image: {
          url: character.sprites.front_default
        },
        caption: caption
      }, {
        quoted: ctx
      });
    } catch (err) {
      ctx.reply("*_Ahh,Couldn't found any pokemon._*");
    }
  } catch {}
});
