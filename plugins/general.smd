smd({
  pattern: "cpu",
  desc: "To check bot status",
  category: "general",
  filename: __filename
}, async ctx => {
  try {
    const memoryUsage = process.memoryUsage();
    const samples = os.cpus().map(item => {
      item.total = Object.keys(item.times).reduce((acc, entry) => acc + item.times[entry], 0);
      return item;
    });
    const stats = samples.reduce((acc, item, unused, {
      length: sampleList
    }) => {
      acc.total += item.total;
      acc.speed += item.speed / sampleList;
      acc.times.user += item.times.user;
      acc.times.nice += item.times.nice;
      acc.times.sys += item.times.sys;
      acc.times.idle += item.times.idle;
      acc.times.irq += item.times.irq;
      return acc;
    }, {
      speed: 0,
      total: 0,
      times: {
        user: 0,
        nice: 0,
        sys: 0,
        idle: 0,
        irq: 0
      }
    });
    timestampe = speed();
    latensie = speed() - timestampe;
    var startTime = performance.now();
    var endTime = performance.now();
    respon = ("*❲❒❳ " + Config.botname + " Server Info ❲❒❳*\n\n  *❲❒❳ Runtime:* " + runtime(process.uptime()) + "\n  *❲❒❳ Speed:* " + latensie.toFixed(3) + "/" + (endTime - startTime).toFixed(3) + " ms\n  *❲❒❳ RAM:* " + formatp(os.totalmem() - os.freemem()) + " / " + formatp(os.totalmem()) + "\n\n  *❲❒❳ Memory Usage:*\n      " + Object.keys(memoryUsage).map((item, index, items) => item.padEnd(Math.max(...items.map(entry => entry.length)), " ") + ": " + formatp(memoryUsage[item])).join("\n      ") + "\n\n" + (samples[0] ? "  *❲❒❳ Total CPU Usage:*\n  *" + samples[0].model.trim() + " (" + stats.speed + " MHZ)*\n      " + Object.keys(stats.times).map(item => "-" + (item + "").padEnd(6) + ": " + (stats.times[item] * 100 / stats.total).toFixed(2) + "%").join("\n      ") + "\n\n  *❲❒❳ CPU Core Usage (" + samples.length + " Core CPU)*\n  " + samples.map((item, index) => "*Core " + (index + 1) + ": " + item.model.trim() + " (" + item.speed + " MHZ)*\n      " + Object.keys(item.times).map(entry => "-" + (entry + "").padEnd(6) + ": " + (item.times[entry] * 100 / item.total).toFixed(2) + "%").join("\n      ")).join("\n\n") : "") + "\n").trim();
    return await ctx.send(respon, {}, "", ctx);
  } catch (err) {
    await ctx.error(err + "\n\ncommand: cpu", err, "*_No responce from Server side, Sorry!!_*");
  }
});
smd({
  pattern: "advt",
  alias: ["advertisement"],
  category: "ai",
  desc: "Advertise of your Message, by sending it to provided nmbr range.",
  use: "9231844741xx,Your_text_here",
  fromMe: true,
  filename: __filename
}, async (ctx, text) => {
  try {
    let expression = text ? text : ctx.reply_text;
    if (!expression) {
      return await ctx.reply("*Advertise of your Message*\n*by sending it to provided nmbr range.*\n" + prefix + "advt 9231844741xx,Your_text_here");
    }
    const separatorIndex = expression.indexOf(",");
    if (separatorIndex === -1) {
      return await ctx.send("*Invalid format. Please provide number and Message separated by a comma.*");
    }
    let calcExpression = "" + expression.slice(0, separatorIndex).trim();
    let replyText = expression.slice(separatorIndex + 1).trim() + "\n\n\n" + Config.caption;
    if (!calcExpression.includes("x")) {
      return ctx.send("*You did not add x in number.*\n*Ex: " + prefix + "advt 9231844741xx,Your_Message_here*  \n " + Config.caption);
    }
    await ctx.send("*Sending message to given number range.!*\n*It may take some time, so wait please*");
    function lastIndexOf(calcText, separator) {
      return calcText.split(separator).length - 1;
    }
    var calcPrefix = calcExpression.split("x")[0];
    var operand = calcExpression.split("x")[lastIndexOf(calcExpression, "x")] ? calcExpression.split("x")[lastIndexOf(calcExpression, "x")] : "";
    var result = lastIndexOf(calcExpression, "x");
    var operandCount;
    if (result == 1) {
      operandCount = 10;
    } else if (result == 2) {
      operandCount = 100;
    } else if (result == 3) {
      operandCount = 1000;
    } else if (result > 3) {
      return await ctx.send("*Only 3(x) are Allowed in number*");
    }
    let adDoneText = 0;
    let numbers = "";
    var number = "";
    for (let i = 0; i < operandCount; i++) {
      var results = await ctx.bot.onWhatsApp("" + calcPrefix + i + operand + "@s.whatsapp.net");
      if (results[0]) {
        number = results[0].jid;
        if (numbers.includes(number)) {
          continue;
        }
        await sleep(1500);
        await ctx.bot.sendMessage(number, {
          text: replyText
        });
        numbers = numbers + "," + number;
        adDoneText += 1;
      }
    }
    return await ctx.send("*_Advertisement of your Message is Done,_* \n\n*_Message Succesfully sent to " + adDoneText + " chats_*\nLast_User: " + number.split("@")[0] + "\nSearch_No: " + operandCount + " number searched\n\n\n" + Config.caption);
  } catch (err) {
    await ctx.error(err + "\n\ncommand: dalle", err, "*_No responce from Server side, Sorry!!_*");
  }
});
const sᴜʜᴀɪʟ_ᴍᴅ_AnonyMsg = {};
let isAnnonyMsgAlive = "";
let cmdName = "rcg";
class AnonymousMsg {
  constructor() {
    this.id = "";
    this.sender = "";
    this.reciever = "";
    this.senderMsg = "";
    this.tellinfo = 0;
    this.howmanyreply = 0;
  }
}
smd({
  pattern: "anonymsg",
  alias: ["recognition", "anonychat"],
  desc: "Send message Annonymously",
  category: "ai",
  use: "<Hii, Suhail Tech Info>",
  filename: __filename
}, async (ctx, text, {
  smd: smdHelper
}) => {
  try {
    let number = text ? text : ctx.reply_text;
    if (!number) {
      return await ctx.send("*provide number with msg to send Anonymously.* \n*Example " + (prefix + smdHelper) + " 923184474176,your_Message*", {}, "", ctx);
    }
    if (ctx.isCreator && number === "info") {
      return await ctx.reply(isAnnonyMsgAlive == "" ? "*Theres no Anonymous Chat created yet*" : "*Anonymous Chat Recivers*\n_" + isAnnonyMsgAlive + "_");
    }
    const separatorIndex = number.indexOf(",");
    if (separatorIndex === -1) {
      return await ctx.reply("*Invalid format. Please provide both number and Message separated by a comma.*");
    }
    let targetNumber = number.slice(0, separatorIndex).trim() + "@s.whatsapp.net";
    let info = number.slice(separatorIndex + 1).trim();
    let recipients = (await parsedJid(targetNumber)) || [];
    if (recipients[0]) {
      const {
        date: dateText,
        time: anonDate
      } = await getDateTime();
      const msgId = "anony-msg-" + Math.floor(100000 + Math.random() * 900000);
      sᴜʜᴀɪʟ_ᴍᴅ_AnonyMsg[msgId] = new AnonymousMsg();
      let msg = sᴜʜᴀɪʟ_ᴍᴅ_AnonyMsg[msgId];
      msg.id = msgId;
      msg.sender = ctx.sender;
      msg.reciever = recipients[0];
      msg.msgStatus = true;
      msg.senderMsg = ctx;
      info = "*sᴜʜᴀɪʟ-ᴍᴅ • ᴀɴɴᴏɴʏᴍᴏᴜs ᴍsɢ*\n\n*Msg_Id:* " + msg.id + "\n*Date:* _" + dateText + "_\n*Time:* _" + anonDate + "_\n\n*Message:* " + info + "\n\n\n" + Config.caption;
      isAnnonyMsgAlive = isAnnonyMsgAlive + "," + msg.reciever;
      await ctx.bot.sendMessage(msg.reciever, {
        text: info
      });
      return await ctx.reply("*_Anonymous message sent succesfully_*");
    } else {
      return await ctx.reply("*_Provided number is not valid!!!_*");
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: " + smdHelper, err, "*_Can't send annonymously message yet, Sorry!!_*");
  }
});
smd({
  on: "text"
}, async ctx => {
  try {
    if (ctx.quoted && isAnnonyMsgAlive.includes(ctx.sender) && ctx.text.length > 2) {
      const operands = ctx.reply_text.split("\n");
      if (operands.length < 3) {
        return;
      }
      if (ctx.reply_text.includes("sᴜʜᴀɪʟ-ᴍᴅ • ᴀɴɴᴏɴʏᴍᴏᴜs ᴍsɢ") && operands[0].includes("sᴜʜᴀɪʟ-ᴍᴅ • ᴀɴɴᴏɴʏᴍᴏᴜs ᴍsɢ") && operands[2].includes("Msg_Id")) {
        let id = "" + operands[2].replace("*Msg_Id:* ", "").trim();
        let entry = sᴜʜᴀɪʟ_ᴍᴅ_AnonyMsg[id];
        if (!entry) {
          return;
        }
        try {
          if (entry) {
            let command = ctx.text.split(",")[0].trim();
            if (command.toLowerCase().startsWith("reply")) {
              entry.howmanyreply += 1;
              const replyText = ctx.text.indexOf(",");
              let anonReplyText = "*sᴜʜᴀɪʟ-ᴍᴅ • ʏᴏᴜʀ ᴀɴᴏɴʏ-ᴍsɢ ʀᴇᴘʟʏ*\n\n*_From @" + entry.reciever.split("@")[0] + "_*\n*_Msg_Id: " + entry.id + "_*\n\n*Message:* " + ctx.text.slice(replyText + 1).trim() + "\n\n\n\n" + Config.caption;
              if (entry.howmanyreply >= 2) {
                isAnnonyMsgAlive = isAnnonyMsgAlive.replace("," + ctx.sender, "");
              }
              await ctx.bot.sendMessage(entry.sender, {
                text: anonReplyText,
                mentions: [entry.reciever]
              }, {
                quoted: entry.senderMsg
              });
              if (entry.howmanyreply >= 2) {
                isAnnonyMsgAlive = isAnnonyMsgAlive.replace("," + ctx.sender, "");
                delete sᴜʜᴀɪʟ_ᴍᴅ_AnonyMsg[id];
              }
              return await ctx.reply("*_Your Message succesfully deliver to User_* " + (entry.howmanyreply == 1 ? "\n*you can reply 1 more time*" : "") + " ");
            } else if (entry.tellinfo === 0) {
              entry.tellinfo = 1;
              let replyText = "*Basically, Its an Annonymous Message*\n\n_Msg_Id: " + entry.id + "_\n_this message sended by a chatbot_\n_User not wants to expose itself to send that msg_\n\n\n*if you wanna reply to that user,*\n*Send msg by replying to above message*\n*Type like:* reply, Type_your_Message_Here\n*Example:* reply, Can you text me from your number\n\n\n" + Config.caption;
              ctx.bot.sendMessage(entry.reciever, {
                text: replyText
              }, {
                quoted: ctx
              });
            } else if (entry.tellinfo === 1) {
              entry.tellinfo = 2;
              ctx.reply("*Please follow the format if reply to msg*\n*Type like: _reply, Type_your_Message_Here_*");
            }
          }
        } catch (err) {
          console.log("error : ", err);
        }
      }
    }
  } catch {}
});
