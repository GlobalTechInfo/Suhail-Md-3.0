async function Draw(inputs) {
  if (!process.env.HF_TOKEN) console.log("HF_TOKEN is not set. Add HF_TOKEN=hf_xxx to your .env file.");
  const response = await fetch("https://api-inference.huggingface.co/models/prompthero/openjourney-v2", {
    method: "POST",
    headers: {
      "content-type": "application/json",
      Authorization: "Bearer " + process.env.HF_TOKEN
    },
    body: JSON.stringify({
      inputs: inputs
    })
  }).then(result => result.blob());
  const imageBuffer = await response.arrayBuffer();
  return Buffer.from(imageBuffer);
}
smd({
  pattern: "rmbg",
  alias: ["removebg"],
  category: "ai",
  filename: __filename,
  desc: "Remove image Background."
}, async ctx => {
  try {
    if (!Config.REMOVE_BG_KEY) {
      return ctx.reply("```You Dont Have REMOVE_BG_KEY \nPlease Create RemoveBG KEY from Given Link \nhttps://www.remove.bg/\nAnd Set Key in REMOVE_BG_KEY Var```");
    }
    let mediaTypes = ["imageMessage"];
    let quoted = mediaTypes.includes(ctx.mtype) ? ctx : ctx.reply_message;
    if (!quoted || !mediaTypes.includes(quoted?.mtype || "null")) {
      return await ctx.send("*_Uhh Dear, Reply to an image_*");
    }
    let media = await ctx.bot.downloadAndSaveMediaMessage(quoted);
    let prompt = await TelegraPh(media);
    try {
      fs.unlinkSync(media);
    } catch {}
    let rmbgResult = await aiResponce(ctx, "rmbg", prompt);
    if (rmbgResult) {
      await ctx.send(rmbgResult, {
        caption: Config.caption
      }, "image", ctx);
    } else {
      await ctx.send("*_Request not be preceed!!_*");
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: rmbg", err, "*_No responce from remove.bg, Sorry!!_*");
  }
});
smd({
  pattern: "readmore",
  alias: ["rmore", "readmor"],
  desc: "Adds *readmore* in given text.",
  category: "general",
  filename: __filename
}, async (ctx, text) => {
  try {
    let quoted = text ? text : ctx.reply_text;
    if (!quoted) {
      quoted = "*Uhh Dear,Please provide text*\n*Eg:- _.readmor text1 readmore text2_*";
    } else {
      quoted += " ";
    }
    if (quoted.includes("readmore")) {
      await ctx.reply(quoted.replace(/readmore/, String.fromCharCode(8206).repeat(4001)));
    } else {
      await ctx.reply(quoted.replace(" ", String.fromCharCode(8206).repeat(4001)));
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand : readmore", err, false);
  }
});
let pmtypes = ["videoMessage", "imageMessage"];
cmd({
  pattern: "url",
  alias: ["createurl"],
  category: "general",
  filename: __filename,
  desc: "image to url.",
  use: "<video | image>"
}, async ctx => {
  try {
    let quoted = pmtypes.includes(ctx.mtype) ? ctx : ctx.reply_message;
    if (!quoted || !pmtypes.includes(quoted?.mtype)) {
      return ctx.reply("*_Uhh Dear, Reply To An Image/Video!_*");
    }
    let media = await ctx.bot.downloadAndSaveMediaMessage(quoted);
    let url = await createUrl(media);
    if (!url) {
      return ctx.reply("*_Failed To Create Url!_*");
    }
    try {
      fs.unlink(media);
    } catch {}
    await ctx.send(util.format(url), {}, "suhail", quoted);
  } catch (err) {
    await ctx.error(err + "\n\ncommand url", err);
  }
});
cmd({
  pattern: "upload",
  alias: ["url2"],
  category: "general",
  filename: __filename,
  desc: "image to url.",
  use: "<video | image>"
}, async ctx => {
  try {
    let quoted = pmtypes.includes(ctx.mtype) ? ctx : ctx.reply_message;
    if (!quoted || !pmtypes.includes(quoted?.mtype)) {
      return ctx.reply("*_Uhh Dear, Reply To An Image/Video!_*");
    }
    let media = await ctx.bot.downloadAndSaveMediaMessage(quoted);
    let uploaded = await createUrl(media, "uguMashi");
    try {
      fs.unlink(media);
    } catch {}
    if (!uploaded || !uploaded.url) {
      return ctx.reply("*_Failed To Create Url!_*");
    }
    await ctx.send(util.format(uploaded.url), {}, "suhail", quoted);
  } catch (err) {
    await ctx.error(err + "\n\ncommand upload", err);
  }
});
smd({
  pattern: "calc",
  desc: "calculate an equation.",
  category: "general",
  use: "<equation>",
  filename: __filename
}, async (ctx, text) => {
  try {
    if (!text) {
      return await ctx.reply("*Please enter a math operation*\n*Example: .calc 22+12*");
    }
    let expression = text.replace(/\s+/g, "");
    if (!/^(\d+([-+%*/]\d+)+)$/.test(expression)) {
      return await ctx.reply("Please enter a valid mathematical operation.");
    }
    const evaluate = source => {
      return new Function("return " + source)();
    };
    const value = evaluate(expression);
    if (expression.includes("/") && expression.split("/").some(item => item === "0")) {
      return ctx.reply("Cannot divide by zero.");
    }
    if (expression.split(/[-+%*/]/).length <= 2) {
      const [calcPrefix, operator, symbol] = expression.match(/\d+|[-+%*/]/g);
      return await ctx.reply(calcPrefix + " " + operator + " " + symbol + " = " + value);
    } else {
      return await ctx.reply("Result: " + value);
    }
  } catch (err) {
    return await ctx.error(err + "\n\ncommand: calc", err);
  }
});
async function getDateTime() {
  const now = new Date();
  const date = now.toISOString().slice(0, 10);
  const time = now.toLocaleTimeString();
  return {
    date: date,
    time: time
  };
}
