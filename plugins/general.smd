async function aiResponce(ctx, mode, prompt = "") {
  let result = "";
  try {
    if (mode === "chat") {
      result = await (await axios.get("http://api.brainshop.ai/get?bid=175685&key=Pg8Wu8mrDQjfr0uv&uid=[" + ctx.sender.split("@")[0] + "]&msg=[" + prompt + "]")).data.cnt;
    } else if (mode === "gpt") {
      const response = await fetch("https://api.openai.com/v1/chat/completions", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: "Bearer " + Config.OPENAI_API_KEY
        },
        body: JSON.stringify({
          model: "gpt-3.5-turbo",
          messages: [{
            role: "system",
            content: "You"
          }, {
            role: "user",
            content: prompt
          }]
        })
      });
      const chatResponse = await response.json();
      if (!chatResponse.choices || chatResponse.choices.length === 0) {
        result = "*Invalid ChatGPT API Key, Please Put New Key*";
      } else {
        result = chatResponse.choices[0].message.content;
      }
    } else if (mode === "dalle") {
      const response = await fetch("https://api.openai.com/v1/images/generations", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: "Bearer " + Config.OPENAI_API_KEY
        },
        body: JSON.stringify({
          model: "image-alpha-001",
          prompt: prompt,
          size: "512x512",
          response_format: "url"
        })
      });
      const imageResponse = await response.json();
      result = imageResponse.data[0].url;
    }
    if (mode === "rmbg") {
      const payload = {
        image_url: prompt,
        size: "auto"
      };
      axios.post("https://api.remove.bg/v1.0/removebg", payload, {
        headers: {
          "X-Api-Key": Config.REMOVE_BG_KEY
        },
        responseType: "arraybuffer"
      }).then(uploadResult => {
        result = Buffer.from(uploadResult.data, "binary");
      }).catch(err => {
        result = false;
      });
    }
    return result;
  } catch (err) {
    console.log("error in aiResponce : ", err);
    return "Error While getting Ai responce ";
  }
}
;
