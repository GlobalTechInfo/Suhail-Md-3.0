smd({
  pattern: "trump",
  alias: ["tea", "kofi"],
  category: "say",
  desc: "give text to creat trum tweet",
  filename: __filename
}, async (ctx, text) => {
  try {
    if (!text) {
      return await ctx.send("*provide text!*");
    }
    const srcImage = "./plugins/meme.say/trumSay.png";
    const outImage = "./temp/trump.png";
    const x = 70;
    const y = 150;
    const lineHeight = 700;
    const maxChars = 4;
    let image = await addTextToImage(srcImage, outImage, "  " + text, x, y, lineHeight, maxChars, "35");
    await sleep(1500);
    await ctx.bot.sendMessage(ctx.jid, {
      image: {
        url: image
      },
      caption: Config.caption
    });
  } catch (err) {
    return await ctx.error(err + "\n\n command: coffe", err, "*_Didn't get any results, Sorry!_*");
  }
});
