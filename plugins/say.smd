const {
  createCanvas,
  loadImage
} = require("canvas");
async function addTextToImage(imageSrc, outPath, text, xPos, lineStep, maxChars, lineIndex, fontSize = "30") {
  const image = await loadImage(imageSrc);
  const canvas = createCanvas(image.width, image.height);
  const ctx = canvas.getContext("2d");
  ctx.drawImage(image, 0, 0, canvas.width, canvas.height);
  ctx.font = fontSize + "px Arial";
  ctx.fillStyle = "black";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  const lines = splitTextIntoLines(text, ctx, maxChars);
  if (lines.length > lineIndex) {
    lines.splice(lineIndex);
    const caption = lines[lineIndex - 1];
    const truncatedLine = caption.slice(0, caption.length - 10) + "...Read More";
    lines[lineIndex - 1] = truncatedLine;
  }
  lines.forEach((item, index) => {
    ctx.fillText(item, xPos, lineStep + index * 25);
  });
  const writeStream = fs.createWriteStream(outPath);
  const pngStream = canvas.createPNGStream();
  pngStream.pipe(writeStream);
  await new Promise(onFinish => {
    writeStream.on("finish", onFinish);
  });
  return outPath;
  console.log("Image with text created:", outPath);
}
function splitTextIntoLines(text, ctx, maxWidth) {
  const words = text.split(" ");
  const lines = [];
  let line = "";
  for (const word of words) {
    const candidate = line === "" ? word : line + " " + word;
    const textWidth = ctx.measureText(candidate).width;
    if (textWidth <= maxWidth) {
      line = candidate;
    } else {
      lines.push(line);
      line = word;
    }
  }
  if (line !== "") {
    lines.push(line);
  }
  return lines;
}
