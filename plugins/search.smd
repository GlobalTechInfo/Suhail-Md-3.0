smd({
            pattern: "image",
            alias: ["img" , "pic"],
            category: "search",
            desc: "Searches images on Bing.",
            use: '<text>',
            filename: __filename,
        },
        async(message, match) => {
try{
  let text = match ? match : message.reply_text;
   if (!text) return message.reply(`Provide me a query!\n*Ex : .image luffy |10*`)
   
   let name1 = text.split("|")[0].trim() || text.trim()
   let name2 = text.split("|")[1] || `5`


    let nn = Math.max(1, Math.min(parseInt(name2) || 5, 20))
    let Group = await groupdb.findOne({ id: message.chat }) || {}
    let safe = Group.nsfw == "true" ? "off" : "strict"
    const { imageSearch } = require('../lib/websearch.js');
    let images = await imageSearch(name1, nn, safe);
    if (!images.length) return message.reply(`*_No images found for : ${name1}_*`);

    await message.reply(`*_Sending images of '${name1}' in chat!_*`)
    for (const image of images) {
      try {
        await message.bot.sendFromUrl(message.jid, image.url, "", message, {}, "image")
      } catch {}
    }
    return ;



























}catch(e){return await message.error(`${e}\n\n command: image`,e,`*_Uhh dear, Didn't get any results!_*`) }
 })
