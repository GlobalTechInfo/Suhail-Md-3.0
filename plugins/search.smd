smd({
            pattern: "cric",
            category: "search",
            desc: "Sends live cricket scores.",
            use: '<text>',
            filename: __filename,
        },
        async(message) => {
try{
            await message.reply (`*_Please Wait, Getting Cricket Info_*`);
const { cricketLive } = require('../lib/websearch.js');
const matches = await cricketLive(10);
if (!matches.length) return await message.reply("*_No live cricket matches found right now._*");

let msg = "*_LIVE CRICKET SCORES_*";
matches.forEach((m, i) => {
msg += `\n\n*--------------------- MATCH ${i + 1} -------------------*`;
msg += "\n*Match Name:* " + m.name;
msg += "\n*Series:* " + m.series;
msg += "\n*Match:* " + m.match;
msg += "\n*Match Status:* " + m.status;
msg += "\n*Match Date:* " + m.dateTimeGMT;
msg += "\n*Match Started:* " + m.matchStarted;
msg += "\n*Match Ended:* " + m.matchEnded;
});
 return await message.reply(msg);
}catch(e){return await message.error(`${e}\n\n command: cric`,e,`*_Uhh dear, Didn't get any results!_*`) }

})

