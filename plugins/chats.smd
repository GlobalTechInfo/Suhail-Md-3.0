let Suhail_Md = "Suhail MD Whatsapp bot md"
let {smd , prefix,Config} = require("../lib")

// ============================ CHATS SETTINGS ============================ 

// Targets the CHAT (message.jid), never an individual message - lastMessages is only the sync
// range WhatsApp requires inside the patch. Passing the range explicitly (rather than having this
// helper inject it) keeps the payloads identical to a known-working implementation.
const chatMod = async (message, mod) => await message.bot.chatModify(mod, message.jid);
const chatRange = message => [{ key: message.key, messageTimestamp: message.messageTimestamp }];

smd({
	pattern: 'clear',
	fromMe: true,
	desc: 'delete whatsapp chat',
	type: 'chats'
}, async (message, match) => { 
    try{   
	await chatMod(message, { delete: true, lastMessages: chatRange(message) })

	await message.send('_Cleared!_')
    }catch(e){ message.reply('❌ Failed to clear chat: ' + (e && e.message ? e.message.split('\n')[0] : e)); }
})







smd({
	pattern: 'archive',
	fromMe: true,
	desc: 'archive whatsapp chat',
	type: 'chats'
}, async (message, match) => {
    try {
		// Chat-level (message.jid); lastMessages is only the sync range the patch requires.
		await chatMod(message, { archive: true, lastMessages: chatRange(message) });
		await message.send('_Archived!_');
	} catch (e) {
		await message.reply('❌ Failed to archive chat: ' + (e && e.message ? e.message.split('\n')[0] : e));
	}
})

smd({
	pattern: 'unarchive',
	fromMe: true,
	desc: 'unarchive whatsapp chat',
	type: 'chats'
}, async (message, match) => {
    try{
	await chatMod(message, { archive: false, lastMessages: chatRange(message) });
	await message.send('_Unarchived!_')
}catch(e){ message.reply('❌ Failed to unarchive chat: ' + (e && e.message ? e.message.split('\n')[0] : e)); }
})



smd({
	pattern: 'chatpin',
  alias :["pinchat"],
	fromMe: true,
	desc: 'pin a chat',
	type: 'chats'
}, async (message, match) => {
    try{
	await chatMod(message, { pin: true });
	await message.send('_Pined!_')
}catch(e){ message.reply('❌ Failed to pin chat: ' + (e && e.message ? e.message.split('\n')[0] : e)); }
})



smd({
	pattern: 'unpin',
  alias :["unpinchat","chatunpin"],
	fromMe: true,
	desc: 'unpin a msg',
	type: 'chats'
}, async (message, match) => {
    try{
	await chatMod(message, { pin: false });
	await message.send('_Unpined!_')
}catch(e){ message.reply('❌ Failed to unpin chat: ' + (e && e.message ? e.message.split('\n')[0] : e)); }
})



smd({
	pattern: 'markread',
	fromMe: true,
	desc: 'mark as readed',
	type: 'chats'
}, async (message, match) => {

    try {
		// No react() side-effect: it ran before chatModify and could throw, killing the command.
		await chatMod(message, { markRead: true, lastMessages: chatRange(message) });
		await message.send('_Chat marked as read!_');
	} catch (e) {
		await message.reply('❌ Failed to mark read: ' + (e && e.message ? e.message.split('\n')[0] : e));
	}
})



smd({
	pattern: 'markunread',  
	fromMe: true,
	desc: 'mark as UnRead',
	type: 'chats'
}, async (message, match) => {

    try {
		await chatMod(message, { markRead: false, lastMessages: chatRange(message) });
		await message.send('_Chat marked as unread!_');
	} catch (e) {
		await message.reply('❌ Failed to mark unread: ' + (e && e.message ? e.message.split('\n')[0] : e));
	}
})




smd({
	pattern: 'unmutechat',
	fromMe: true,
	desc: 'unmute a chat',
	type: 'chats'
}, async (message, match) => {
    try{
	await chatMod(message, { mute: null });
	await message.send('_Chat Unmuted!_')
}catch(e){ message.reply('❌ Failed to unmute chat: ' + (e && e.message ? e.message.split('\n')[0] : e)); }

})

smd({
	pattern: 'profilename',
	fromMe: true,
	desc: 'To change your profile name',
	type: 'whatsapp'
}, async (message, match) => {
    try{
	// was `message.reply_message.text`, which throws when nothing is quoted (reply_message is null)
	// and so the "Need Name!" help below was unreachable. reply_text is the safe equivalent.
	match = match || message.reply_text;
	if (!match || !String(match).trim()) {
		return await message.send("*Need Name!*\n*Example: _" + (prefix || ".") + "profilename your name_");
	}
	try {
		await message.bot.updateProfileName(String(match).trim());
		await message.send("_Profile name updated!_");
	} catch (err) {
		// Surface the real reason (WhatsApp rejects some names) instead of a generic banner.
		await message.reply("*_Couldn't update the profile name:* " + (err && err.message ? err.message.split("\n")[0] : "unknown error"));
	}
	} catch (e) {
		await message.error(`${e}\n\nCommand : profilename`);
	}
})


// ============================ PRIVACY SETTINGS ============================    









smd({
	pattern: 'getprivacy',
	fromMe: true,
	desc: 'get your privacy settings',
	type: 'privacy'
}, async (message, match) => {
	const {
		readreceipts,
		profile,
		status,
		online,
		last,
		groupadd,
		calladd
	} = await message.bot.fetchPrivacySettings(true);
	const msg = `*♺ whatsapp privacy settings*

*ᝄ name :* ${(message.fromMe &&  message.pushName ? message.pushName :  message.bot.user.name).split("\n").join("  ") }
*ᝄ number :* ${message.user.split("@")[0]}

*ᝄ online :* ${online}
*ᝄ profile :* ${profile}
*ᝄ last seen :* ${last}
*ᝄ whts status :* ${status}
*ᝄ read receipt :* ${readreceipts}

*ᝄ who can add in group :* ${groupadd}
*ᝄ who can call :* ${calladd}`;
	let img = await message.getpp(message.user)
	await message.send(img, {
		caption: msg
	}, 'img');
})





smd({
	pattern: 'lastseen',
	fromMe: true,
	desc: 'to change lastseen privacy',
	type: 'privacy'
}, async (message, match, {smd }) => {
    try{
	if (!match) return await message.send(`_*Example:-* .lastseen all_\n_to change last seen privacy settings_`);
	const available_privacy = ['all', 'contacts', 'contact_blacklist', 'none'];
	if (!available_privacy.includes(match)) return await message.send(`_action must be *${available_privacy.join(' / ')}* values_`);
	await message.bot.updateLastSeenPrivacy(match)
	await message.send(`_Privacy settings *last seen* Updated to *${match}*_`);
}catch(e){ message.error(`${e}\n\nCommand : lastseen` ); }
})


