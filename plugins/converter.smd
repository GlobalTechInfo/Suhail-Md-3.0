  }
});
smd({
  pattern: "tomp4",
  alias: ["mp4", "tovideo"],
  desc: "convert sticker to mp4.",
  category: "converter",
  use: "<reply to any Video>",
  filename: __filename
}, async ctx => {
  let quoted = ctx.mtype === "videoMessage" ? ctx : ctx.reply_message;
  if (!quoted) {
    return ctx.reply("*_Uhh Dear, Reply To Animated Sticker or Gif!!_*");
  }
  const {
    webp2mp4File: ffancy
  } = require("../lib");
  let mimetype = quoted?.mimetype || "";
  if (quoted?.mtype != "videoMessage" && !/webp/.test(mimetype)) {
    return await ctx.send("*Damn... Reply To An Animated Sticker or Gif *");
  }
  let input = await ctx.bot.downloadAndSaveMediaMessage(quoted);
  try {
    try {
      if (/webp/.test(mimetype)) {
        let response = await ffancy(input);
        input = response.result;
      }
    } catch (err) {
      console.log("error while converting sticker to mp4\n", err);
    }
    await ctx.bot.sendMessage(ctx.jid, {
      video: {
        url: input
      },
      caption: Config.caption
    });
    try {
      await fs.unlink(input);
    } catch (err) {}
  } catch (err) {
    ctx.error(err + "\n\ncmdName: tomp4", err);
  }
});
function splitTextIntoLines(input, ctx, maxWidth) {
  const words = input.split(" ");
  const lines = [];
  let line = "";
  for (const word of words) {
    const candidate = line === "" ? word : line + " " + word;
    const textWidth = ctx.measureText(candidate).width;
    if (textWidth <= maxWidth) {
      line = candidate;
    } else {
      lines.push(line);
      line = word;
    }
  }
  if (line !== "") {
    lines.push(line);
  }
  return lines;
}
smd({
  cmdname: "ttp",
  alias: ["roundstic", "roundsticker"],
  info: "Makes sticker of replied image/video.",
  type: "sticker",
  filename: __filename,
  use: "<reply to image.>"
}, async (ctx, input) => {
  try {
    let userInput = input || ctx.reply_text;
    if (userInput) {
      let fontSize = parseInt(userInput) || "";
      if (fontSize && !isNaN(fontSize)) {
        userInput = await fancytext("" + userInput.slice(2), fontSize);
      }
      const {
        createCanvas: createCanvas
      } = require("canvas");
      const fsModule = require("fs");
      const width = 300;
      const height = 300;
      const outPath = "./temp/ttp.png";
      const canvas = createCanvas(width, height);
      const canvasCtx = canvas.getContext("2d");
      canvasCtx.clearRect(0, 0, canvas.width, canvas.height);
      canvasCtx.font = "20px Arial";
      canvasCtx.fillStyle = "black";
      canvasCtx.textAlign = "center";
      const maxWidth = width - 20;
      const lines = splitTextIntoLines(userInput, canvasCtx, maxWidth);
      const startX = lines.length * 25;
      const lineY = (height - startX) / 2;
      lines.forEach((item, index) => {
        const textY = lineY + index * 25;
        canvasCtx.fillText(item, width / 2, textY);
      });
      const pngStream = canvas.createPNGStream();
      const writeStream = fsModule.createWriteStream(outPath);
      pngStream.pipe(writeStream);
      writeStream.on("finish", async () => {
        console.log("Image created:", outPath);
        let buffer = fsModule.readFileSync(outPath);
        let options = {
          pack: Config.packname,
          author: Config.author,
          type: StickerTypes.ROUNDED,
          quality: 50
        };
        await generateSticker(ctx, buffer, options);
        return buffer = false;
      });
    } else {
      return ctx.reply("*_Uhh Dear, provide text, ex .ttp 4 hii im suhail!!_*");
    }
  } catch (err) {
    return await ctx.error(err + "\n\ncmdName: ttp\n");
  }
});

