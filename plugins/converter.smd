smd({
  pattern: "memegen",
  desc: "Write text on quoted image.",
  category: "sticker",
  filename: __filename,
  use: "<text>"
}, async (ctx, input) => {
  try {
    let quoted = pmtypes.includes(ctx.mtype) ? ctx : ctx.reply_message;
    if (!input) {
      return await ctx.reply("*please provide text and image*");
    }
    if (!quoted || !pmtypes.includes(quoted.mtype)) {
      return ctx.reply("*Uhh please, Reply to an image*");
    }
    let topText = input.split("|")[0] || "";
    let value = (input.split("|")[1] || "sticker").toLowerCase();
    let topTextPart = topText.split(";")[0] || "_";
    let bottomText = topText.split(";")[1] || "_";
    let imagePath = await ctx.bot.downloadAndSaveMediaMessage(quoted);
    let imageUrl = await TelegraPh(imagePath);
    try {
      fs.unlinkSync(imagePath);
    } catch (err) {}
    console.log("match", input);
    let imageBuffer;
    try {
      imageBuffer = await getBuffer("https://api.memegen.link/images/custom/" + topTextPart + "/" + bottomText + ".png?background=" + imageUrl);
    } catch (err) {
      // api.memegen.link is answering 503 / dropping the TLS handshake, which surfaced as
      // "Client network socket disconnected before secure TLS connection was established".
      return ctx.send("*_Meme generation is unavailable right now_*\n_memegen.link is not responding (" + (err && err.code ? err.code : "network error") + "). Try again shortly._");
    }
    if (value?.startsWith("p")) {
      await ctx.send(imageBuffer, {
        caption: Config.caption
      }, "image");
    }
    let options = {
      pack: Config.packname,
      author: Config.author,
      type: StickerTypes.FULL,
      quality: 70
    };
    await generateSticker(ctx, imageBuffer, options);
    return imageBuffer = false;
  } catch (err) {
    ctx.error(err + "\n\ncmdName: memegen\n");
    console.log(err);
  }
});
smd({
  pattern: "emix",
  desc: "Mixes two emojies.",
  category: "sticker",
  use: "<query>",
  filename: __filename
}, async (ctx, input) => {
  try {
    let emoji1 = input.split(",")[0] || false;
    let emoji2 = input.split(",")[1] || false;
    if (!input || !emoji1 || !emoji2) {
      return ctx.reply("Example : " + prefix + "emix 😅,🤔");
    }
    const response = await fetch("https://tenor.googleapis.com/v2/featured?key=AIzaSyAyimkuYQYF_FXVALexPuGQctUWRURdCYQ&contentfilter=high&media_filter=png_transparent&component=proactive&collection=emoji_kitchen_v5&q=" + emoji1 + "_" + emoji2);
    // Tenor now answers 403 {"error":{"code":403,"message":"Tenor API is discontinued"}} - the error
    // body has no `results`, so `mixture.results[0]` threw "Cannot read properties of undefined
    // (reading '0')" and hid the real reason.
    if (!response.ok) {
      return ctx.send("*_Emoji mixing is unavailable:_*\n_Tenor shut down its API (" + response.status + "). No replacement endpoint is reachable from this host._");
    }
    const mixture = await response?.json();
    if (!mixture || !Array.isArray(mixture.results) || mixture.results.length === 0) {
      return ctx.send("*_Can't create mixture, try other emojies_*");
    } else {
      let buffer = await smdBuffer(mixture.results[0].url);
      let options = {
        pack: Config.packname,
        author: Config.author,
        type: StickerTypes.FULL,
        quality: 70
      };
      await generateSticker(ctx, buffer, options);
      return buffer = false;
    }
  } catch (err) {
    ctx.error(err + "\n\ncmdName: emix");
  }
});
smd({
  pattern: "quotely",
  desc: "Makes Sticker of quoted text.",
  alias: ["q"],
  category: "sticker",
  use: "<reply to any message.>",
  filename: __filename
}, async (ctx, input) => {
  try {
    let sender = ctx.reply_message ? ctx.reply_message : ctx && input ? ctx : false;
    let number = ctx.reply_message ? ctx.reply_message.text : input;
    if (!sender || !number) {
      return ctx.reply("*_Please quote/reply to any message!!!_*");
    }
    let imageUrl = await ctx.getpp(sender.sender);
    let colors = ["#FFFFFF", "#000000"];
    let backgroundColor = input === "white" ? colors[0] : input === "black" ? colors[1] : colors[Math.floor(Math.random() * colors.length)];
    let firstName = ctx.bot.getName(sender.sender);
    let quotePayload = {
      type: "quote",
      format: "png",
      backgroundColor: backgroundColor,
      width: 512,
      height: 512,
      scale: 3,
      messages: [{
        avatar: true,
        from: {
          first_name: firstName,
          language_code: "en",
          name: firstName,
          photo: {
            url: imageUrl
          }
        },
        text: number,
        replyMessage: {}
      }]
    };
    let response = await axios.post("https://bot.lyo.su/quote/generate", quotePayload);
    if (!response || response.status !== 200 || !response.data || !response.data.ok) {
      return await ctx.send("*_Can't create quote sticker!_*");
    }
    let jid = Buffer.alloc(response.data.result.image.length, response.data.result.image, "base64");
    try {
      await ctx.send(jid, {
        packname: Config.packname,
        author: "Suhail-Md"
      }, "sticker");
    } catch (err) {
      console.log("error in quotely : ", err);
      let options = {
        pack: Config.packname,
        author: Config.author,
        type: StickerTypes.FULL,
        quality: 70
      };
      return await generateSticker(ctx, jid, options);
    }
  } catch (err) {
    return await ctx.error(err + "\n\ncmdName: emix", err);
  }
});
