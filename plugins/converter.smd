smd({
  pattern: "styly",
  desc: "Downloads wikimedia images.",
  category: "converter",
  filename: __filename,
  use: "<text|search.>"
}, async (ctx, input) => {
  try {
    let fancyList = input.trim();
    let menu = "┏━━━━━━━━━━━━━━━━━━━━━━━━\n┃\t*💬SUHAIL-MD_FANCY_TEXT💬* \n┗━━━━━━━━━━━━━━━━━━━━━━━━\n\n " + (fancyList ? "```🔢Reply the number you wants to select``` \n\n" : "```\t\t" + prefix + "styly Suhail(For all text)\n\t\t" + prefix + "styly 19 Suhail(For specific text)```\n\n");
    let {
      styletext: listAll
    } = require("../lib/scraper");
    let style = fancyList ? parseInt(fancyList) : "";
    fancyList = style && !isNaN(style) ? fancyList.slice(2) : fancyList;
    let list = (await listAll(fancyList ? fancyList : "Suhail")) || [];
    if (!list || !list[0]) {
      return await ctx.send("*_No Results Found!_*");
    }
    let menuFooter = "";
    if (isNaN(style) || style > list.length || style < 0 || !fancyList) {
      for (let index = 0; index < list.length; index++) {
        menuFooter += "\n" + index + " " + list[index].result + " " + (fancyList.length > 50 ? "\n\n" : "");
      }
      return await ctx.send(menu + menuFooter);
    }
    return await ctx.send(list[style].result, {}, "", ctx);
  } catch (err) {
    ctx.error(err + "\n\ncommand: styly", err);
  }
});
