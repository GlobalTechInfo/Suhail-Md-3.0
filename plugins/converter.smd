smd({
  pattern: "ebinary",
  desc: "encode binary",
  category: "converter",
  use: "<query>",
  filename: __filename
}, async (ctx, input) => {
  try {
    let userInput = input ? input : ctx.reply_text;
    if (!userInput) {
      return ctx.reply("*_Send text to be encoded.!_*");
    }
    let flippedText = userInput.split("").map(item => {
      return item.charCodeAt(0).toString(2);
    }).join(" ");
    await ctx.reply(flippedText);
  } catch (err) {
    await ctx.error(err + "\n\ncommand : ebinary", err);
  }
});
smd({
  pattern: "dbinary",
  desc: "decode binary",
  category: "converter",
  use: "<query>",
  filename: __filename
}, async (ctx, input) => {
  try {
    let userInput = input ? input : ctx.reply_text;
    if (!userInput) {
      return ctx.reply("Send text to be decoded.");
    }
    var binaryChars = userInput.split(" ");
    var decoded = [];
    for (i = 0; i < binaryChars.length; i++) {
      decoded.push(String.fromCharCode(parseInt(binaryChars[i], 2)));
    }
    await ctx.reply(decoded.join(""));
  } catch (err) {
    await ctx.error(err + "\n\ncommand : dbinary", err);
  }
});
