let audtypes = ["audioMessage", "videoMessage"];
smd({
  pattern: "toaudio",
  alias: ["mp3", "tomp3"],
  desc: "changes type to audio.",
  category: "converter",
  use: "<reply to any Video>",
  filename: __filename
}, async ctx => {
  try {
    let quoted = audtypes.includes(ctx.mtype) ? ctx : ctx.reply_message;
    if (!quoted || !audtypes.includes(quoted?.mtype)) {
      return ctx.reply("*_Uhh Dear, Reply to Any Video.!!_*");
    }
    let audioPath = await ctx.bot.downloadAndSaveMediaMessage(quoted);
    const {
      toAudio: toBuffer
    } = require("../lib");
    let audioData = fs.readFileSync(audioPath);
    let audioBuffer = await toBuffer(audioData);
    try {
      fs.unlink(audioPath);
    } catch (err) {}
    return await ctx.bot.sendMessage(ctx.jid, {
      audio: audioBuffer,
      mimetype: "audio/mpeg"
    });
  } catch (err) {
    ctx.error(err + "\n\ncmdName: toaudio", err);
  }
});
smd({
  pattern: "voice",
