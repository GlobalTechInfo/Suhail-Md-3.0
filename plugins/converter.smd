smd({
  cmdname: "sticker",
  alias: ["s"],
  info: "Makes sticker of replied image/video.",
  type: "sticker",
  filename: __filename,
  use: "<reply to any image/video.>"
}, async ctx => {
  try {
    let quoted = mtypes.includes(ctx.mtype) ? ctx : ctx.reply_message;
    if (quoted && mtypes.includes(quoted?.mtype || "need_Media")) {
      let buffer = await quoted.download();
      let options = {
        pack: Config.packname,
        author: Config.author,
        type: StickerTypes.FULL,
        quality: 10
      };
      await generateSticker(ctx, buffer, options);
      return buffer = false;
    } else {
      return ctx.reply("*_Uhh Dear, Reply to image/video!!_*");
    }
  } catch (err) {
    return await ctx.error(err + "\n\ncmdName: sticker\n");
  }
});
smd({
  cmdname: "take",
  info: "Makes sticker of replied image/video.",
  type: "sticker",
  filename: __filename,
  use: "<reply to sticker.>"
}, async (ctx, input) => {
  try {
    let quoted = ctx.reply_message;
    if (!quoted || quoted?.mtype != "stickerMessage") {
      return await ctx.reply("*Uhh Please, Reply to sticker*");
    }
    let parts = input.split("|");
    let pack = parts[0]?.trim() !== "" ? parts[0] : ctx.pushName;
    let author = parts[1] && parts[1] !== "" ? parts[1] : "sᴜʜᴀɪʟ-ᴍᴅ ♥️";
    let buffer = await quoted.download();
    let options = {
      pack: pack,
      author: author,
      type: StickerTypes.FULL,
      quality: 10
    };
    await generateSticker(ctx, buffer, options);
    return buffer = false;
  } catch (err) {
    return await ctx.error(err + "\n\ncmdName: take\n");
  }
});
