smd({
  pattern: "ship",
  category: "group",
  filename: __filename
}, async ctx => {
  if (!ctx.isGroup) {
    return ctx.reply(tlang().group);
  }
  let participantIds = ctx.metadata.participants.map(item => item.id);
  var target = ctx.reply_message ? ctx.reply_message.sender : ctx.mentionedJid[0] ? ctx.mentionedJid[0] : false;
  var jid;
  if (target) {
    jid = target;
  } else {
    jid = participantIds[Math.floor(Math.random() * participantIds.length)];
  }
  if (lidMap.matchesNumber(jid, ctx.sender) || ctx.sender === jid) {
    return ctx.reply("*Wait... What!!!,You wanna do matchmaking with yourself!*");
  }
  async function groupJid() {
    var tagJid;
    const number = Math.floor(Math.random() * 100);
    if (number < 25) {
      tagJid = "\t\t\t\t\t*RelationShip Percentage : " + number + "%* \n\t\tThere's still time to reconsider your choices";
    } else if (number < 50) {
      tagJid = "\t\t\t\t\t*RelationShip Percentage : " + number + "%* \n\t\t Good enough, I guess! 💫";
    } else if (number < 75) {
      tagJid = "\t\t\t\t\t*RelationShip Percentage : " + number + "%* \n\t\t\tStay together and you'll find a way ⭐️";
    } else if (number < 90) {
      tagJid = "\t\t\t\t\t*RelationShip Percentage : " + number + "%* \n\tAmazing! You two will be a good couple 💖 ";
    } else {
      tagJid = "\t\t\t\t\t*RelationShip Percentage : " + number + "%* \n\tYou both are fit to be together 💙";
    }
    return tagJid;
  }
  var message = {
    ...(await ctx.bot.contextInfo("Matchmaking", "   ˚ʚ♡ɞ˚"))
  };
  await ctx.reply("\t❣️ *Matchmaking...* ❣️\n\t*✯────────────────────✯*\n@" + ctx.sender.split("@")[0] + "  x  @" + jid.split("@")[0] + "\n\t*✯────────────────────✯*\n\n" + (await groupJid()) + "\n\n" + Config.caption, {
    contextInfo: message,
    mentions: [jid]
  }, "suhail");
});
smd({
  pattern: "mute",
  desc: "Provides admin role to replied/quoted user",
  category: "group",
  filename: __filename,
  use: "<quote|reply|number>"
}, async ctx => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    // Do NOT gate on ctx.metadata.announce here. That metadata is a cached app-state snapshot and
    // does not refresh until the next sync, so the guard made .unmute refuse right after a mute
    // ("already unmute") and then .mute refuse after the resync ("already muted") - which is
    // exactly the flip-flopping that was reported. Just send the setting and report what happened.
    if (!ctx.isBotAdmin) {
      return ctx.reply(tlang().botAdmin);
    }
    if (!ctx.isCreator && !ctx.isAdmin) {
      return ctx.reply(tlang().admin);
    }
    try {
      await ctx.bot.groupSettingUpdate(ctx.chat, "announcement");
      return await ctx.reply("*_Group Chat Muted successfully!!_*");
    } catch (err) {
      return await ctx.reply("*_Couldn't mute the group:* " + (err && err.message ? err.message.split("\n")[0] : "unknown error"));
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: gmute", err);
  }
});
smd({
  pattern: "unmute",
  desc: "Provides admin role to replied/quoted user",
  category: "group",
  filename: __filename,
  use: "<quote|reply|number>"
}, async ctx => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    // Same stale-metadata problem as .mute - see the note there.
    if (!ctx.isBotAdmin) {
      return ctx.reply(tlang().botAdmin);
    }
    if (!ctx.isCreator && !ctx.isAdmin) {
      return ctx.reply(tlang().admin);
    }
    try {
      await ctx.bot.groupSettingUpdate(ctx.chat, "not_announcement");
      return await ctx.reply("*_Group Chat UnMuted successfully!!_*");
    } catch (err) {
      return await ctx.reply("*_Couldn't unmute the group:* " + (err && err.message ? err.message.split("\n")[0] : "unknown error"));
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: gunmute", err);
  }
});
