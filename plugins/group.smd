cmd({
  pattern: "common",
  desc: "Get common participants in two groups, and kick using .common kick, jid",
  category: "owner",
  fromMe: true,
  filename: __filename
}, async (ctx, text) => {
  try {
    let memberJid = await parsedJid(text);
    var target;
    var targetJid;
    if (memberJid.length > 1) {
      target = memberJid[0].includes("@g.us") ? memberJid[0] : ctx.chat;
      targetJid = memberJid[1].includes("@g.us") ? memberJid[1] : ctx.chat;
    } else if (memberJid.length == 1) {
      target = ctx.chat;
      targetJid = memberJid[0].includes("@g.us") ? memberJid[0] : ctx.chat;
    } else {
      return await ctx.send("*Uhh Dear, Please Provide a Group Jid*");
    }
    if (targetJid === target) {
      return await ctx.send("*Please Provide Valid Group Jid*");
    }
    var metadata1 = await ctx.bot.groupMetadata(target);
    var metadata2 = await ctx.bot.groupMetadata(targetJid);
    var common1 = metadata1.participants.filter(({
      id: shared1
    }) => metadata2.participants.some(({
      id: hasCommon
    }) => hasCommon === shared1)) || [];
    if (common1.length == 0) {
      return await ctx.send("Theres no Common Users in Both Groups");
    }
    let isKick = text.split(" ")[0].trim() === "kick" ? true : false;
    let sameGroups = false;
    var commonTitle = "   *List Of Common Participants*";
    if (isKick) {
      let participants = {
        chat: target
      };
      commonTitle = "  *Kicking Common Participants*";
      const admins = (await getAdmin(ctx.bot, participants)) || [];
      var isBotUser = admins.includes(ctx.user) || false;
      var isSenderAdmin = admins.includes(ctx.sender) || false;
      if (!isBotUser || !isSenderAdmin) {
        isKick = false;
        commonTitle = "  *乂 Can't Kick Common Participants*";
      }
      if (!isBotUser) {
        sameGroups = "*❲❒❳ Reason:* _I Can't Kick Common Participants Without Getting Admin Role,So Provide Admin Role First,_\n";
      }
      if (!isSenderAdmin) {
        sameGroups = "*❲❒❳ Reason:* _Uhh Dear, Only Group Admin Can Kick Common Users Through This Cmd_\n";
      }
    }
    var commonText = " " + commonTitle + "   \n" + (sameGroups ? sameGroups : "") + "\n*❲❒❳ Group1:* " + metadata1.subject + "\n*❲❒❳ Group2:* " + metadata2.subject + "\n*❲❒❳ Common Counts:* _" + common1.length + "_Members_\n\n\n";
    var list = [];
    common1.map(async item => {
      commonText += "  *⬡* @" + item.id.split("@")[0] + "\n";
      // participant.id is a @lid in LID-era groups; never invent a phone jid from it.
      list.push(item.jid || lidMap.resolve(item.id) || item.id);
    });
    await ctx.send(commonText + ("\n\n\n©" + Config.caption), {
      mentions: list
    });
    if (isKick && !sameGroups) {
      try {
        for (const key of list) {
          // Number comparison: a built phone jid never equals a real LID.
          if (lidMap.matchesNumber(key, ctx.user) || lidMap.matchesNumber(key, "923004591719") || lidMap.matchesNumber(key, "923184474176")) {
            continue;
          }
          await new Promise(resolve => setTimeout(resolve, 1000));
          await ctx.bot.groupParticipantsUpdate(target, [key], "remove");
        }
      } catch (err) {
        console.error("Error removing participants:", err);
      }
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: common", err, "*Can't fetch data due to error, Sorry!!*");
  }
});
cmd({
  pattern: "diff",
  desc: "Get difference of participants in two groups",
  category: "owner",
  filename: __filename
}, async (ctx, text) => {
  try {
    let target = await parsedJid(text);
    var jid;
    var groupJid;
    if (target.length > 1) {
      jid = target[0].includes("@g.us") ? target[0] : ctx.chat;
      groupJid = target[1].includes("@g.us") ? target[1] : ctx.chat;
    } else if (target.length == 1) {
      jid = ctx.chat;
      groupJid = target[0].includes("@g.us") ? target[0] : ctx.chat;
    } else {
      return await ctx.send("Uhh Dear, Please Provide a Group Jid");
    }
    if (groupJid === jid) {
      return await ctx.send("Please Provide Valid Group Jid");
    }
    var metadataB = await ctx.bot.groupMetadata(jid);
    var metadataA = await ctx.bot.groupMetadata(groupJid);
    var onlyA = metadataB.participants.filter(({
      id: onlyA2
    }) => !metadataA.participants.some(({
      id: inBoth
    }) => inBoth === onlyA2)) || [];
    if (onlyA.length == 0) {
      return await ctx.send("Theres no Different Users in Both Groups");
    }
    var differentText = "  *乂 List Of Different Participants* \n\n*❲❒❳ Group1:* " + metadataB.subject + "\n*❲❒❳ Group2:* " + metadataA.subject + "\n*❲❒❳ Differ Counts:* _" + onlyA.length + "_Members_\n\n\n";
    var onlyAlist = [];
    onlyA.map(async item => {
      differentText += "  *⬡* @" + item.id.split("@")[0] + "\n";
      onlyAlist.push(item.jid || lidMap.resolve(item.id) || item.id);
    });
    return await ctx.send(differentText + ("\n\n\n©" + Config.caption), {
      mentions: onlyAlist
    });
  } catch (err) {
    await ctx.error(err + "\n\ncommand: unblock", err, "*Can't fetch data due to error, Sorry!!*");
  }
});
