smd({
  cmdname: "left",
  info: "left from a group.",
  fromMe: true,
  type: "group",
  filename: __filename
}, async (ctx, text) => {
  try {
    if (!ctx.isGroup) {
      return await ctx.send(tlang().group, {}, "", ctx);
    }
    let toggle = text.toLowerCase().trim();
    if (toggle.startsWith("sure") || toggle.startsWith("ok") || toggle.startsWith("yes")) {
      await ctx.bot.groupParticipantsUpdate(ctx.chat, [ctx.user], "remove");
      ctx.send("*Group Left!!*", {}, "", ctx, ctx.user);
    } else {
      return await ctx.send("*_Use: " + prefix + "left sure/yes/ok, For security threats_*", {}, "", ctx);
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: left", err, false);
  }
});
