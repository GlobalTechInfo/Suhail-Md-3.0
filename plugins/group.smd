cmd({
  pattern: "getjids",
  alias: ["gjid", "gjids", "allgc", "gclist"],
  desc: "Sends chat id of every groups.",
  category: "group",
  filename: __filename
}, async (ctx, text, {
  cmdName: cmdName
}) => {
  try {
    if (!ctx.isCreator) {
      return ctx.reply(tlang().owner);
    }
    n = await ctx.bot.groupFetchAllParticipating();
    const participants = Object.entries(n).slice(0).map(item => item[1]);
    let body = "";
    let found = false;
    let found2 = false;
    if (text.includes("jid")) {
      found = true;
    } else if (text.includes("name")) {
      found2 = true;
    }
    await ctx.reply("Fetching " + (found ? "Only jids" : found2 ? "Only Names" : "Names and Jids") + " from " + participants.length + " Groups");
    await sleep(2000);
    for (var key of participants.map(item => item.id)) {
      body += found ? "" : "\n*Group:* " + n[key].subject + " ";
      body += found2 ? "" : "\n*JID:* " + key + "\n";
    }
    return await ctx.send(body);
  } catch (err) {
    await ctx.error(err + "\n\ncommand: " + cmdName, err);
  }
});
