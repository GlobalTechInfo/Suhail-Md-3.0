  fromMe: true,
  category: "group",
  filename: __filename,
  use: "<text for broadcast.>"
}, async (ctx, text) => {
  try {
    if (!text) {
      return await ctx.reply("*_Uhh Dear, Provide text to broadcast in all groups_*");
    }
    let participants = await ctx.bot.groupFetchAllParticipating();
    let list = Object.entries(participants).slice(0).map(item => item[1]);
    let ids = list.map(item => item.id);
    await ctx.send("*_Sending Broadcast To " + ids.length + " Group Chat, Finish Time " + ids.length * 1.5 + " second_*");
    let broadcastMsg = "*--❗" + tlang().title + " Broadcast❗--*\n\n *🍀Message:* " + text;
    let broadcastText = {
      forwardingScore: 999,
      isForwarded: true
    };
    for (let key of ids) {
      try {
        await sleep(1500);
        await send(ctx, broadcastMsg, {
          contextInfo: broadcastText
        }, "", "", key);
      } catch {}
    }
    return await ctx.reply("*Successful Sending Broadcast To " + ids.length + " Group*");
  } catch (err) {
    await ctx.error(err + "\n\ncommand: broadcast", err);
  }
});
/*
{
   pattern: "group",
   type: "notes",
}
*/
