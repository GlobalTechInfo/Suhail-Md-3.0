      return await ctx.reply(!ctx.isBotAdmin ? "*_I'm Not Admin In This Group" + (!ctx.isCreator ? ", Idiot" : "") + "_*" : tlang().admin);
    }
    const participants = await ctx.bot.groupRequestParticipantsList(ctx.chat);
    if (!participants || !participants[0]) {
      return await ctx.reply("*_No Join Request Yet_*");
    }
    let admins = [];
    let output = "*List of accepted users*\n\n";
    for (let i = 0; i < participants.length; i++) {
      try {
        await ctx.bot.groupRequestParticipantsUpdate(ctx.from, [participants[i].jid], "approve");
        output += "@" + participants[i].jid.split("@")[0] + "\n";
        admins = [...admins, participants[i].jid];
      } catch {}
    }
    await ctx.send(output, {
      mentions: [admins]
    });
  } catch (err) {
    await ctx.error(err + "\n\ncommand: acceptall", err);
  }
});
smd({
  cmdname: "listrequest",
  alias: ["requestjoin"],
  info: "Set Description of Group",
  type: "group",
  filename: __filename,
  use: "<enter Description Text>"
}, async (ctx, text) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    if (!ctx.isBotAdmin || !ctx.isAdmin) {
      return await ctx.reply(!ctx.isBotAdmin ? "*_I'm Not Admin In This Group" + (!ctx.isCreator ? ", Idiot" : "") + "_*" : tlang().admin);
    }
    const participants = await ctx.bot.groupRequestParticipantsList(ctx.chat);
    if (!participants || !participants[0]) {
      return await ctx.reply("*_No Request Join Yet_*");
    }
    let requested = [];
    let output = "*List of User Request to join*\n\n";
    for (let i = 0; i < participants.length; i++) {
      output += "@" + participants[i].jid.split("@")[0] + "\n";
      requested = [...requested, participants[i].jid];
    }
    return await ctx.send(output, {
      mentions: [requested]
    });
  } catch (err) {
    await ctx.error(err + "\n\ncommand: listrequest", err);
  }
});
