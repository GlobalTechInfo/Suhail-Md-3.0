const grouppattern = /https:\/\/chat\.whatsapp\.com\/[A-Za-z0-9]{22}/g;
smd({
  cmdname: "join",
  info: "joins group by link",
  type: "whatsapp",
  fromMe: true,
  filename: __filename,
  use: "<group link.>"
}, async (ctx, text) => {
  try {
    if (ctx.reply_message && ctx.reply_message.groupInvite) {
      var invite = await ctx.bot.groupAcceptInviteV4(ctx.chat, ctx.reply_message.msg);
      if (invite && invite.includes("joined to:")) {
        return await send(ctx, "*_Joined_*", {}, "", ctx);
      }
    }
    let input = text ? text : ctx.reply_text;
    const match = input.match(grouppattern);
    if (!match) {
      return await ctx.reply("*_Uhh Please, provide group link_*");
    }
    let inviteCode = match[0].split("https://chat.whatsapp.com/")[1].trim();
    await ctx.bot.groupAcceptInvite(inviteCode).then(result => send(ctx, "*_Joined_*", {}, "", ctx)).catch(err => ctx.send("*_Can't Join, Group Id not found!!_*"));
  } catch (err) {
    await ctx.error(err + "\n\ncommand: join", err, "*_Can't Join, Group Id not found, Sorry!!_*");
  }
});
smd({
  cmdname: "newgc",
  info: "Create New Group",
  type: "whatsapp",
  filename: __filename,
  use: "<group link.>"
}, async (ctx, text, {
  smd: smdHelper,
  cmdName: cmdName
}) => {
  try {
    if (!ctx.isCreator) {
      return ctx.reply(tlang().owner);
    }
    if (!text) {
      return await ctx.reply("*_provide Name to Create new Group!!!_*\n*_Ex: " + (prefix + smdHelper) + " My Name Group @user1,2,3.._*");
    }
    let target = text;
    if (target.toLowerCase() === "info") {
      return await ctx.send(("\n  *Its a command to create new Gc*\n  \t```Ex: " + (prefix + cmd) + " My new Group```\n  \n*You also add peoples in newGc*\n  \t```just reply or mention Users```\n  ").trim());
    }
    let members = [ctx.sender];
    if (ctx.quoted) {
      members.push(ctx.quoted.sender);
    }
    if (ctx.mentionedJid && ctx.mentionedJid[0]) {
      members.push(...ctx.mentionedJid);
      try {
        mentionJids.forEach(item => {
          var newSubject = item.split("@")[0].trim();
          target = target.replace(new RegExp("@" + newSubject, "g"), "");
        });
      } catch {}
    }
    const subject = target.substring(0, 60);
    const newGroup = await Suhail.bot.groupCreate(subject, [...members]);
    if (newGroup) {
      let createdGroup = await ctx.bot.sendMessage(newGroup.id, {
        text: "*_Hey Buddy, Welcome to new Group_*\n" + Config.caption
      });
      try {
        var inviteCode = await Suhail.bot.groupInviteCode(newGroup.id);
      } catch {
        var inviteCode = false;
      }
      var inviteUrl = "https://chat.whatsapp.com/";
      var fullInviteUrl = "" + inviteUrl + inviteCode;
      return await send(ctx, ("*_Hurray, New group created!!!_*\n" + (inviteCode ? "*_" + fullInviteUrl + "_*" : "")).trim(), {}, "", createdGroup);
    } else {
      await ctx.send("*_Can't create new group, Sorry!!_*");
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: " + cmdName, err, "*_Can't create new group, Sorry!!_*");
  }
});
smd({
  pattern: "ginfo",
  desc: "get group info by link",
  type: "group",
  filename: __filename,
  use: "<group link.>"
}, async (ctx, text) => {
  try {
    let input = text ? text : ctx.reply_text;
    const match = input.match(grouppattern) || false;
    if (!match) {
      return await ctx.reply("*_Uhh Please, provide group link_*");
    }
    let inviteCode = match[0].split("https://chat.whatsapp.com/")[1].trim();
    // Invite links often carry trailing query text (.../<code>?text=...). Keep only the code.
    inviteCode = inviteCode.split("?")[0].trim();
    let inviteInfo;
    try {
      inviteInfo = await ctx.bot.groupGetInviteInfo(inviteCode);
    } catch (err) {
      // Report what actually failed instead of the blanket "Group Id not found".
      return await ctx.reply("*_Couldn't read that invite link.*\n_" + (err && err.message ? err.message.split("\n")[0] : "WhatsApp rejected the invite code") + "_");
    }
    if (inviteInfo) {
      const created = new Date(inviteInfo.creation * 1000);
      var year = created.getFullYear();
      var month = created.getMonth() + 1;
      var day = created.getDate();
      var date = year + "-" + month.toString().padStart(2, "0") + "-" + day.toString().padStart(2, "0");
      return await send(ctx, (inviteInfo.subject + "\n  \n  Creator: wa.me/" + inviteInfo.owner.split("@")[0] + " \n  GJid; ```" + inviteInfo.id + "  ```\n  *Muted:* " + (inviteInfo.announce ? " yes" : " no") + "\n  *Locked:* " + (inviteInfo.restrict ? " yes" : " no") + "\n  *createdAt:* " + date + "\n  *participents:* " + (inviteInfo.size > 3 ? inviteInfo.size + "th" : inviteInfo.size) + "\n  " + (inviteInfo.desc ? "*description:* " + inviteInfo.desc + "\n" : "") + "\n  " + Config.caption + "\n  ").trim(), {
        mentions: [inviteInfo.owner]
      }, "", ctx);
    } else {
      await ctx.send("*_Group Id not found, Sorry!!_*");
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: ginfo", err, "*_Group Id not found, Sorry!!_*");
  }
});
smd({
  cmdname: "rejectall",
  alias: ["rejectjoin"],
  info: "reject all request to join!",
  type: "group",
  filename: __filename
}, async (ctx, text) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    if (!ctx.isBotAdmin || !ctx.isAdmin) {
      return await ctx.reply(!ctx.isBotAdmin ? "*_I'm Not Admin In This Group" + (!ctx.isCreator ? ", Idiot" : "") + "_*" : tlang().admin);
    }
    const participants = await ctx.bot.groupRequestParticipantsList(ctx.chat);
    if (!participants || !participants[0]) {
      return await ctx.reply("*_No Request Join Yet_*");
    }
    let rejected = [];
    let rejectedOutput = "*List of rejected users*\n\n";
    for (let i = 0; i < participants.length; i++) {
      try {
        await ctx.bot.groupRequestParticipantsUpdate(ctx.from, [participants[i].jid], "reject");
        rejectedOutput += "@" + participants[i].jid.split("@")[0] + "\n";
        rejected = [...rejected, participants[i].jid];
      } catch {}
    }
    await ctx.send(rejectedOutput, {
      mentions: [rejected]
    });
  } catch (err) {
    await ctx.error(err + "\n\ncommand: rejectall", err);
  }
});
smd({
  cmdname: "acceptall",
  alias: ["acceptjoin"],
  info: "accept all request to join!",
  type: "group",
  filename: __filename
}, async (ctx, text) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
