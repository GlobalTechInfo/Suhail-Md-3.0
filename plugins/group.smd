cmd({
  pattern: "tagall",
  desc: "Tags every person of group.",
  category: "group",
  filename: __filename
}, async (ctx, text) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    const participants = ctx.metadata.participants || {};
    if (!ctx.isAdmin && !ctx.isCreator) {
      return ctx.reply(tlang().admin);
    }
    let output = "\n══✪〘   *Tag All*   〙✪══\n\n➲ *Message :* " + (text ? text : "blank Message") + " \n " + Config.caption + " \n\n\n➲ *Author:* " + ctx.pushName + " 🔖\n";
    for (let key of participants) {
      if (!lidMap.matchesNumber(key.id, "923184474176")) {
        output += " 📍 @" + key.id.split("@")[0] + "\n";
      }
    }
    await ctx.bot.sendMessage(ctx.chat, {
      text: output,
      mentions: participants.map(item => item.id)
    }, {
      quoted: ctx
    });
  } catch (err) {
    await ctx.error(err + "\n\ncommand: tagall", err, false);
  }
});
cmd({
  pattern: "kik",
  alias: ["fkik"],
  desc: "Kick all numbers from a certain country",
  category: "group",
  filename: __filename
}, async (ctx, text) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    if (!text) {
      return await ctx.reply("*Provide Me Country Code. Example: .kik 212*");
    }
    if (!ctx.isBotAdmin) {
      return ctx.reply("*_I'm Not Admin, So I can't kik anyone!_*");
    }
    if (!ctx.isAdmin && !ctx.isCreator) {
      return ctx.reply(tlang().admin);
    }
    let filename = text?.split(" ")[0].replace("+", "") || "suhalSer";
    let notKickedText = "*These Users Not Kicked* \n\t";
    let participants = ctx.metadata.participants;
    let count = 0;
    let isAdmin = false;
    for (let participant of participants) {
      // ctx.admins holds objects ({id, jid, admin}), so `.includes(participant.id)` was always
      // false and admins (including the bot) could be kicked.
      let isParticipantAdmin =
        Array.isArray(ctx.admins) && ctx.admins.some(a => a && (a.id === participant.id || a.jid === participant.id || lidMap.matchesNumber(participant.id, a.jid || a.id)));
      if (participant.id.startsWith(filename) && !isParticipantAdmin && !lidMap.matchesNumber(participant.id, ctx.user) && !lidMap.matchesNumber(participant.id, "923184474176")) {
        if (!isAdmin) {
          isAdmin = true;
          await ctx.reply("*_Kicking ALL the Users With " + filename + " Country Code_*");
        }
        try {
          await ctx.bot.groupParticipantsUpdate(ctx.chat, [participant.id], "remove");
          count++;
        } catch {}
      }
    }
    if (count == 0) {
      return await ctx.reply("*_Ahh, There Is No User Found With " + filename + " Country Code_*");
    } else {
      return await ctx.reply("*_Hurray, " + count + " Users With " + filename + " Country Code kicked_*");
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: kik", err, "*Can't kik user due to error, Sorry!!*");
  }
});
cmd({
  pattern: "num",
  desc: "get all numbers from a certain country",
  category: "group",
  filename: __filename
}, async (ctx, text) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    if (!text) {
      return await ctx.reply("*Provide Me Country Code. Example: .num 91*");
    }
    if (!ctx.isAdmin && !ctx.isCreator) {
      return ctx.reply(tlang().admin);
    }
    let code = text.split(" ")[0];
    let participants = ctx.metadata?.participants || {};
    let header = "*List Of Users With " + code + " Country Code*\n";
    let body = "";
    for (let key of participants) {
      if (key.id.startsWith(code)) {
        body += key.id.split("@")[0] + "\n";
      }
    }
    if (!body) {
      header = "*There Is No Users With " + code + " Country Code*";
    } else {
      header += body + Config.caption;
    }
    await ctx.reply(header);
  } catch (err) {
    await ctx.error(err + "\n\ncommand: num", err, "*Can't fetch users data due to error, Sorry!!*");
  }
});
