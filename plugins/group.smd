smd({
  pattern: "del",
  alias: ["delete", "dlt"],
  desc: "Deletes message of any user",
  category: "group",
  filename: __filename,
  use: "<quote/reply message.>"
}, async ctx => {
  try {
    if (!ctx.reply_message) {
      return ctx.reply("*_Please reply to a message!!!_*");
    }
    let quoted = ctx.reply_message;
    if (quoted && quoted.fromMe && ctx.isCreator) {
      return quoted.delete();
    } else if (quoted && ctx.isGroup) {
      if (!ctx.isBotAdmin) {
        return ctx.reply("*I can't delete messages without getting Admin Role.*");
      }
      if (!ctx.isAdmin) {
        return ctx.reply(tlang().admin);
      }
      await quoted.delete();
    } else {
      return await ctx.reply(tlang().owner);
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: del", err);
  }
});
