smd({
  pattern: "tag",
  alias: ["hidetag"],
  desc: "Tags everyperson of group without mentioning their numbers",
  category: "group",
  filename: __filename,
  use: "<text>"
}, async (ctx, text) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    if (!text && !ctx.reply_message) {
      return ctx.reply("*Example : " + prefix + "tag Hi Everyone, How are you Doing*");
    }
    if (!ctx.isAdmin && !ctx.isCreator) {
      return ctx.reply(tlang().admin);
    }
    let quoted = ctx.reply_message ? ctx.reply_message : ctx;
    let quotedText = ctx.reply_message ? ctx.reply_message.text : text;
    let caption = "";
    let mtype;
    let quotedType = quoted.mtype;
    if (quotedType == "imageMessage") {
      caption = "image";
      mtype = await quoted.download();
    } else if (quotedType == "videoMessage") {
      caption = "video";
      mtype = await quoted.download();
    } else if (!text && ctx.quoted) {
      mtype = ctx.quoted.text;
    } else {
      mtype = text;
    }
    if (!mtype) {
      return await ctx.send("*_Uhh dear, reply to message!!!_*");
    }
    return await ctx.send(mtype, {
      caption: quotedText,
      mentions: ctx.metadata.participants.map(item => item.id)
    }, caption, quoted);
  } catch (err) {
    await ctx.error(err + "\n\ncommand: tag", err);
  }
});
