smd({
  pattern: "gitclone",
  desc: "Downloads apks  .",
  category: "downloader",
  filename: __filename,
  use: "<add sticker url.>"
}, async (ctx, text) => {
  try {
    let gitText = text ? text : ctx.reply_message ? ctx.reply_message.text : "";
    if (!text) {
      return await ctx.reply("*Provide Repo Url, _.gitclone https://github.com/SuhailTechInfo/Suhail-Md_*");
    }
    const gitPattern = /(?:https|git)(?::\/\/|@)github\.com[\/:]([^\/:]+)\/(.+)/i;
    if (!gitPattern.test(text)) {
      return await ctx.reply("*Provide Valid Repositry Url*");
    }
    let [protocol, repo, file] = text.match(gitPattern) || [];
    file = file.replace(/.git$/, "");
    let rawUrl = "https://api.github.com/repos/" + repo + "/" + file + "/zipball";
    let response = (await fetch(rawUrl, {
      method: "HEAD"
    })).headers.get("content-disposition").match(/attachment; filename=(.*)/)[1];
    const githubOptions = {
      url: rawUrl
    };
    await ctx.bot.sendMessage(ctx.jid, {
      document: githubOptions,
      fileName: response,
      mimetype: "application/zip"
    });
  } catch (err) {
    return ctx.error(err + "\n\ncommand: gitclone", err, "*_File not found!!!_*");
  }
});
