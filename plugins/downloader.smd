smd({
  pattern: "apk",
  alias: ["modapk"],
  desc: "Downloads apks  .",
  category: "downloader",
  filename: __filename,
  use: "<add sticker url.>"
}, async (ctx, text) => {
  try {
    if (!text) {
      return ctx.reply("*_Uhh dear, Give me App Name!_*");
    }
    let results = await search(text);
    let app = {};
    if (results.length) {
      app = await download(results[0].id);
    } else {
      return ctx.reply("*_Apk not found, Try another name!!_*");
    }
    const size = parseInt(app.size);
    if (size > 200) {
      return ctx.reply("❌ File size bigger than 200mb.");
    }
    const dllink = app.dllink;
    let mediaUrl = await fancytext("『 *ᗩᑭᏦ  ᗞᝪᗯᑎしᝪᗩᗞᗴᖇ* 』\n\n*APP Name :* " + app.name + "\n*App Id :* " + app.package + "\n*Last Up :* " + app.lastup + "\n*App Size :* " + app.size + "\n\n\n " + Config.caption, 25);
    const fileName = (app?.name || "Downloader") + ".apk";
    const filePath = "temp/" + fileName;
    const stickerMeta = {
      caption: mediaUrl
    };
    let stickersBuffer = await ctx.reply(app.icon, stickerMeta, "img", ctx);
    axios.get(dllink, {
      responseType: "stream"
    }).then(result => {
      const writeStream = fs.createWriteStream(filePath);
      result.data.pipe(writeStream);
      return new Promise((resolve, reject) => {
        writeStream.on("finish", resolve);
        writeStream.on("error", reject);
      });
    }).then(() => {
      let apkReply = {
        document: fs.readFileSync(filePath),
        mimetype: "application/vnd.android.package-archive",
        fileName: fileName
      };
      const stickerReply2 = {
        quoted: stickersBuffer
      };
      ctx.bot.sendMessage(ctx.jid, apkReply, stickerReply2);
      try {
        fs.unlink(filePath);
      } catch {}
    }).catch(err => {
      try {
        fs.unlink(filePath);
      } catch {}
      ;
      ctx.reply("*_Apk not Found, Sorry_*");
    });
  } catch (err) {
    await ctx.error(err + "\n\ncommand: apk", err, "*_Apk not Found!_*");
  }
});
