// ---------------------------------------------------------------------------
// Loader API - replaces the youtubei.js / ytdl path for .play, .ytmp3 and .ytmp4.
//
// The old flow died with "Video not Found": youtubei.js and ytdl no longer resolve streams.
// Media source: gtech-api. It takes a YouTube URL and hands back direct, progressive media URLs
// (verified: video_url_hd -> 206 video/mp4 ftypmp42, audio_url -> 206 audio/webm), for both regular
// videos and Shorts. The previous loaderto endpoint was removed because its downloadUrl 302s into an
// ad tracker (p.savenow.to -> ey43.com) and never serves media, so no retry could ever succeed.
//
// The auth check only tests that apikey is present - it accepts any value.
const GTECH_API = "https://gtech-api-xtp1.onrender.com";
const GTECH_KEY = "APIKEY";
// Measured over 3 tries x 3 videos: a "good" video succeeds every time, a "bad" one fails every
// time on BOTH providers (scrappy returns ERR_YTDLP_EXIT on the same IDs - YouTube blocks those
// from Render egress), and one in between landed 1 of 3. So per-attempt success is roughly 1/3 and
// a single retry is not enough. Four attempts puts the odds near 75% for no extra dependency.
const GTECH_ATTEMPTS = 4;

let loaderUrlProblem = "";

// gtech answers with a JSON envelope that carries status:false and a message when it cannot resolve a
// video, so never trust a single response: parse defensively, require status:true, and verify the
// media URL actually serves bytes before handing it to the chat.
const parseLoaderBody = raw => {
  if (raw && typeof raw === "object") {
    return raw;
  }
  if (typeof raw !== "string") {
    return null;
  }
  const text = raw.trim();
  if (!text.startsWith("{")) {
    return null;
  }
  try {
    return JSON.parse(text);
  } catch (err) {
    return null;
  }
};

// The endpoint reports success (progress 1000) and hands back a downloadUrl that is sometimes an
// ad/redirect page rather than the file - which is what produced "unplayable" media. Confirm the
// URL really serves audio/video before handing it on, and report what came back so the cause is
// visible instead of shipping a broken file.
const loaderUrlIsPlayable = async url => {
  try {
    const res = await axios.get(url, {
      method: "GET",
      responseType: "arraybuffer",
      timeout: 60000,
      maxRedirects: 5,
      headers: {
        Range: "bytes=0-2047"
      }
    });
    const type = String(res.headers["content-type"] || "").split(";")[0];
    const bytes = res.data ? res.data.length : 0;
    if (bytes > 0 && /^(audio|video|application\/octet-stream)/i.test(type)) {
      return true;
    }
    loaderUrlProblem = "served " + (type || "unknown content-type") + ", not media";
    return false;
  } catch (err) {
    loaderUrlProblem = "request failed (" + (err && err.response ? "HTTP " + err.response.status : err && err.code) + ")";
    return false;
  }
};

const loaderFetch = async (ytUrl, format) => {
  // format "720" is the only video caller; everything else wants audio.
  const wantVideo = String(format) === "720";
  const route = wantVideo ? "/api/video/yt" : "/api/audio/yt";
  let lastErr;
  for (let attempt = 1; attempt <= GTECH_ATTEMPTS; attempt++) {
    try {
      const res = await axios.get(GTECH_API + route, {
        params: { apikey: GTECH_KEY, url: ytUrl },
        timeout: 60000,
        validateStatus: () => true,
        transformResponse: d => d
      });
      const body = parseLoaderBody(res.data);
      if (!body) throw new Error("attempt " + attempt + "/" + GTECH_ATTEMPTS + ": non-JSON response");
      if (body.status !== true) {
        throw new Error("attempt " + attempt + "/" + GTECH_ATTEMPTS + ": " + (body.message || body.error || "status=false"));
      }
      const media = (body.result && body.result.media) || {};
      // Prefer the HD variant but fall back down; gtech reports "No SD video URL available".
      const downloadUrl = wantVideo
        ? (media.video_url_hd && media.video_url_hd.startsWith("http") ? media.video_url_hd : media.video_url)
        : media.audio_url;
      if (!downloadUrl || !String(downloadUrl).startsWith("http")) {
        throw new Error("attempt " + attempt + "/" + GTECH_ATTEMPTS + ": no " + (wantVideo ? "video" : "audio") + " url in payload");
      }
      // Keep the existing guard: gtech sometimes hands back a URL whose proxy 403s, and shipping
      // that would post a broken file to the chat instead of an honest error.
      if (!(await loaderUrlIsPlayable(downloadUrl))) {
        throw new Error("attempt " + attempt + "/" + GTECH_ATTEMPTS + ": media url " + (loaderUrlProblem || "not playable"));
      }
      return {
        url: downloadUrl,
        title: media.title,
        thumbnail: media.thumbnail,
        format: wantVideo ? (media.extension || "mp4") : (media.extension || "webm"),
        quality: media.quality
      };
    } catch (err) {
      lastErr = err;
      if (attempt === GTECH_ATTEMPTS) {
        break;
      }
      await new Promise(r => setTimeout(r, 2500));
    }
  }
  throw new Error("gtech returned no playable file after " + GTECH_ATTEMPTS + " attempts (" + (lastErr && lastErr.message) + ")");
};

// TikTok download API. The old command scraped three third-party endpoints
// (api_smd/ttdl2, musically, betabotz tiktokdl) which no longer resolve anything.
// This endpoint returns direct CDN links; we prefer nowatermark_hd, then nowatermark, then
// watermarked. Note the media URLs 302 to a tiktokcdn host, so redirects must be followed.
const TIKTOK_API = "https://api.qasimdev.dpdns.org/api/tiktok/download";
const TIKTOK_KEY = "qasim-dev";

const tiktokFetch = async url => {
  const res = await axios.get(TIKTOK_API, {
    params: {
      url: url,
      apiKey: TIKTOK_KEY
    },
    timeout: 90000
  });
  const body = res.data || {};
  if (!body.success || !body.data) {
    throw new Error(body.message || "tiktok api returned no data");
  }
  const data = body.data;
  // data.data is the list of renditions; pick the best no-watermark one available.
  const variants = Array.isArray(data.data) ? data.data : [];
  const pick = type => (variants.find(v => v && v.type === type) || {}).url;
  const video = pick("nowatermark_hd") || pick("nowatermark") || pick("watermark");
  if (!video) {
    throw new Error("tiktok api returned no playable video url");
  }
  return {
    video: video,
    audio: data.music_info && data.music_info.url,
    title: data.title,
    author: data.author && (data.author.nickname || data.author.fullname),
    duration: data.duration,
    cover: data.cover
  };
};

// TikTok share text carries trailing prose ("This post is shared via TikTok Lite..."), and short
// vm.tiktok.com links need expanding, so pull the URL out rather than trusting the raw input.
const extractTiktokUrl = text => {
  const found = String(text || "").match(/https?:\/\/(?:www\.|vm\.)?tiktok\.com\/[^\s]+/i);
  return found ? found[0] : "";
};

// Pinterest search API. The old path scraped id.pinterest.com directly, which no longer returns
// anything usable; this endpoint returns ready-to-send image URLs.
const PINTEREST_API = "https://api.qasimdev.dpdns.org/api/pinterest/search";
const PINTEREST_KEY = "qasim-dev";

const pinterestSearch = async query => {
  const res = await axios.get(PINTEREST_API, {
    params: {
      query: query,
      apiKey: PINTEREST_KEY
    },
    timeout: 90000
  });
  const body = res.data || {};
  if (!body.success || !Array.isArray(body.data)) {
    throw new Error(body.message || "pinterest search returned no results");
  }
  return body.data.filter(pin => pin && pin.images_url);
};

// Resolve a query or URL to a full YouTube URL.
// Search provider. qasimdev's /api/youtube/video is preferred over secktor-pack because it answers
// from Varnish in ~6s once warm, against secktor-pack's consistent ~9s scrape on every call.
//
// Cold cache is the normal first response: Varnish exceeds its first-byte timeout while the backend
// extracts and returns a "503 first byte timeout" HTML page. The object still gets cached on the way
// through (x-cache-ttl 300), so the next attempt hits it. That is why a retry - not a cache bypass -
// is the correct response to that 503.
//
// Deliberately returns the same { videos: [{ url, ... }] } shape secktor-pack returns, so the four
// existing call sites keep working untouched. Named ytFind because two call sites already bind a local
// variable called ytSearch, which would shadow the function.
const QASIM_SEARCH = "https://api.qasimdev.dpdns.org/api/youtube/video";
const QASIM_SEARCH_KEY = "qasim-dev";
const QASIM_SEARCH_ATTEMPTS = 3;

const searchViaQasim = async term => {
  for (let attempt = 1; attempt <= QASIM_SEARCH_ATTEMPTS; attempt++) {
    try {
      const res = await axios.get(QASIM_SEARCH, {
        params: { apiKey: QASIM_SEARCH_KEY, query: term, format: "360" },
        timeout: 60000,
        validateStatus: () => true,
        transformResponse: d => d
      });
      const text = String(res.data === undefined || res.data === null ? "" : res.data);
      if (!text.trim().startsWith("{")) throw new Error("non-JSON response");
      const body = JSON.parse(text);
      const info = body && body.success === true && body.data && body.data.searchInfo;
      if (!info || !info.url) throw new Error("no searchInfo.url in payload");
      return {
        videos: [{
          url: info.url,
          title: body.data.title || "",
          thumbnail: body.data.thumbnail || "",
          duration: { seconds: 0, timestamp: info.timestamp || "" }
        }]
      };
    } catch (err) {
      if (attempt === QASIM_SEARCH_ATTEMPTS) {
        console.error("ytFind: qasimdev search failed, falling back to secktor-pack ->", err && err.message);
        return null;
      }
      await new Promise(r => setTimeout(r, 4000));
    }
  }
  return null;
};

const ytFind = async term => (await searchViaQasim(term)) || (await yts(term));

const resolveYtUrl = async text => {
  const found = ytIdRegex.exec(text);
  if (found && found[0]) {
    return found[0];
  }
  const results = await ytFind(text);
  const video = results && results.videos && results.videos[0];
  return video && video.url;
};

smd({
  pattern: "ytmp4",
  alias: ["ytv", "ytvid", "ytvideo"],
  desc: "Downloads video from youtube.",
  category: "downloader",
  filename: __filename,
  use: "<yt video url>"
}, async (ctx, text) => {
  const docText = text ? text : ctx.reply_text;
  if (!docText) {
    return await ctx.reply("*_provide youtube video url!_*");
  }
  let url;
  try {
    url = await resolveYtUrl(docText);
  } catch (err) {
    return await ctx.reply("*_Couldn't find that video_*\n_" + (err && err.message ? err.message.split("\n")[0] : "search failed") + "_");
  }
  if (!url) {
    return await ctx.reply("*_Couldn't find that video_*");
  }
  try {
    await ctx.reply("_Fetching " + (docText || url) + "..._\n_May take up to a minute._");
    const media = await loaderFetch(url, "720");
    await ctx.bot.sendMessage(ctx.jid, {
      video: {
        url: media.url
      },
      mimetype: "video/mp4",
      fileName: media.title || "Suhail MD -- YT Video",
      caption: "  *Here's Your Video*\n" + Config.caption
    }, {
      quoted: ctx
    });
  } catch (err) {
    return await ctx.error(err + "\n\ncommand: ytmp4", err, "*_Couldn't get that video_*");
  }
});
smd({
  pattern: "ytmp3",
  alias: ["yta"],
  desc: "Downloads audio by yt link.",
  category: "downloader",
  use: "<yt video url>"
}, async (ctx, text) => {
  const ytText4 = text ? text : ctx.reply_text;
  if (!ytText4) {
    return await ctx.reply("*Uhh please, Provide youtube video url!*");
  }
  const match = ytIdRegex.exec(ytText4);
  if (!match || !match[0]) {
    return await ctx.reply("*Uhh please, Provide youtube video url!*");
  }
  try {
    await ctx.reply("_Fetching audio..._\n_May take up to a minute._");
    const media = await loaderFetch(match[0], "mp3");
    await ctx.bot.sendMessage(ctx.jid, {
      audio: {
        url: media.url
      },
      mimetype: "audio/mpeg",
      fileName: media.title || "Suhail MD -- YT Audio",
      caption: media.title || Config.caption
    }, {
      quoted: ctx
    });
  } catch (err) {
    return await ctx.error(err + "\n\ncommand: ytmp3", err, "*_Couldn't get that audio_*");
  }
});
smd({
  pattern: "ytdoc",
  alias: ["ytd"],
  desc: "Downloads audio by yt link as document.",
  category: "downloader",
  use: "<ytdoc video url>"
}, async (ctx, text) => {
  try {
    let ytDocText = text ? text : ctx.reply_text;
    const match = ytIdRegex.exec(ytDocText) || [];
    if (!ytDocText || !match[0]) {
      return await ctx.reply("❌Please provide me a url");
    }
    var url = match[1];
    var ok = false;
    try {
      if (global.ytdl_disabled) {
        throw "ytdl_ready is disabled!";
      }
      let info = await ytdl.getInfo(match[0]);
      url = info.videoDetails.title;
      let filePath = "./temp/Suhail-Md " + match[1] + ".mp3";
      const stream = ytdl(match[0], {
        filter: format => format.audioBitrate == 160 || format.audioBitrate == 128
      }).pipe(fs.createWriteStream(filePath));
      ok = filePath;
      await new Promise((resolve, reject) => {
        stream.on("error", reject);
        stream.on("finish", resolve);
      });
    } catch (err) {
      console.log("here now,ytdl-core : ", err);
      try {
        ok = await yt.download(match[1], {
          type: "audio",
          quality: "best"
        });
      } catch (err3) {
        return await ctx.error(err3 + "\n\ncommand: ytdoc", err3, "*_file not Found!!_*");
      }
    }
    if (!ok) {
      return await ctx.send("*_Uhh dear, video not found_*");
    }
    var ytReply2 = {
      ...(await ctx.bot.contextInfo(Config.botname, "ʏᴛᴅᴏᴄ ᴍᴘ3 ʏᴏᴜᴛᴜʙᴇ"))
    };
    const ytOptions = {
      url: ok
    };
    let ytReply = {
      document: ytOptions,
      mimetype: "audio/mpeg",
      fileName: "Suhail-Md--" + match[1] + ".mp3",
      caption: Config.caption,
      contextInfo: ytReply2
    };
    await ctx.bot.sendMessage(ctx.jid, ytReply, {
      quoted: ctx
    });
    try {
      return await fs.unlinkSync(ok);
    } catch {}
  } catch (err) {
    await ctx.error(err + "\n\ncommand: ytdoc", err, "*_audio file not Found!!_*");
  }
});
smd({
  on: "text"
}, async (ctx, text, {
  isCreator: isCreator
}) => {
  if (ctx.quoted && ctx.text) {
    const lines = ctx.quoted.text.split("\n");
    if (lines[0].includes("sᴜʜᴀɪʟ-ᴍᴅ • sᴏɴɢ ᴅᴏᴡɴʟᴏᴀᴅᴇʀ")) {
      const urlLine = lines.find(item => item.startsWith("Url :"));
      let playUrl = urlLine.replace("Url :", "").trim();
      try {
        await ctx.sendMessage(ctx.chat, {
          react: {
            text: "✨",
            key: ctx.key
          }
        });
        let buffer;
        if (ctx.text.startsWith("1") || ctx.text.startsWith("2")) {
          const ytReply3 = {
            ...ctx.key
          };
          let ytOptions2 = {
            key: ytReply3,
            message: {
              extendedTextMessage: {
                text: ("" + prefix + (ctx.text.startsWith("1") ? "ytmp4" : "play") + " " + playUrl + " " + (text.toLowerCase().includes("doc") ? "document" : "")).trim()
              }
            },
            pushName: ctx.pushName,
            messageTimestamp: ctx.messageTimestamp
          };
          ctx.bot.ev.emit("messages.upsert", {
            messages: [ytOptions2],
            type: "notify"
          });
        }
      } catch (err) {
        ctx.error(err + "\n\nCommand song Listener", err, "*Video Not Found!*");
      }
    } else if (lines[0].includes("sᴜʜᴀɪʟ-ᴍᴅ • ʏᴏᴜᴛᴜʙᴇ ᴅᴏᴡɴʟᴏᴀᴅ")) {
      let appPrefix = "*" + ctx.text.split(" ")[0] + " : ";
      const appLine = lines.find(item => item.startsWith(appPrefix));
      if (appLine) {
        try {
          let appName = appLine.replace(appPrefix, "").split("*")[0].trim();
          const nameLine = lines[lines.indexOf(appLine) + 1];
          const appUrl = nameLine.split("*")[1].replace("Url : ", "").trim();
          if (appUrl.startsWith("http")) {
            await ctx.sendMessage(ctx.chat, {
              react: {
                text: "✨",
                key: ctx.key
              }
            });
            const appOptions = {
              ...ctx.key
            };
            let audioType = text.toLowerCase().includes("doc") ? "document" : /mp3|audio|music/g.test(text) ? "audio" : "video";
            let appReply = {
              key: appOptions,
              message: {
                extendedTextMessage: {
                  text: ("" + prefix + (audioType == "audio" ? "play" : "video") + " " + appUrl + " " + (audioType === "document" ? audioType : "")).trim()
                }
              },
              pushName: ctx.pushName,
              messageTimestamp: ctx.messageTimestamp
            };
            ctx.bot.ev.emit("messages.upsert", {
              messages: [appReply],
              type: "notify"
            });
          }
        } catch (err) {
          ctx.error(err + "\n\nCommand yts Listener", err, "*Video Not Found!*");
        }
      }
    } else if (lines[0].includes("sᴜʜᴀɪʟ-ᴍᴅ • ᴀᴘᴋ ᴅᴏᴡɴʟᴏᴀᴅ ʟɪsᴛ")) {
      let playPrefix = "*" + ctx.text.split(" ")[0] + " : ";
      const appLine = lines.find(item => item.startsWith(playPrefix));
      if (appLine) {
        try {
          let playName = appLine.replace(playPrefix, "").split("*")[0].trim();
          const idLine = lines[lines.indexOf(appLine) + 1];
          const playId = idLine.split("*")[1].replace("Id : ", "").trim();
          await ctx.sendMessage(ctx.chat, {
            react: {
              text: "✨",
              key: ctx.key
            }
          });
          let app = await download(playId);
          let appLine2 = "*App Name :* " + app.name;
          appLine2 += "\n*App id        :* " + app.package;
          appLine2 += "\n*Last Up       :* " + app.lastup;
          appLine2 += "\n*App Size     :* " + app.size;
          appLine2 += "\n               \n" + global.caption;
          let appReply = {
            document: {
              url: app.dllink
            },
            mimetype: "application/vnd.android.package-archive",
            fileName: app.name + ".apk",
            caption: appLine2
          };
          return await ctx.sendMessage(ctx.chat, appReply, {
            quoted: ctx
          });
        } catch (err) {
          ctx.reply("*_Can't Download, App Limit Exceed_*");
        }
      }
    }
  }
});
