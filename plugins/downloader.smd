// Instagram downloader. Replaces the old .downmp4, which only echoed back whatever URL it was given.
//
// The API answers with a flat `data` array of {title, url}. Titles are "Download Video",
// "Download Thumbnail", or "Download Image" (a carousel returns one entry per image, and how many
// arrives varies - 1 to 5+), so nothing is positional: every entry is classified by its title and
// each one is sent independently. A single empty/!http entry is skipped, never aborting the rest.
const IG_API = "https://api.qasimdev.dpdns.org/api/instagram/download";
const IG_KEY = "qasim-dev";
const IG_ATTEMPTS = 2;

const igClassify = entry => {
  const title = String((entry && entry.title) || "").toLowerCase();
  if (title.includes("video")) return "video";
  if (title.includes("thumb")) return "image";
  if (title.includes("image")) return "image";
  return "image";
};

const igFetch = async igUrl => {
  let lastErr;
  for (let attempt = 1; attempt <= IG_ATTEMPTS; attempt++) {
    try {
      const res = await axios.get(IG_API, {
        params: { url: igUrl, apiKey: IG_KEY },
        timeout: 60000,
        validateStatus: () => true,
        transformResponse: d => d
      });
      const body = typeof res.data === "string" ? (() => { try { return JSON.parse(res.data); } catch (e) { return null; } })() : res.data;
      if (!body || body.success !== true || !Array.isArray(body.data) || !body.data.length) {
        const why = body && body.message ? body.message : !body ? "non-JSON response" : "no entries returned";
        throw new Error("attempt " + attempt + "/" + IG_ATTEMPTS + ": " + why);
      }
      // Keep only usable entries; an empty or non-http url must not take the others down with it.
      const usable = body.data.filter(d => d && typeof d.url === "string" && /^https?:\/\//i.test(d.url));
      if (!usable.length) throw new Error("attempt " + attempt + "/" + IG_ATTEMPTS + ": no usable media urls");
      return usable;
    } catch (err) {
      lastErr = err;
      if (attempt === IG_ATTEMPTS) break;
      await new Promise(r => setTimeout(r, 2500));
    }
  }
  throw new Error("instagram api failed after " + IG_ATTEMPTS + " attempts (" + (lastErr && lastErr.message) + ")");
};

smd({
  pattern: "insta",
  alias: ["instagram", "ig"],
  desc: "Download instagram reels and images.",
  category: "downloader",
  use: "<instagram url>",
  filename: __filename
}, async (ctx, text) => {
  try {
    const parts = ("" + (text ? text : ctx.reply_text)).split(" ")[0].trim();
    if (!parts || !/^https?:\/\/(www\.)?instagram\.com\//i.test(parts)) {
      return ctx.reply("*_Send an instagram post, reel or tv link_*\n\n" + prefix + "insta https://www.instagram.com/reel/xxxxxxx/");
    }
    const entries = await igFetch(parts);
    let sent = 0;
    for (const entry of entries) {
      const kind = igClassify(entry);
      try {
        await ctx.bot.sendMessage(ctx.chat, {
          [kind]: { url: entry.url },
          caption: sent === 0 ? "*HERE WE GO*\n" + parts : "",
          contextInfo: { ...(await ctx.bot.contextInfo(Config.botname, ctx.senderName)) }
        }, { quoted: ctx });
        sent++;
      } catch (err) {
        // One bad entry (expired token, unsupported size) must not stop the remaining ones.
        console.error("insta: skipping " + (entry.title || "entry") + " ->", err && err.message);
      }
    }
    if (!sent) throw new Error("every returned media url failed to send");
    if (entries.length > 1) await ctx.reply("*_Sent " + sent + " of " + entries.length + " items_*");
  } catch (err) {
    await ctx.error(err + "\n\ncommand : insta", err, "*_Could not download that instagram link._*");
  }
});
// Terabox downloader. Replaces .video, which was dead: ytdl-secktor cannot extract YouTube's
// player ("Could not extract functions"), its ruhend-scraper fallback needs `undici` (not
// installed), and youtubei.js@9.4.0 has no getInfo().
//
// The upstream accepts terabox.com and 1024terabox.com with an /s/ share path; teraboxapp.com and
// the /wap/share/link form are both rejected with "Invalid TeraBox URL".
const TB_API = "https://api.qasimdev.dpdns.org/api/terabox/download";
const TB_KEY = "qasim-dev";
const TB_ATTEMPTS = 3;

// Terabox shares hold anything - mp4, images, but also zip/rar/pdf - so everything found is sent and
// classified by extension, defaulting to document. Field names in the payload are undocumented, so
// walk the whole response instead of guessing a path.
const TB_VIDEO = /\.(mp4|m3u8|mov|m4v|webm|mkv|avi|flv)(\.|$)/i;
const TB_IMAGE = /\.(jpg|jpeg|png|webp|gif|bmp)(\.|$)/i;

const tbClassify = url => {
  const clean = String(url).split("?")[0];
  if (TB_VIDEO.test(clean)) return { kind: "video", mimetype: "video/mp4" };
  if (TB_IMAGE.test(clean)) return { kind: "image", mimetype: "image/jpeg" };
  return { kind: "document", mimetype: "application/octet-stream" };
};

const tbCollect = (node, out = []) => {
  if (Array.isArray(node)) {
    node.forEach(n => tbCollect(n, out));
  } else if (node && typeof node === "object") {
    Object.entries(node).forEach(([k, v]) => {
      if (/thumbnail|preview|avatar|icon|poster/i.test(k)) return;
      tbCollect(v, out);
    });
  } else if (typeof node === "string" && /^https?:\/\//i.test(node) && /\.[a-z0-9]{2,5}(\?|$)/i.test(node)) {
    if (!out.some(m => m.url === node)) out.push(Object.assign({ url: node }, tbClassify(node)));
  }
  return out;
};

const fetchTeraBox = async shareUrl => {
  let lastErr;
  for (let attempt = 1; attempt <= TB_ATTEMPTS; attempt++) {
    try {
      const res = await axios.get(TB_API, {
        params: { apiKey: TB_KEY, url: shareUrl },
        timeout: 90000,
        validateStatus: () => true,
        transformResponse: d => d
      });
      const text = String(res.data === undefined || res.data === null ? "" : res.data);
      // Cold cache returns a Varnish "503 first byte timeout" HTML page; the object still gets
      // cached on the way through, so retrying is what actually recovers it.
      if (!text.trim().startsWith("{")) throw new Error("attempt " + attempt + "/" + TB_ATTEMPTS + ": upstream not ready");
      const body = JSON.parse(text);
      if (body.success !== true) throw new Error(body.error || body.message || "request failed");
      const files = tbCollect(body);
      if (!files.length) throw new Error("no downloadable files in the response");
      return { files, data: body.data || {} };
    } catch (err) {
      lastErr = err;
      if (attempt === TB_ATTEMPTS) break;
      await new Promise(r => setTimeout(r, 5000));
    }
  }
  throw new Error("terabox api failed after " + TB_ATTEMPTS + " attempts (" + (lastErr && lastErr.message) + ")");
};

smd({
  pattern: "terabox",
  alias: ["tb", "tera"],
  desc: "Download files from a terabox share link.",
  category: "downloader",
  filename: __filename,
  use: "<terabox share url>"
}, async (ctx, text) => {
  try {
    const parts = ("" + (text ? text : ctx.reply_text)).split(" ")[0].trim();
    if (!/^https?:\/\/(?:(?:www|m)\.|\d+)?terabox\.com\/s\//i.test(parts)) {
      return ctx.reply("*_Send a terabox share link_*\n\n" + prefix + "terabox https://www.terabox.com/s/xxxxx");
    }
    const { files, data } = await fetchTeraBox(parts);
    const title = data.title || data.filename || "";
    let sent = 0;
    for (const file of files) {
      try {
        const name = String(file.url).split("?")[0].split("/").pop() || "terabox-file";
        await ctx.bot.sendMessage(ctx.chat, {
          [file.kind]: { url: file.url },
          caption: sent === 0 && title ? "*" + title + "*" : "",
          fileName: name,
          mimetype: file.mimetype,
          contextInfo: { ...(await ctx.bot.contextInfo(Config.botname, ctx.senderName)) }
        }, { quoted: ctx });
        sent++;
      } catch (err) {
        // One dead link must not stop the rest of the share.
        console.error("terabox: skipping file ->", err && err.message);
      }
    }
    if (!sent) throw new Error("every file url failed to send");
    if (files.length > 1) await ctx.reply("*_Sent " + sent + " of " + files.length + " files_*");
  } catch (err) {
    await ctx.error(err + "\n\ncommand: terabox", err, "*_Couldn't get those terabox files_*");
  }
});
// Twitter/X downloader. Replaces .video2, which was dead: youtubei.js@9.4.0 has no getInfo() and
// its ruhend-scraper fallback needs `undici`, which is not installed.
//
// The endpoint accepts x.com ONLY - every twitter.com variant returns "Invalid X (Twitter) URL" -
// so the URL is rewritten before it is sent, otherwise a perfectly good tweet link is rejected.
const TW_API = "https://api.qasimdev.dpdns.org/api/twitter/download";
const TW_KEY = "qasim-dev";
const TW_ATTEMPTS = 2;

// Media lives at an undeclared place in the payload (the no-media case is the only documented
// shape: { success, data:{ date, likes, replies, retweets, authorName, authorUsername, text } }).
// Rather than hardcode a guess, walk the whole response and collect every http(s) URL that ends in
// a media extension, whatever it is nested under. Videos are matched first so a mixed payload keeps
// the video ahead of its thumbnail.
const collectMedia = (node, out = []) => {
  if (Array.isArray(node)) {
    node.forEach(n => collectMedia(n, out));
  } else if (node && typeof node === "object") {
    // Skip avatar/icon fields, otherwise a media-less tweet posts the author's profile picture
    // as if it were the attachment.
    Object.entries(node).forEach(([k, v]) => {
      if (/profile|avatar|icon|banner/i.test(k)) return;
      collectMedia(v, out);
    });
  } else if (typeof node === "string" && /^https?:\/\//i.test(node)) {
    const clean = node.split("?")[0].toLowerCase();
    if (/profile_images|profile_image|avatar/i.test(clean)) return out;
    const isVideo = /\.(mp4|m3u8|mov|m4v|webm)(\.|$)/.test(clean);
    const isImage = /\.(jpg|jpeg|png|webp|gif)(\.|$)/.test(clean);
    if (isVideo || isImage) {
      if (!out.some(m => m.url === node)) out.push({ url: node, kind: isVideo ? "video" : "image" });
    }
  }
  return out;
};

const fetchTweet = async tweetUrl => {
  let lastErr;
  for (let attempt = 1; attempt <= TW_ATTEMPTS; attempt++) {
    try {
      const res = await axios.get(TW_API, {
        params: { apiKey: TW_KEY, url: tweetUrl },
        timeout: 60000,
        validateStatus: () => true,
        transformResponse: d => d
      });
      const text = String(res.data === undefined || res.data === null ? "" : res.data);
      if (!text.trim().startsWith("{")) throw new Error("attempt " + attempt + "/" + TW_ATTEMPTS + ": non-JSON response");
      const body = JSON.parse(text);
      if (body.success !== true) throw new Error(body.error || body.message || "request failed");
      const media = collectMedia(body).sort((a, b) => (a.kind === "video" ? -1 : 1) - (b.kind === "video" ? -1 : 1));
      if (!media.length) throw new Error("no media urls in the response");
      return { media, data: body.data || {} };
    } catch (err) {
      lastErr = err;
      if (attempt === TW_ATTEMPTS) break;
      await new Promise(r => setTimeout(r, 3000));
    }
  }
  throw new Error("twitter api failed after " + TW_ATTEMPTS + " attempts (" + (lastErr && lastErr.message) + ")");
};

smd({
  pattern: "xdown",
  alias: ["twitter", "twdown"],
  desc: "Download video or images from a tweet.",
  category: "downloader",
  filename: __filename,
  use: "<x.com/.../status/... link>"
}, async (ctx, text) => {
  try {
    const parts = ("" + (text ? text : ctx.reply_text)).split(" ")[0].trim();
    // Accept either host on input, but only ever send x.com upstream.
    const normalised = parts.replace(/^https?:\/\/(www\.|mobile\.)?twitter\.com/i, "https://x.com");
    if (!/^https?:\/\/(www\.)?x\.com\/[^/]+\/status\/\d+/i.test(normalised)) {
      return ctx.reply("*_Send a tweet link_*\n\n" + prefix + "twitter https://x.com/user/status/1234567890");
    }
    const { media, data } = await fetchTweet(normalised);
    const caption = (data.authorName ? "*" + data.authorName + "*\n" : "") + (data.text || "");
    let sent = 0;
    for (const item of media) {
      try {
        await ctx.bot.sendMessage(ctx.chat, {
          [item.kind]: { url: item.url },
          caption: sent === 0 ? caption : "",
          fileName: (data.authorUsername || "Suhail MD") + (item.kind === "video" ? ".mp4" : ".jpg"),
          mimetype: item.kind === "video" ? "video/mp4" : "image/jpeg",
          contextInfo: { ...(await ctx.bot.contextInfo(Config.botname, ctx.senderName)) }
        }, { quoted: ctx });
        sent++;
      } catch (err) {
        // One dead media url must not stop the rest of the tweet.
        console.error("twitter: skipping " + item.kind + " ->", err && err.message);
      }
    }
    if (!sent) throw new Error("every media url failed to send");
    if (media.length > 1) await ctx.reply("*_Sent " + sent + " of " + media.length + " items_*");
  } catch (err) {
    await ctx.error(err + "\n\ncommand: twitter", err, "*_Couldn't get that tweet media_*");
  }
});
