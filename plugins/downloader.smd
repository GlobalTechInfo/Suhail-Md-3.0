smd({
  pattern: "tgs",
  desc: "Downloads telegram stickers.",
  category: "downloader",
  filename: __filename,
  use: "<add sticker url.>"
}, async (ctx, text) => {
  try {
    if (!text) {
      return await ctx.reply("_Enter a tg sticker url_\nEg: .tgs https://t.me/addstickers/Oldboyfinal\nKeep in mind that there is a chance of ban if used frequently");
    }
    if (!text.includes("addstickers")) {
      return await ctx.reply("_Uhh Please Enter a Valid tg sticker url_\nEg: .tgs https://t.me/addstickers/Oldboyfinal");
    }
    let stickerUrl = text.split("|")[0];
    let packName = stickerUrl.split("/addstickers/")[1];
    let {
      result: stickers
    } = await fetchJson("https://api.telegram.org/bot891038791:AAHWB1dQd-vi0IbH2NjKYUk-hqQ8rQuzPD4/getStickerSet?name=" + encodeURIComponent(packName) + " ");
    let options = text.split("|")[1] || "";
    let infoText2 = "Total stickers: " + stickers.stickers.length + "\n*Estimated complete in:* " + stickers.stickers.length * 1.5 + " seconds\nKeep in mind that there is a chance of a ban if used frequently";
    if (stickers.is_animated) {
      return await ctx.reply("Animated stickers are not supported");
    } else if (options.startsWith("info")) {
      return await ctx.reply(infoText2);
    }
    let toIndex = parseInt(options.split(",")[0]) || 10;
    let fromIndex = parseInt(options.split(",")[1]) || 0;
    let packName2 = options.split(";")[1] || "Sticker";
    let isPhoto = true;
    if (packName2.includes("photo")) {
      isPhoto = false;
      packName2 = "Photo";
    }
    if (toIndex > stickers.stickers.length) {
      toIndex = stickers.stickers.length;
    }
    if (fromIndex > stickers.stickers.length) {
      fromIndex = stickers.stickers.length - 5;
    }
    if (fromIndex > toIndex) {
      let toIndex2 = toIndex;
      toIndex = fromIndex;
      fromIndex = toIndex2;
    }
    await ctx.reply(infoText2 + "\n\n_Downloading as " + packName2 + " From index *" + fromIndex + "* to *" + toIndex + "*._\nIf you wants more to download then use Like \n\n .tgs " + stickerUrl + " |  10 ,  20 ; photo");
    for (fromIndex; fromIndex < toIndex; fromIndex++) {
      let response = await fetchJson("https://api.telegram.org/bot891038791:AAHWB1dQd-vi0IbH2NjKYUk-hqQ8rQuzPD4/getFile?file_id=" + stickers.stickers[fromIndex].file_id);
      let fileUrl = "https://api.telegram.org/file/bot891038791:AAHWB1dQd-vi0IbH2NjKYUk-hqQ8rQuzPD4/" + response.result.file_path;
      if (isPhoto) {
        let buffer = await getBuffer(fileUrl);
        await ctx.reply(buffer, {
          packname: Config.packname,
          author: "Suhail-Md"
        }, "sticker");
      } else {
        await ctx.bot.sendMessage(ctx.chat, {
          image: {
            url: fileUrl
          },
          caption: "*_Telegram Sticker At Index " + (fromIndex + 1) + " Downloaded_*"
        });
      }
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: tgs", err, "*_Error Sending telegram stickers!!!_*");
  }
});
