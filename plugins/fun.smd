smd({
  cmdname: "question",
  info: "Random Question.",
  type: "fun",
  filename: __filename
}, async (ctx, input, {
  smd: smdHelper
}) => {
  try {
    await ctx.reply(await randomeFunfacts(smdHelper));
  } catch (err) {
    await ctx.error(err + "\n\ncommand: " + smdHelper, err);
  }
});
