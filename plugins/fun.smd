smd({
  cmdname: "define",
  info: "urban dictionary.",
  type: "fun",
  filename: __filename
}, async (ctx, input) => {
  try {
    let word = input ? input : ctx.reply_text;
    if (!word) {
      return await ctx.send("*_Hey " + ctx.senderName + ", please provide a text!_*");
    }
    let {
      data: dictionary
    } = await axios.get("http://api.urbandictionary.com/v0/define?term=" + word);
    var definitionText = dictionary ? "*Word:* ```" + word + "``` \n*Definition:* ```" + dictionary.list[0].definition.replace(/\[/g, "").replace(/\]/g, "") + "``` \n*Example:* ```" + dictionary.list[0].example.replace(/\[/g, "").replace(/\]/g, "") + "```" : "*_No results found for given word_*";
    return ctx.reply(definitionText);
  } catch (err) {
    await ctx.error(err + "\n\ncommand: define", err, "*No result for:* ```" + text + "```");
  }
});
