let Suhail_Md = "Suhail MD Whatsapp bot md";
const {
  groupdb,
  userdb,
  bot_,
  smd,
  jsonformat,
  sendWelcome,
  botpic,
  TelegraPh,
  RandomXP,
  Config,
  tlang,
  warndb,
  sleep,
  getAdmin,
  getBuffer,
  prefix,
  lidMap
} = require("../lib");
const fs = require("fs-extra");
const axios = require("axios");
const sᴜʜᴀɪʟ_ᴍᴅ = require("../lib/plugins");
const {
  count
} = require("discord-mongoose-economy/models/economy");
smd({
  pattern: "lydea",
  alias: ["chatbot"],
  desc: "activates and deactivates chatbot.\nuse buttons to toggle.",
  fromMe: true,
  category: "misc",
  filename: __filename
}, async (ctx, text, {
  cmdName: cmdName
}) => {
  try {
    let subCommand = text.split(" ")[0].toLowerCase().trim();
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || (await groupdb.new({
      id: ctx.chat
    }));
    // The fallback created the record in groupdb, so `.lydea all` then ran bot_.updateOne against a
    // bot_ record that never existed and the global setting never persisted. Create it in bot_.
    let botSettings = (await bot_.findOne({
      id: "bot_" + ctx.user
    })) || (await bot_.new({
      id: "bot_" + ctx.user
    })) || {
      chatbot: "false"
    };
    if (subCommand == "all" || subCommand === "global") {
      if (botSettings.chatbot == "true") {
        return await ctx.send("*" + cmdName + " was already enabled to all chat!.*");
      }
      await bot_.updateOne({
        id: "bot_" + ctx.user
      }, {
        chatbot: "true"
      });
      return await ctx.send("*" + cmdName + " successfully enabled to all chats!.*");
    } else if (subCommand.startsWith("on") || subCommand.startsWith("act") || subCommand.startsWith("enable")) {
      if (groupSettings.chatbot == "true" || botSettings.chatbot == "true") {
        return await ctx.send("*" + cmdName + " was already enabled.*");
      }
      await groupdb.updateOne({
        id: ctx.chat
      }, {
        chatbot: "true"
      });
      return await ctx.send("*" + cmdName + " activated successfully.*");
    } else if (subCommand.startsWith("off") || subCommand.startsWith("deact") || subCommand.startsWith("disable")) {
      if (groupSettings.chatbot == "false" && botSettings.chatbot == "false") {
        return await ctx.send("*" + cmdName + " was already disabled.*");
      }
      await bot_.updateOne({
        id: "bot_" + ctx.user
      }, {
        chatbot: "false"
      });
      await groupdb.updateOne({
        id: ctx.chat
      }, {
        chatbot: "false"
      });
      return await ctx.send("*" + cmdName + " deactivated successfully.*");
    } else {
      return await ctx.reply("*_" + cmdName + " Currently *" + (botSettings.chatbot == "true" ? "Enabled in 'all' Chats" : groupSettings.chatbot == "true" ? "Enabled in Chat" : "Disabled in Chat") + "!_*\n*_Use On/Off/all to enable/disable " + cmdName + "_*");
    }
  } catch (err) {
    ctx.error(err + "\n\ncommand: lydea(chatbot)", err);
  }
});
let warn = {};
warn.addwarn = async (jid, chat, message = {}) => {
  try {
    let user = (await userdb.findOne({
      id: jid
    })) || (await userdb.new({
      id: jid
    }));
    let warnByJid = user.warn || {};
    if (!warnByJid[chat]) {
      warnByJid[chat] = [];
    }
    var warnMap = {
      chat: "PRIVATE",
      reason: "Inapropriate Behaviour",
      date: new Date(),
      warnedby: tlang().title,
      ...message
    };
    warnByJid[chat].push(warnMap);
    user = await userdb.updateOne({
      id: jid
    }, {
      warn: warnByJid
    });
    return {
      status: true,
      warning: warnByJid[chat].length,
      user: user
    };
  } catch (err) {
    return {
      status: false,
      warning: 0,
      user: {},
      error: err
    };
  }
};
smd({
  pattern: "checkwarn",
  alias: ["listwarn", "chatwarn", "allwarn"],
  desc: "create paste of text.",
  category: "general",
  filename: __filename
}, async (ctx, text) => {
  try {
    let reason = "";
    let sender = ctx.sender;
    if (ctx.isCreator) {
      sender = ctx.reply_message ? ctx.reply_message.sender : ctx.mentionedJid[0] ? ctx.mentionedJid[0] : sender;
    }
    // .warn stores the record under the resolved phone jid, so resolve the lookup key the same
    // way or a LID-addressed target reads back as "no warnings".
    sender = lidMap.resolve(sender) || sender;
    let userSettings = (await userdb.findOne({
      id: sender
    })) || (await userdb.new({
      id: sender
    }));
    let warnData = userSettings.warn || false;
    // This used to be `shouldWarn = !warnData[ctx.chat]` - i.e. it only printed the warnings when
    // there were none, and said "User didn't have any warning yet!!" the moment one existed.
    let showAll = text === "all";
    if (!showAll) {
      warnData = warnData && warnData[ctx.chat] ? { [ctx.chat]: [...warnData[ctx.chat]] } : false;
    }
    if (!userSettings || !warnData || !Object.keys(warnData).length) {
      return await ctx.send("*_User didn't have any warning yet!!_*");
    }
    console.log("allwarn : ", warnData);
    for (const key in warnData) {
      let warnCount = warnData[key];
      reason += "\n╭─────────────◆\n│ *[ID] : " + (key.includes("@") ? (await ctx.bot.getName(key)) || key : key) + "*\n│ *[TOTAL WARNING] : " + warnData[key].length + "*\n┝─────────────◆\n";
      for (let i = 0; i < warnCount.length; i++) {
        reason += "┝── *WARNING " + (i + 1) + "* ──\n│  *DATE:* " + warnCount[i].date + " " + (warnCount[i].reason ? "  \n│  *REASON:* " + warnCount[i].reason : "") + "\n│  *WARNED BY:* " + warnCount[i].warnedby + "\n│  *CHAT:* " + warnCount[i].chat + "\n";
      }
      reason += "╰─────────────◆\n";
    }
    return await ctx.reply(reason ? reason : "*_User didn't have any warning yet!!_*");
  } catch (err) {
    await ctx.error(err + "\n\nCommand: chatwarn", err);
  }
});
smd({
  pattern: "warn",
  fromMe: true,
  desc: "warn a user!",
  category: "general",
  filename: __filename,
  use: " < USER >"
}, async (ctx, text) => {
  try {
    let sender = ctx.reply_message ? ctx.reply_message.sender : ctx.mentionedJid[0] ? ctx.mentionedJid[0] : false;
    if (!sender) {
      return await ctx.send("*_Uhh please, reply to a user!!_*");
    }
    // Mention-derived targets can be @lid while the warn record was written under the phone
    // jid; resolve so both paths hit the same record.
    sender = lidMap.resolve(sender) || sender;
    let userSettings = (await userdb.findOne({
      id: sender
    })) || (await userdb.new({
      id: sender
    }));
    let warnState = userSettings.warn || {};
    if (!warnState[ctx.chat]) {
      warnState[ctx.chat] = [];
    }
    var warnResult = {
      chat: ctx.isGroup ? ctx.metadata?.subject || "GROUP" : "PRIVATE CHAT",
      reason: text,
      date: ctx.date,
      warnedby: ctx.senderName
    };
    warnState[ctx.chat].push(warnResult);
    await userdb.updateOne({
      id: sender
    }, {
      warn: warnState
    });
    let warnLimit = parseInt(Config.warncount) || 3;
    if (warnState[ctx.chat].length > warnLimit && !ctx.checkBot(sender)) {
      if (ctx.isGroup) {
        if (ctx.isBotAdmin) {
          await ctx.send("*_Hey @" + sender.split("@")[0] + ", Kicking you from group!_*\n*_Because Your warn limit exceed!_*", {
            mentions: [sender]
          });
          await ctx.bot.groupParticipantsUpdate(ctx.chat, [sender], "remove");
        } else {
          return await ctx.send("*_Hey @" + sender.split("@")[0] + " Dont Spam, Your warn limit exceed!_*");
        }
      } else {
        await ctx.send("*_Hey @" + sender.split("@")[0] + ", Blocking you!_*\n*_Because Your warn limit exceed!_*", {
          mentions: [sender]
        });
        await ctx.bot.updateBlockStatus(sender, "block");
      }
    } else {
      return await ctx.send("*_Hey @" + sender.split("@")[0] + " warning added, Don't spam!_*", {
        mentions: [sender]
      });
    }
  } catch (err) {
    await ctx.error(err + "\n\nCommand: warn ", err, false);
  }
});
smd({
  pattern: "resetwarn",
  desc: "create paste of text.",
  category: "general",
  filename: __filename,
  use: " user "
}, async (ctx, text) => {
  try {
    if (!ctx.isCreator && !ctx.isAdmin) {
      return await ctx.reply(tlang().admin);
    }
    let sender = ctx.reply_message ? ctx.reply_message.sender : ctx.mentionedJid[0] ? ctx.mentionedJid[0] : false;
    if (!sender) {
      return await ctx.send("*_Uhh please, reply to a user!!_*");
    }
    let user = (await userdb.findOne({
      id: sender
    })) || (await userdb.new({
      id: sender
    })) || {};
    let userWarn = user.warn || {};
    if (ctx.isCreator && text.toLowerCase() === "all" && userWarn) {
      userWarn = {};
    } else {
      if (!user || !userWarn || !userWarn[ctx.chat]) {
        return await ctx.send("*_User didn't have any warning yet!!_*");
      }
      delete userWarn[ctx.chat];
    }
    await userdb.updateOne({
      id: sender
    }, {
      warn: userWarn
    });
    await ctx.reply("*User is free as a bird now!*\n*All warns has been deleted!*");
  } catch (err) {
    await ctx.error(err + "\n\nCommand: resetwarn", err);
  }
});
smd({
  pattern: "act",
  alias: ["activate", "active"],
  desc: "Switches for varios works.",
  category: "moderation",
  filename: __filename
}, async (ctx, text) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    const botNumber = ctx.botNumber;
    const isAdmin = ctx.isAdmin;
    let cmdName = text?.split(" ")[0].toLowerCase()?.trim() || false;
    if (!isAdmin && !ctx.isCreator) {
      return ctx.reply(tlang().admin);
    }
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || (await groupdb.new({
      id: ctx.chat
    })) || false;
    if (!groupSettings) {
      return await ctx.reply("*_Uhh dear, Group not found in Databse!_*");
    }
    switch (cmdName) {
      case "antilink":
        {
          if (groupSettings.antilink !== "false") {
            return await ctx.reply("*_Antilink was alredy enabled here!_*");
          }
          await groupdb.updateOne({
            id: ctx.chat
          }, {
            antilink: "warn"
          });
          await ctx.reply("*_Enabled antilink in current chat.!_*");
        }
        break;
      case "economy":
        {
          if (groupSettings.economy == "true") {
            return await ctx.reply("*_Economy was alredy enabled.!_*");
          }
          await groupdb.updateOne({
            id: ctx.chat
          }, {
            economy: "true"
          });
          await ctx.reply("*_Economy enabled in current chat.!_*");
        }
        break;
      case "events":
      case "event":
        {
          await groupdb.updateOne({
            id: ctx.chat
          }, {
            welcome: "true",
            goodbye: "true"
          });
          return await ctx.reply("*Successfully Enabled Events!*");
        }
        break;
      case "nsfw":
        {
          if (groupSettings.nsfw == "true") {
            return await ctx.reply("*_NSFW is already enabled!_*");
          }
          await groupdb.updateOne({
            id: ctx.chat
          }, {
            nsfw: "true"
          });
          await ctx.reply("*_Successfully Enabled NSFW_*");
        }
        break;
      case "bot":
        {
          if (groupSettings.botenable == "true") {
            return await ctx.reply("*_bot is already enabled!_*");
          }
          await groupdb.updateOne({
            id: ctx.chat
          }, {
            botenable: "true"
          });
          await ctx.reply("*_Successfully Enabled bot_*");
        }
        break;
      default:
        {
          ctx.reply("Please provide me term like.\n1-events\n2-antilink\n3-nsfw\n4-economy\n5-bot");
        }
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: act", err);
  }
});
smd({
  pattern: "deact",
  alias: ["deactive", "deactivate"],
  desc: "Switches for varios works.",
  category: "moderation",
  filename: __filename
}, async (ctx, text) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    const botNumber = ctx.botNumber;
    const isAdmin = ctx.isAdmin;
    let cmdName = text?.split(" ")[0].toLowerCase()?.trim() || false;
    if (!cmdName) {
      return ctx.reply("❌ Please provide me term like like\n1-events\n2-antilink\n3-nsfw\n4-bot\n5-economy");
    }
    if (!isAdmin && !ctx.isCreator) {
      return ctx.reply(tlang().admin);
    }
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || (await groupdb.new({
      id: ctx.chat
    })) || false;
    if (!groupSettings) {
      return await ctx.reply("*_Uhh dear, request not be proceed due to error!_*");
    }
    switch (cmdName) {
      case "antilink":
        {
          if (groupSettings.antilink == "false") {
            return ctx.reply("*_Antilink was alredy disabled_*");
          }
          await groupdb.updateOne({
            id: ctx.chat
          }, {
            antilink: "false"
          });
          ctx.reply("*_disabled antilink in current chat!_*");
        }
        break;
      case "economy":
        {
          if (groupSettings.economy == "false") {
            return ctx.reply("*_Economy was alredy disabled!_*");
          }
          await groupdb.updateOne({
            id: ctx.chat
          }, {
            economy: "false"
          });
          ctx.reply("*disabled Economy in current chat.*");
        }
        break;
      case "events":
      case "event":
        {
          if (groupSettings.events == "false") {
            return ctx.reply("*_Events are already disabled!_*");
          }
          await groupdb.updateOne({
            id: ctx.chat
          }, {
            welcome: "false",
            goodbye: "false"
          });
          return ctx.reply("*Successfully disabled Events!*");
        }
        break;
      case "nsfw":
        {
          if (groupSettings.nsfw == "false") {
            return ctx.reply("*_NSFW is already disabled!_*");
          }
          await groupdb.updateOne({
            id: ctx.chat
          }, {
            nsfw: "false"
          });
          ctx.reply("*Successfully disabled NSFW*");
        }
        break;
      case "bot":
        {
          if (groupSettings.botenable == "false") {
            return await ctx.reply("*_bot is already disabled!_*");
          }
          await groupdb.updateOne({
            id: ctx.chat
          }, {
            botenable: "true"
          });
          await ctx.reply("*_Successfully disabled bot_*");
        }
        break;
      default:
        {
          ctx.reply("Please provide me term like.\n1-events\n2-antilink\n3-nsfw\n4-bot\n5-economy");
        }
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand: deact", err);
  }
});
smd({
  pattern: "bot",
  desc: "activates and deactivates bot.\nuse buttons to toggle.",
  fromMe: true,
  category: "misc",
  filename: __filename
}, async (ctx, text) => {
  try {
    let toggle = text ? text.toLowerCase().trim() : false;
    let cmdName = toggle ? toggle.split(" ")[0] : false;
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || (await groupdb.new({
      id: ctx.chat
    }));
    if (!cmdName) {
      await ctx.send("*_Bot *" + (groupSettings.botenable === "true" ? "Enabled" : "Disabled") + " in this Chat!_*");
    } else if (cmdName.startsWith("off") || cmdName.startsWith("deact") || cmdName.startsWith("disable")) {
      if (groupSettings.botenable === "false") {
        await ctx.send("*_Bot already disabled in current Chat!!_*");
      } else {
        await groupdb.updateOne({
          id: ctx.chat
        }, {
          botenable: "false"
        });
        await ctx.send("*_Bot Disabled Succesfully!_*");
      }
    } else if (cmdName.startsWith("on") || cmdName.startsWith("act") || cmdName.startsWith("enable")) {
      if (groupSettings.botenable === "true") {
        await ctx.send("*_Bot already enabled in current Chat!!_*");
      } else {
        await groupdb.updateOne({
          id: ctx.chat
        }, {
          botenable: "true"
        });
        await ctx.send("*_Bot Succesfully Enabled!_*");
      }
    } else {
      await ctx.send("*_Provide Valid Instruction_*\n*Ex: _" + prefix + "bot on/off_*");
    }
  } catch (err) {
    ctx.error(err + "\n\ncommand: bot", err);
  }
});
smd({
  pattern: "antitag",
  desc: "detect tagall in group chat, then kick them",
  fromMe: true,
  category: "misc",
  filename: __filename
}, async (ctx, text) => {
  try {
    let toggle = text ? text.toLowerCase().trim() : false;
    let cmdName = toggle ? toggle.split(" ")[0] : false;
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || (await groupdb.new({
      id: ctx.chat
    }));
    if (!cmdName) {
      // Only "true" counts as on - the runtime check is `antitag == "true"`, so an unset record
      // used to be reported as "Enabled" while antitag was in fact off.
      await ctx.send("*_Anti_tag *" + (groupSettings.antitag === "true" ? "Enabled" : "Disabled") + " in this Chat!_*");
    } else if (cmdName.startsWith("off") || cmdName.startsWith("deact") || cmdName.startsWith("disable")) {
      if (groupSettings.antitag === "false") {
        await ctx.send("*_Anti_tag already disabled in current Chat!!_*");
      } else {
        await groupdb.updateOne({
          id: ctx.chat
        }, {
          antitag: "false"
        });
        await ctx.send("*_Anti_tag Disabled Succesfully!_*");
      }
    } else if (cmdName.startsWith("on") || cmdName.startsWith("act") || cmdName.startsWith("enable")) {
      if (groupSettings.antitag === "true") {
        await ctx.send("*_Anti_tag already enabled in current Chat!!_*");
      } else {
        await groupdb.updateOne({
          id: ctx.chat
        }, {
          antitag: "true"
        });
        await ctx.send("*_Anti_tag succesfully enabled in chat!_*\n*_Now bot kick user who tag all members!_*");
      }
    } else {
      await ctx.send("*_Provide Valid Instruction_*\n*Ex: _" + prefix + "antitag on/off_*");
    }
  } catch (err) {
    ctx.error(err + "\n\ncommand: antitag", err);
  }
});
smd({
  pattern: "antilink",
  desc: "activates and deactivates antilink.\nuse buttons to toggle.",
  category: "group",
  filename: __filename
}, async (ctx, text, {
  smd: smdHelper
}) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    if (!ctx.isAdmin && !ctx.isCreator) {
      return ctx.reply(tlang().admin);
    }
    let toggle = text ? text.toLowerCase().trim() : false;
    let cmdName = toggle ? toggle.split(" ")[0] : false;
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || (await groupdb.new({
      id: ctx.chat
    }));
    if (!cmdName) {
      return await ctx.send("*_Antilink " + (groupSettings.antilink === "false" ? "Disabled" : "Enabled") + " in this Group!_* \n" + (groupSettings.antilink === "false" ? "" : "*Current Mode:* _" + groupSettings.antilink + "_") + "\n\n*Antilink Modes:* ```\n" + (prefix + smdHelper) + " kick (Delete Links & Kick Senders)\n" + (prefix + smdHelper) + " delete (Delete Links Only)\n" + (prefix + smdHelper) + " warn (warn & delete links)\n" + (prefix + smdHelper) + " off (Disable Antilink in chat) ```\n\n\n" + Config.caption);
    } else if (cmdName.startsWith("off") || cmdName.startsWith("deact") || cmdName.startsWith("disable")) {
      if (groupSettings.antilink === "false") {
        return await ctx.send("*_Anti_Link already disabled in current Chat!!_*");
      }
      await groupdb.updateOne({
        id: ctx.chat
      }, {
        antilink: "false"
      });
      return await ctx.send("*_Anti_Link Disabled Succesfully!_*");
    } else if (cmdName.startsWith("kick")) {
      if (groupSettings.antilink === "kick") {
        return await ctx.send("*_Anti_Link already set to kick link senders!!_*");
      }
      await groupdb.updateOne({
        id: ctx.chat
      }, {
        antilink: "kick"
      });
      return await ctx.send("*_Anti_Link Succesfully set to kick link senders!_*");
    } else if (cmdName.startsWith("delete")) {
      if (groupSettings.antilink === "delete") {
        return await ctx.send("*_Anti_Link already set to delete links!!_*");
      }
      await groupdb.updateOne({
        id: ctx.chat
      }, {
        antilink: "delete"
      });
      return await ctx.send("*_Anti_Link Succesfully set to delete links from chat!_*");
    } else if (cmdName.startsWith("warn")) {
      if (groupSettings.antilink === "warn") {
        return await ctx.send("*_Anti_Link already set to warn link senders!!_*");
      }
      await groupdb.updateOne({
        id: ctx.chat
      }, {
        antilink: "warn"
      });
      return await ctx.send("*_Anti_Link set to warn and delete links!_*");
    } else {
