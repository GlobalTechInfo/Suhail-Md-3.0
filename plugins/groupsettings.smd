smd({
  pattern: "amute",
  desc: "sets auto mute time in group.",
  category: "moderation"
}, async (ctx, text) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    if (!ctx.isAdmin && !ctx.isCreator) {
      return ctx.reply(tlang().admin);
    }
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || (await groupdb.new({
      id: ctx.chat
    }));
    if (!text) {
      return await ctx.reply("*Auto_Mute *" + (groupSettings.mute === "false" ? "disable" : "enabled") + " for current group*" + (groupSettings.mute !== "false" ? "\n *Auto mute status set at : " + groupSettings.mute + "* " : ""));
    }
    let [fromHour, toHour] = text.split(":").map(Number);
    if (isNaN(fromHour) || isNaN(toHour) || fromHour < 0 || fromHour >= 24 || toHour < 0 || toHour >= 60) {
      return ctx.reply("Please provide correct form.\nEg: " + prefix + "amute 22:00");
    }
    let hourRange = fromHour.toString().padStart(2, "0") + ":" + toHour.toString().padStart(2, "0");
    await groupdb.updateOne({
      id: ctx.chat
    }, {
      mute: hourRange
    });
    return ctx.reply("*_Successfully done, Group auto mute at " + hourRange + "_*");
  } catch (err) {
    ctx.error(err + "\n\ncommand: amute", err);
  }
});
