    }
    await groupdb.updateOne({
      id: ctx.chat
    }, {
      welcometext: text,
      welcome: "true"
    });
    await sendWelcome(ctx, text);
  } catch (err) {
    ctx.error(err + "\n\ncommand: setwelcome", err);
  }
});
