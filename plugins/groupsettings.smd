smd({
  pattern: "dmute",
  desc: "Delete mute from group.",
  category: "moderation"
}, async (ctx, text) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    if (!ctx.isAdmin && !ctx.isCreator) {
      return ctx.reply(tlang().admin);
    }
    let groupSettings = await groupdb.findOne({
      id: ctx.chat
    });
    if (!groupSettings || !groupSettings.mute || groupSettings.mute == "false") {
      return await ctx.reply("*There's no auto mute set in group.*");
    }
    await groupdb.updateOne({
      id: ctx.chat
    }, {
      mute: "false"
    });
    return await ctx.reply("*Auto mute deleted successfully.*");
  } catch (err) {
    ctx.error(err + "\n\ncommand: dmute", err);
  }
});
async function haveEqualMembers(admins, participants) {
  if (admins.length === 0 || participants.length === 0) {
    return false;
  }
  // One side is group-metadata ids (which are @lid in LID-era groups) and the other is
  // mention-derived jids. Comparing the raw strings found no overlap, so antitag never fired.
  // Compare on the resolved phone number instead.
  const norm = list => [...new Set((list || []).map(j => lidMap.numberOf(j)).filter(Boolean))];
  const wanted = norm(participants);
  const sharedAdmins = norm(admins).filter(item => wanted.includes(item));
  const matchPercent = sharedAdmins.length / norm(admins).length * 100;
  return matchPercent >= 80;
}
smd({
  pattern: "antiword",
  desc: "Detects words from chat,and delete/warn senders.",
  category: "group",
  filename: __filename,
  use: "< action | words >"
}, async (ctx, text, {
  cmdName: cmdName
}) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    if (!ctx.isAdmin && !ctx.isCreator) {
      return ctx.reply(tlang().admin);
    }
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || (await groupdb.new({
      id: ctx.chat,
      antiword: {
        status: "false",
        words: ""
      }
    }));
    let toggle = text ? text.toLowerCase().trim() : false;
    let antiword = groupSettings.antiword;
    let antiwordStatus = "*Antiword Currently *" + (antiword.status !== "false" ? "enabled" : "disabled") + "!!!* ```\n  STATUS: " + (antiword.status ? antiword.status : "--Empty Yet--") + " \n  WORDS: " + (antiword.words ? antiword.words.replace(/,/gi, " -- ") : "--Empty Yet--") + "```\n\n*Available Cmds:* ```\n  " + (prefix + cmdName) + " off \n  " + (prefix + cmdName) + " reset\n  " + (prefix + cmdName) + " warn | bad,words\n  " + (prefix + cmdName) + " delete | hot,badas\n``` \n\n\n " + Config.caption;
    if (!toggle || !text) {
      return await ctx.send(antiwordStatus);
    }
    let antiwordValue = toggle.split("|")[1] || "";
    let antiwordEnabled = toggle.startsWith("on") || toggle.startsWith("act") || toggle.startsWith("enable") || toggle.startsWith("del") ? "delete" : toggle.startsWith("warn") ? "warn" : toggle.startsWith("off") || toggle.startsWith("deact") || toggle.startsWith("disable") ? "false" : toggle.startsWith("reset") ? "reset" : "";
    antiwordEnabled = !antiwordEnabled && antiwordValue && antiword.status !== "false" ? antiword.status : antiwordEnabled;
    if (antiwordEnabled === "reset") {
      await groupdb.updateOne({
        id: ctx.chat
      }, {
        antiword: {}
      });
      return await ctx.send("*_Anti_Word status cleard!_*");
    } else if (antiwordEnabled === "delete" || antiwordEnabled === "warn") {
      if (antiword.status == antiwordEnabled && !antiwordValue) {
        return await ctx.send("*Please provide badWords, like " + (prefix + cmdName) + " " + antiwordEnabled + " | bad,words");
      }
      antiwordValue = antiwordValue ? antiwordValue : antiword.words;
      await groupdb.updateOne({
        id: ctx.chat
      }, {
        antiword: {
          status: antiwordEnabled,
          words: antiwordValue
        }
      });
      return await ctx.send("*_Anti_Word succesfully set to '" + antiwordEnabled + "' badward!_*\n*Antiwords are:```" + (antiwordValue ? antiwordValue.replace(/,/gi, " | ") : "--Empty Yet--") + "``` *");
    } else if (antiwordEnabled === "false") {
      if (antiword.status === antiwordEnabled) {
        return await ctx.send("*Anti_Word Already Disabled In Current Chat!*");
      }
      await groupdb.updateOne({
        id: ctx.chat
      }, {
        antiword: {
          status: "false",
          words: antiword.words
        }
      });
      return await ctx.send("*Anti_Word Disable Succesfully!*");
    } else {
      return await ctx.reply("*Uhh dear, Please follow instructions!!*\n\n" + antiwordStatus);
    }
  } catch (err) {
    ctx.error(err + "\n\ncommand: antiword", err);
  }
});
let bott = false;
let chatbotCount = 0;
smd({
  on: "main"
}, async (ctx, text, {
  botNumber: botNumber,
  isCreator: isCreator,
  budy: budy,
  body: body,
  icmd: icmd
}) => {
  try {
    if (Config.MsgsInLog === "true") {
      console.log("" + (ctx.isGroup ? "[MESSAGE IN GROUP] From => " + ctx.metadata.subject + "\n[USER]:" : "[MESSAGE IN PRIVATE] From =>") + (" " + ctx.senderName + " " + ctx.senderNum + "\n[" + ctx.mtype.toUpperCase() + "]: " + ctx.body + "\n============== [SMD] ================="));
    }
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || false;
    let isGroupAdmin = false;
    try {
      if (!global.SmdOfficial && global.SmdOfficial !== "yes") {
        return;
      }
      if (groupSettings && groupSettings.antitag == "true" && !ctx.checkBot() && ctx.mtype !== "reactionMessage" && groupSettings.botenable == "true") {
        const hasSameAdmins = await haveEqualMembers(ctx.metadata.participants.map(item => item.id), ctx.mentionedJid);
        if (hasSameAdmins && ctx.isBotAdmin) {
          let prompt = {
            reason: "tagging all members!",
            chat: ctx.metadata?.subject || "GROUP",
            warnedby: tlang().title,
            date: ctx.date
          };
          isGroupAdmin = await warn.addwarn(ctx.sender, ctx.chat, prompt);
          await ctx.reply("*_[TAG DETECTED] Hey @" + ctx.senderNum + " warning!!_*\n*_Tagging all members is not allowed!_*", {
            mentions: [ctx.sender]
          });
          await ctx.delete();
        } else if (hasSameAdmins && !ctx.isBotAdmin) {
          await ctx.reply("*_[TAGALL DETECTED] Can't do anything, without getting admin role!_*", {
            mentions: [ctx.sender]
          });
        }
      }
      if (groupSettings && ctx.isGroup && !ctx.isAdmin && !isCreator && ctx.mtype !== "reactionMessage" && groupSettings.botenable == "true") {
        if (groupSettings.antibot && groupSettings.antibot !== "false" && ctx.isBot && !ctx.checkBot(ctx.sender)) {
          if (ctx.isBotAdmin) {
            var errorText = "*_Bot user not allowed, please make it private!_*";
            if (groupSettings.antibot === "warn") {
              let prompt = {
                reason: "Bots not allowed!",
                chat: ctx.metadata?.subject || "GROUP",
                date: ctx.date
              };
              isGroupAdmin = isGroupAdmin ? isGroupAdmin : await warn.addwarn(ctx.sender, ctx.chat, prompt);
              if (isGroupAdmin.status) {
                errorText = "*_Hey @" + ctx.senderNum + " warning, Due To Antibot!_*";
              }
            } else if (groupSettings.antibot === "kick") {
              try {
                sleep(1000);
                await ctx.bot.groupParticipantsUpdate(ctx.chat, [ctx.sender], "remove");
                errorText = "*_User @" + ctx.senderNum + " kick Due To Antibot!_*";
              } catch {}
            }
            await ctx.delete();
            await ctx.send(errorText, {
              mentions: [ctx.sender]
            });
          } else if (!ctx.isBotAdmin && ctx.isBot) {
            await ctx.reply("*_Uhh Please, Provide Admin Role To Kick Other Bot_*\n*_Or Disable Antibot (On/Off) In Current Group_*");
          }
        }
        if (groupSettings.onlyadmin && groupSettings.onlyadmin === "true" && SmdOfficial == "yes") {
          var errorText = "";
          if (ctx.isBotAdmin) {
            let replyText = {
              reason: "Only Admin can Chat!",
              chat: ctx.metadata?.subject || "PRIVATE",
              warnedby: tlang().title,
              date: ctx.date
            };
            isGroupAdmin = isGroupAdmin ? isGroupAdmin : await warn.addwarn(ctx.sender, ctx.chat, replyText);
            if (isGroupAdmin.status) {
              errorText = "*Warns you for chat here!*\n";
            }
            await ctx.delete();
            sleep(1500);
            await ctx.send("*Hey @" + ctx.senderNum + "* " + errorText + "*Deleteing message,while onlyadmin activated!!* ", {
              mentions: [ctx.sender]
            });
          } else {
            await ctx.send("*_Provide admin role to kick Message Senders_*\n*Or _Disable onlyadmin(on/off) in currentchat_*");
          }
        }
        if (groupSettings.antilink && groupSettings.antilink !== "false" && SmdOfficial === "yes") {
          const antilinkValues = Config.antilink_values && Config.antilink_values !== "all" ? Config.antilink_values.split(",").filter(item => item.trim() !== "") : ["https://", "chat.whatsapp.com", "fb.com"];
          let wordLower = body.toLowerCase();
          if (antilinkValues.some(item => wordLower.includes(item))) {
            if (!ctx.isBotAdmin) {
              let linkNotice = " *[LINK DETECTED]*\nUser @" + ctx.sender.split("@")[0] + " detected sending a link.\nPromote " + Config.botname + " as admin to " + (groupSettings.antilink === "kick" ? "kick \nlink senders." : "delete \nlinks from this Chat") + " \n";
              await ctx.send(linkNotice, {
                mentions: [ctx.sender]
              });
            } else if (groupSettings.antilink === "delete") {
              await ctx.send("*_Link Detected.. Deletion Done!_*");
              await ctx.delete();
            } else if (groupSettings.antilink === "warn" || groupSettings.antilink === "true") {
              let replyText = {
                reason: "links not allowed!",
                chat: ctx.metadata?.subject || "PRIVATE",
                warnedby: tlang().title,
                date: ctx.date
              };
              isGroupAdmin = isGroupAdmin ? isGroupAdmin : await warn.addwarn(ctx.sender, ctx.chat, replyText);
              var errorText = isGroupAdmin.status ? "*_[LINK DETECTED] Hey @" + ctx.senderNum + " warning!!_*\n*_links not allowed in current group!_*" : "*_[LINK DETECTED]!_*";
              await ctx.reply(errorText, {
                mentions: [ctx.sender]
              });
              await ctx.delete();
            } else if (groupSettings.antilink === "kick") {
              await ctx.send("*_Link Detected!!_*");
              try {
                await ctx.delete();
                await sleep(1500);
                await ctx.bot.groupParticipantsUpdate(ctx.chat, [ctx.sender], "remove");
              } catch {
                await ctx.send("*Link Detected*\n" + tlang().botAdmin);
              }
            }
          }
        }
      }
    } catch (err) {
      console.log("Error From Antilinks : ", err);
    }
    var antiwordSettings = groupSettings?.antiword || {
      status: "false"
    };
    if (text.length > 1 && !ctx.isBot && antiwordSettings && antiwordSettings.status !== "false" && antiwordSettings.words) {
      var words = antiwordSettings.words.split(",") || [];
      let isOwner = false;
      words.map(async item => {
        if (ctx.isAdmin || !global.SmdOfficial || global.SmdOfficial != "yes") {
          return;
        }
        let wordPattern = new RegExp("\\b" + item?.trim() + "\\b", "ig");
        let word = budy.toLowerCase();
        if (!isOwner && item && wordPattern.test(word)) {
          isOwner = true;
          await sleep(500);
          try {
            var badWord = "";
            if (antiwordSettings.status === "warn") {
              let warnFlag = {
                reason: "For using Bad Word",
                chat: ctx.metadata?.subject || "PRIVATE",
                warnedby: tlang().title,
                date: ctx.date
              };
              isGroupAdmin = isGroupAdmin ? isGroupAdmin : await warn.addwarn(ctx.sender, ctx.chat, warnFlag);
              if (isGroupAdmin.status) {
                badWord = "\n*Warns you for using badWord!!*\n";
              }
            }
            if (ctx.isBotAdmin) {
              await ctx.send("*[BAD WORD DETECTED] Hey @" + ctx.senderNum + "* " + badWord + "*Deleting your message from chat!*\n", {
                mentions: [ctx.sender]
              }, "suhail", ctx);
              await ctx.delete();
            } else {
              await ctx.reply("*_[BAD WORD DETECTED] provide admin to take action!_*", {
                mentions: [ctx.sender]
              });
            }
          } catch (err) {
            console.log("Error From Bad Words : ", err);
          }
        }
      });
    }
    if (isGroupAdmin) {
      let warnLimit = parseInt(Config.warncount) || 3;
      if (isGroupAdmin.warning >= warnLimit) {
        if (ctx.isGroup) {
          if (ctx.isBotAdmin) {
            await ctx.send("*_Hey @" + ctx.senderNum + " Kicking you from group!_*\n*_Because Your warn limit exceed!_*", {
              mentions: [ctx.sender]
            });
            await ctx.bot.groupParticipantsUpdate(ctx.chat, [ctx.sender], "remove");
          }
        } else {
          await ctx.send("*_Hey @" + ctx.senderNum + " Blocking you!_*\n*_Because Your warn limit exceed!_*", {
            mentions: [ctx.sender]
          });
          await ctx.bot.updateBlockStatus(ctx.sender, "block");
        }
      }
    }
    try {
      if (!global.SmdOfficial || ctx.mtype == "reactionMessage") {
        return;
      }
      let chatbotSettings = (await groupdb.findOne({
        id: ctx.chat
      })) || {
        chatbot: "false"
      };
      if (!bott || chatbotCount >= 10) {
        bott = (await bot_.findOne({
          id: "bot_" + ctx.user
        })) || {
          chatbot: "false"
        };
      } else {
        chatbotCount++;
      }
      let chatbot = bott && bott.chatbot && bott.chatbot == "true" ? "true" : chatbotSettings.chatbot || "false";
      if (chatbot === "true" && !icmd && !ctx.isBot && ctx.text) {
        let target = !ctx.isGroup ? ctx.user : ctx.quoted ? ctx.quoted.sender : ctx.mentionedJid[0] || false;
        if (ctx.isGroup && target && !ctx.checkBot(target)) {
          return;
        }
        let {
          data: cnt
        } = await axios.get("http://api.brainshop.ai/get?bid=175685&key=Pg8Wu8mrDQjfr0uv&uid=[" + ctx.senderNum + "]&msg=[" + budy + "]");
        if (cnt && cnt.cnt) {
          ctx.send(cnt.cnt, {}, "suhail", ctx);
        } else {
          "";
        }
      }
    } catch (err) {
      console.log("Error From ChatBot : ", err);
    }
  } catch (err) {
    console.log("Group Settings error in command.main() \n", err);
  }
});
let users = {};
let user_warns = {};
smd({
  group: "add"
}, async (ctx, {
  Void: unused
}) => {
  try {
    let groupSettings = await groupdb.findOne({
      id: ctx.chat
    });
    if (!groupSettings || !ctx.isGroup || groupSettings.botenable !== "true" || ctx.blockJid || ctx.fromMe) {
      return;
    }
    let welcome = groupSettings && groupSettings.welcome ? groupSettings.welcome : "false";
    let antifake = groupSettings && groupSettings.antifake ? groupSettings.antifake.toLowerCase() : "false";
    let blockedNumbers = antifake.split(",");
    const isBlocked = blockedNumbers.some(item => ctx.user.startsWith(item));
    if (antifake !== "false" && !isBlocked && !ctx.isCreator) {
      if (ctx.isBotAdmin) {
        try {
          await ctx.kick();
          return await sendWelcome(ctx, "*[ANTIFAKE START] @User kicked automaticaly!* @pp");
        } catch (err) {
          await ctx.error(" Can't kick user in antifake\n❲❒❳ GROUP: " + ctx.metadata.subject + "\n❲❒❳ ERROR: " + err + "\n", err, false);
        }
      } else {
        await ctx.send("*[ANTI_FAKE ERROR] Need admin role to kick fake users!!*");
      }
    } else if (welcome === "true") {
      await sendWelcome(ctx, groupSettings.welcometext);
    }
  } catch (err) {
    console.log("Error From Welcome : ", err);
  }
});
smd({
  group: "remove"
}, async (ctx, {
  Void: unused
}) => {
  try {
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || false;
    if (!ctx || !groupSettings || !ctx.isGroup || groupSettings.botenable !== "true" || ctx.blockJid || ctx.fromMe) {
      return;
    }
    let goodbye = groupSettings && groupSettings.goodbye ? groupSettings.goodbye : "false";
    if (goodbye === "true") {
      await sendWelcome(ctx, groupSettings.goodbyetext);
    }
  } catch (err) {
    console.log("Error From Goodbye : ", err);
  }
});
smd({
  group: "promote"
}, async (ctx, {
  Void: unused
}) => {
  try {
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || false;
    if (!groupSettings || !ctx.isGroup || groupSettings.botenable !== "true" || ctx.blockJid) {
      return;
    }
    if (!user_warns[ctx.sender]) {
      user_warns[ctx.sender] = {
        [ctx.action]: 1
      };
    } else {
      user_warns[ctx.sender][ctx.action]++;
    }
    let isGroupAdmin;
    if (groupSettings.antipromote == "true" && !ctx.isCreator) {
      isGroupAdmin = ctx.isBotAdmin ? false : true;
      if (users[ctx.sender] && users[ctx.sender].previous_Action === "antidemote") {
        delete users[ctx.sender];
        return;
      }
      if (ctx.isBotAdmin) {
        try {
          await ctx.demote();
          users[ctx.sender] = {
            previous_Action: "antipromote"
          };
          if (user_warns[ctx.sender][ctx.action] > 2) {
            return;
          }
          return await sendWelcome(ctx, "*[ANTIPROMOTE START] @User Demoted Automatically!* @pp ");
        } catch (err) {
          await ctx.error(" Can't demote user in antipromote\n❲❒❳ GROUP: " + ctx.metadata.subject + "\n❲❒❳ ERROR: " + err + "\n", err, false);
        }
      }
    }
    if (groupSettings.pdm == "true" || isGroupAdmin) {
      if (user_warns[ctx.sender][ctx.action] > 2) {
        return;
      }
      var promoteNotice = " *[SOMEONE PROMOTE HERE]*\n" + (isGroupAdmin ? "*Note : _I'm Not Admin Here, So I Can't Demote Someone while Anti_Promote Activated_*" : "") + "\n           \n  ❲❒❳ *User:* _@user_\n❲❒❳ *Position:* _Member -> Admin_ @pp\n  ❲❒❳ *Total Members:* _@count_Members_\n❲❒❳ *Group Name:* @gname\n\n\n" + Config.caption;
      return await sendWelcome(ctx, promoteNotice);
    }
  } catch (err) {
    console.log("Error From Promote : ", err);
  }
});
smd({
  group: "demote"
}, async (ctx, {
  Void: unused
}) => {
  try {
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || false;
    if (!groupSettings || !ctx.isGroup || groupSettings.botenable !== "true" || ctx.blockJid) {
      return;
    }
    if (!user_warns[ctx.sender]) {
      user_warns[ctx.sender] = {
        [ctx.action]: 1
      };
    } else {
      user_warns[ctx.sender][ctx.action]++;
    }
    let isGroupAdmin;
    if (groupSettings.antidemote == "true" && !ctx.isCreator) {
      isGroupAdmin = ctx.isBotAdmin ? false : true;
      if (users[ctx.sender] && users[ctx.sender].previous_Action === "antipromote") {
        delete users[ctx.sender];
        return;
      }
      if (ctx.isBotAdmin) {
        try {
          await ctx.promote();
          users[ctx.sender] = {
            previous_Action: "antidemote"
          };
          if (user_warns[ctx.sender][ctx.action] > 2) {
            return;
          }
          return await sendWelcome(ctx, "*[ANTIPROMOTE START] User promote automatically!* @pp ");
        } catch (err) {
          await ctx.error(" Can't promote user in antidemote\n❲❒❳ GROUP: " + ctx.metadata.subject + "\n❲❒❳ ERROR: " + err + "\n", err, false);
        }
      }
    }
    if (groupSettings.pdm == "true" || isGroupAdmin) {
      if (user_warns[ctx.sender][ctx.action] > 2) {
        return;
      }
      var demoteNotice = " *[SOMEONE DEMOTE HERE]*\n  " + (isGroupAdmin ? "*Note : _I'm Not Admin Here, So I Can't promote Someone while Anti_Demote Activated_*" : "") + "\n\n  ❲❒❳ *User:* _@user_\n❲❒❳ *Position:* _Admin -> Member_ @pp\n  ❲❒❳ *Total Members:* _@count_Members_\n❲❒❳ *Group Name:* @gname\n  \n\n" + Config.caption;
      return await sendWelcome(ctx, demoteNotice);
    }
  } catch (err) {
    console.log("Error From Demote : ", err);
  }
});
