smd({
  pattern: "onlyadmin",
  alias: ["antimessge"],
  desc: "activates and deactivates onlyadmin.",
  category: "group",
  filename: __filename
}, async (ctx, text, {
  cmdName: cmdName
}) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    if (!ctx.isAdmin && !ctx.isCreator) {
      return ctx.reply(tlang().admin);
    }
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || (await groupdb.new({
      id: ctx.chat
    }));
    let toggle = text ? text.toLowerCase().trim() : false;
    let targetCommand = toggle ? toggle.split(" ")[0] : false;
    if (!targetCommand) {
      return await ctx.send("*_" + cmdName + " *" + (groupSettings.onlyadmin === "false" ? "Disabled" : "Enabled") + " in this Group!_*\n *_Use on/off to enable/disable_*");
    } else if (targetCommand.startsWith("off") || targetCommand.startsWith("deact") || targetCommand.startsWith("disable")) {
      if (groupSettings.onlyadmin === "false") {
        return await ctx.reply("*_Onlyadmin Already Disabled in Current Chat_*");
      }
      await groupdb.updateOne({
        id: ctx.chat
      }, {
        onlyadmin: "false"
      });
      await ctx.bot.groupSettingUpdate(ctx.chat, "not_announcement");
      return await ctx.send("*" + cmdName + " succesfully disable in group!_*\n*_Now everyone send message in group_*");
    } else if (targetCommand.startsWith("on") || targetCommand.startsWith("act") || targetCommand.startsWith("enable")) {
      if (groupSettings.onlyadmin === "true") {
        return await ctx.reply("*_Onlyadmin Already Enabled in Current Chat_*");
      }
      if (ctx.isBotAdmin) {
        await groupdb.updateOne({
          id: ctx.chat
        }, {
          onlyadmin: "true"
        });
        await ctx.bot.groupSettingUpdate(ctx.chat, "announcement");
        return await ctx.send("*" + cmdName + " succesfully set to kick msg senders!_*\n*_Now only admins allow to send msg in group_*");
      } else {
        return await ctx.reply("*_UHH Please, Provide Admin Role First_*");
      }
    } else {
      return await ctx.reply("*_Please Provide Valid Instruction_*\n*_Use on/off to enable/disable_*");
    }
  } catch (err) {
    ctx.error(err + "\n\ncommand: onlyadmin", err);
  }
});
smd({
  pattern: "antibot",
  desc: "kick Bot Users from Group.!",
  category: "group",
  filename: __filename
}, async (ctx, text, {
  cmdName: cmdName
}) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    if (!ctx.isAdmin && !ctx.isCreator) {
      return ctx.reply(tlang().admin);
    }
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || (await groupdb.new({
      id: ctx.chat
    }));
    let toggle = text ? text.toLowerCase().trim() : "";
    let antiwordEnabled = toggle.startsWith("on") || toggle.startsWith("act") || toggle.startsWith("enable") || toggle.startsWith("del") || toggle.startsWith("warn") ? "warn" : toggle.startsWith("kic") ? "kick" : toggle.startsWith("off") || toggle.startsWith("reset") || toggle.startsWith("deact") || toggle.startsWith("disable") ? "false" : "";
    if (!antiwordEnabled) {
      return await ctx.send("*_Antibot Currently *" + (groupSettings.antibot === "false" ? "Disabled" : "Enabled") + " in this Group!_*\n*_Use warn/kick/off to enable/disable Antibot_*");
    } else if (antiwordEnabled === "false") {
      if (groupSettings.antibot === "false") {
        return await ctx.reply("*_Antibot Already Disabled in Current Chat_*");
      }
      await groupdb.updateOne({
        id: ctx.chat
      }, {
        antibot: "false"
      });
      return await ctx.send("*_Antibot Succesfully Disable in group!_*");
    } else if (antiwordEnabled === "warn" || antiwordEnabled === "kick") {
      if (groupSettings.antibot === antiwordEnabled) {
        return await ctx.reply("*_Antibot Already set to " + antiwordEnabled + " bots!_*");
      }
      if (!ctx.isBotAdmin) {
        return await ctx.reply("*_Uhh Please, Provide Admin Role First_*");
      }
      await groupdb.updateOne({
        id: ctx.chat
      }, {
        antibot: antiwordEnabled
      });
      return await ctx.send("*_Antibot Succesfully set to " + antiwordEnabled + " Bot Users!_*");
    } else {
      return await ctx.reply("*_Please provide valid instructions!_*\n*_Use warn/kick/off to enable/disable Antibot!_*");
    }
  } catch (err) {
    ctx.error(err + "\n\ncommand: antibot", err);
  }
});
smd({
  pattern: "disable",
  desc: "disable cmds in Group.!",
  category: "group",
  filename: __filename
}, async (ctx, text) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    if (!ctx.isAdmin && !ctx.isCreator) {
      return ctx.reply(tlang().admin);
    }
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || (await groupdb.new({
      id: ctx.chat
    }));
    let toggle = text ? text.toLowerCase().trim() : false;
    let cmdName = toggle ? toggle.split(" ")[0] : "";
    if (!cmdName) {
      return await ctx.send("*Provide cmd name to disable in group*\n*Ex " + prefix + "disable tag(to disabled 'tag' cmd)/info*");
    } else if (cmdName.startsWith("info") || cmdName.startsWith("list") || cmdName.startsWith("cmds")) {
      return await ctx.send(groupSettings.disablecmds === "false" ? "*_Uhh Dear, Theres no cmd disabled in current group_*" : "*_Disable cmds :_* ```" + groupSettings.disablecmds.replace("false,", "") + "```");
    } else if (cmdName.startsWith("enable") || cmdName.startsWith("disable") || cmdName.startsWith("bot")) {
      return await ctx.reply("*_Uhh Dear, I can't disable that cmd_*");
    } else if (cmdName) {
      const cmd = sᴜʜᴀɪʟ_ᴍᴅ.commands.find(item => item.pattern === cmdName) || sᴜʜᴀɪʟ_ᴍᴅ.commands.find(item => item.alias && item.alias.includes(cmdName));
      if (cmd) {
        let escapedPattern = cmd.pattern.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        let cmdPattern = new RegExp("\\b" + escapedPattern + "\\b");
        if (cmdPattern.test(groupSettings.disablecmds)) {
          return await ctx.send("*Uhh Dear, Provided cmd already in disable cmds*");
        }
        var disablecmds = groupSettings.disablecmds + "," + cmd.pattern;
        await groupdb.updateOne({
          id: ctx.chat
        }, {
          disablecmds: disablecmds
        });
        let disablecmdsValue = disablecmds.replace("false,", "");
        return await ctx.send("*_\"" + cmdName + "\" Succesfully added in disable cmds_*" + (disablecmdsValue === "" ? "" : "\n*_Disable cmds :_* ```" + disablecmdsValue + "```"));
      } else {
        return await ctx.reply("*_'" + cmdName + "' is not a bot command, Provide valid command_*");
      }
    }
  } catch (err) {
    ctx.error(err + "\n\ncommand: enable", err);
  }
});
smd({
  pattern: "enable",
  desc: "enable a cmd in Group.!",
  category: "group",
  filename: __filename
}, async (ctx, text) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    if (!ctx.isAdmin && !ctx.isCreator) {
      return ctx.reply(tlang().admin);
    }
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || (await groupdb.new({
      id: ctx.chat
    }));
    let toggle = text ? text.toLowerCase().trim() : false;
    let cmdName = toggle ? toggle.split(" ")[0] : "";
    let escapedCmd = cmdName.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    let cmdPattern = new RegExp("\\b" + escapedCmd + "\\b");
    if (!cmdName || cmdName === "") {
      return await ctx.send("*Please provide disabled cmd name to enable it*\n*Ex " + prefix + "enable tag(if 'tag' cmd disabled)/all(reset disables)*");
    } else if (toggle.startsWith("all")) {
      await groupdb.updateOne({
        id: ctx.chat
      }, {
        disablecmds: "false"
      });
      return await ctx.send("*_All disable cmds succesfully enabled_*");
    } else if (cmdPattern.test(groupSettings.disablecmds) && groupSettings.disablecmds.includes(cmdName)) {
      let disabledCmds = groupSettings.disablecmds.replace(cmdPattern, "");
      await groupdb.updateOne({
        id: ctx.chat
      }, {
        disablecmds: disabledCmds
      });
      return await ctx.send("*_\"" + cmdName.replace(",", "") + "\" Succesfully removed from disable cmds_*");
    } else {
      return await ctx.send("_There's no cmd disabled with *" + cmdName.replace(",", "") + "* name");
    }
  } catch (err) {
    ctx.error(err + "\n\ncommand: disable", err);
  }
});
smd({
  pattern: "antifake",
  desc: "𝗗𝗲𝘁𝗲𝗰𝘁𝘀 𝗽𝗿𝗼𝗺𝗼𝘁𝗲/𝗱𝗲𝗺𝗼𝘁𝗲 𝗮𝗻𝗱 𝘀𝗲𝗻𝗱𝘀 𝗮𝗹𝗲𝗿𝘁. ",
  category: "group",
  filename: __filename
}, async (ctx, text) => {
  try {
    if (!ctx.isGroup) {
      return ctx.reply(tlang().group);
    }
    if (!ctx.isAdmin && !ctx.isCreator) {
      return ctx.reply(tlang().admin);
    }
    let groupSettings = (await groupdb.findOne({
      id: ctx.chat
    })) || (await groupdb.new({
      id: ctx.chat
    }));
    let toggle = text ? text.toLowerCase().trim() : "";
    if (toggle.startsWith("off") || toggle.startsWith("deact") || toggle.startsWith("disable")) {
      if (groupSettings.antifake == "false") {
        return await ctx.send("*Anti_Fake Already Disabled In Current Chat!*");
      }
      await groupdb.updateOne({
        id: ctx.chat
      }, {
        antifake: "false"
      });
      return await ctx.send("*Anti_Fake Disable Succesfully!*");
    } else if (!text) {
      return await ctx.send("*_Antifake " + (groupSettings.antifake === "false" ? "Not set to any" : "set to \"" + groupSettings.antifake + "\"") + " Country Code!_*\n *Provide Country code to Update Antifake Status*\n*Eg: _.antifake 92_*");
    }
    let hours = text ? text.split(",").map(item => parseInt(item)).filter(item => !isNaN(item)).join(",") : false;
    if (!text || !hours) {
      return await ctx.send("*_Please provide a country code First_*\n *_Only numbers to join this group._*\n*_eg: " + prefix + "antifake 92_*");
    } else if (hours) {
      await groupdb.updateOne({
        id: ctx.chat
      }, {
        antifake: "" + hours
      });
      return await ctx.send("*Anti_Fake Succesfully set to \"" + hours + "\"!*\n*_Now People Joined Group Who's Number Start With " + hours + "_*");
    } else {
      return await ctx.send("*_Please provide a Valid country code First_*\n *_Only numbers to join this group._*\n*_eg: " + prefix + "antifake 92_*");
    }
  } catch (err) {
    ctx.error(err + "\n\ncommand: antifake", err);
  }
});
