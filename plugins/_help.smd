// Was the `translatte` package, which drags in got -> cacheable-request -> http-cache-semantics:
// three advisories with no upstream fix (got's UNIX-socket redirect, cacheable-request, and the
// max-stale cross-user cache leak). Same public endpoint in one axios call, same {from,to}
// signature, no dependency.
const translate = async (text, { from = "auto", to = "en" } = {}) => {
  const res = await axios.get("https://translate.google.com/translate_a/single", {
    params: { client: "gti", sl: from, tl: to, hl: to, dt: "t", q: text },
    headers: { "User-Agent": "Mozilla/5.0" }
  });
  const data = typeof res.data === "string" ? JSON.parse(res.data) : res.data;
  return { text: (data[0] || []).map(part => part[0]).join("") };
};
