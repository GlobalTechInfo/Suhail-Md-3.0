sᴜʜᴀɪʟ_ᴍᴅ.cmd({
  pattern: "setcmd",
  desc: "To check ping",
  category: "general",
  fromMe: true,
  filename: __filename
}, async (ctx, quoted, {
  Void: unused
}) => {
  try {
    if (!quoted) {
      return await ctx.send("*_Please provide cmd name by replying a Sticker_*");
    }
    let input = quoted.split(",");
    var cmdName;
    var args;
    let stickerCmd = false;
    if (ctx.quoted) {
      let mtype = ctx.quoted.mtype;
      if (mtype == "stickerMessage" && quoted) {
        stickerCmd = true;
        cmdName = quoted.split(" ")[0];
        args = "sticker-" + ctx.quoted.msg.fileSha256;
      }
    }
    if (!stickerCmd && input.length > 1) {
      args = input[0].trim().toLowerCase();
      cmdName = input[1].trim().toLowerCase();
    } else if (!stickerCmd) {
      return await ctx.send("*_Uhh Dear, Give Cmd With New Name_*\n*Eg: _.setcmd New_Name, Cmd_Name_*");
    }
    if (args.length < 1) {
      return await ctx.reply("*_Uhh Please, Provide New_Cmd Name First_*");
    }
    if (global.setCmdAlias[args]) {
      return await ctx.send("*_\"" + (stickerCmd ? "Given Sticker" : args) + "\" Already set for \"" + global.setCmdAlias[args] + "\" Cmd, Please try another " + (stickerCmd ? "Sticker" : "Name") + "_*");
    }
    const cmd = sᴜʜᴀɪʟ_ᴍᴅ.commands.find(item => item.pattern === cmdName) || sᴜʜᴀɪʟ_ᴍᴅ.commands.find(item => item.alias && item.alias.includes(cmdName));
    if (cmd) {
      global.setCmdAlias[args] = cmd.pattern;
      return await ctx.send("*_Cmd \"" + global.setCmdAlias[args] + "\" Succesfully set to \"" + (stickerCmd ? "Sticker" : args) + "\"._*\n*_These all names are reset, If bot restart_*");
    } else {
      return await ctx.send("*_Provided Cmd( " + cmdName + ") not found in bot cmds. Please Provide Valid cmd Name_*");
    }
  } catch (err) {
    await ctx.error(err + "\nCommand:setcmd", err);
  }
});
sᴜʜᴀɪʟ_ᴍᴅ.cmd({
  pattern: "delcmd",
  desc: "To check ping",
  category: "general",
  fromMe: true,
  filename: __filename
}, async (ctx, text, {
  Void: unused
}) => {
  try {
    let cmdName = text ? text.split(" ")[0].trim().toLowerCase() : "";
    let deletedCmd = false;
    if (ctx.quoted) {
      if (ctx.quoted.mtype == "stickerMessage") {
        deletedCmd = true;
        cmdName = "sticker-" + ctx.quoted.msg.fileSha256;
      } else if (!text) {
        return await ctx.send("*_Please reply to a Sticker that set for a Cmd_*");
      }
    } else if (!text) {
      return await ctx.send("*_Uhh Dear, provide Name that set to a cmd_*\n*Eg: _.delcmd Cmd_Name_*");
    }
    if (global.setCmdAlias[cmdName]) {
      await ctx.send("*_\"" + (deletedCmd ? "Given Sticker" : cmdName) + "\" deleted Succesfully at \"" + global.setCmdAlias[cmdName] + "\" cmd_*");
      delete global.setCmdAlias[cmdName];
      return;
    } else {
      return await ctx.send("*_\"" + (deletedCmd ? "Given Sticker" : cmdName) + "\" not Set for any cmd._*\n *_Please Provide Valid " + (deletedCmd ? "Sticker" : "cmd Name") + " to delete_*");
    }
  } catch (err) {
    await ctx.error(err + "\nCommand:delcmd", err);
  }
});
sᴜʜᴀɪʟ_ᴍᴅ.smd({
  pattern: "ping",
