smd({
  cmdname: "help",
  alias: ["categories", "ctgry", "category"],
  desc: "category list",
  category: "general"
}, async (ctx, text) => {
  try {
    if (text.split(" ")[0]) {
      let commandList = [];
      const cmd = commands.find(item => item.pattern === text.split(" ")[0].toLowerCase());
      if (cmd) {
        commandList.push("*🍁Command:* " + cmd.pattern);
        if (cmd.category) {
          commandList.push("*🧩Category:* " + cmd.category);
        }
        if (cmd.alias && cmd.alias[0]) {
          commandList.push("*🧩Alias:* " + cmd.alias.join(", "));
        }
        if (cmd.desc) {
          commandList.push("*🧩Description:* " + cmd.desc);
        }
        if (cmd.use) {
          commandList.push("*〽️Usage:*\n ```" + prefix + cmd.pattern + " " + cmd.use + "```");
        }
        await ctx.reply(commandList.join("\n"));
      }
    }
    const menu = {};
    commands.map(async (item, position) => {
      if (item.dontAddCommandList === false && item.pattern !== undefined) {
        if (!menu[item.category]) {
          menu[item.category] = [];
        }
        menu[item.category].push(item.pattern);
      }
    });
    let menuMode = Math.round(Math.random());
    let listLabel = menuMode === 0 ? "MENU" : "COMMANDS";
    let menuCaption = "┏━━━━━━━━━━━━━━━━━━━━━━━━\n┃\t *SUHAIL-MD_" + listLabel + "_LIST* \n┗━━━━━━━━━━━━━━━━━━━━━━━━\n\n\t```Reply the number you wants to select```\n\n";
    let index = 1;
    let total = 0;
    for (const category in menu) {
      total += 1;
      if (text.toLowerCase() == category.toLowerCase()) {
        menuCaption = "┏━━⟪ *" + category.toUpperCase() + "* ⟫━━⦿\n\n";
        for (const pattern of menu[category]) {
          menuCaption += "┃ ✗ " + fancytext(pattern, 1) + "\n";
        }
        menuCaption += "\n┗━━━━━━━━━━━━━━⦿";
        break;
      }
      if (total >= 10) {
        index += 1;
        total = 0;
      }
      menuCaption += "\n*" + index + "." + total + " |" + category.toUpperCase() + " " + listLabel + "*\n";
    }
    ;
    menuCaption += "\n\n" + Config.caption;
    return await ctx.sendUi(ctx.jid, {
      caption: menuCaption
    });
  } catch (err) {
    await ctx.error(err + "\nCommand:help", err);
  }
});
