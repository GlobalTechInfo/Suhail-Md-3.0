sᴜʜᴀɪʟ_ᴍᴅ.cmd({
  cmdname: "menu",
  desc: "Help list",
  type: "general",
  filename: __filename
}, async (ctx, text) => {
  try {
    const {
      commands: commandList
    } = require("../lib");
    if (text.split(" ")[0]) {
      let foundCommands = [];
      const cmd = commandList.find(item => item.pattern === text.split(" ")[0].toLowerCase());
      if (cmd) {
        foundCommands.push("*🍁Command:* " + cmd.pattern);
        if (cmd.category) {
          foundCommands.push("*🧩Category:* " + cmd.category);
        }
        if (cmd.alias && cmd.alias[0]) {
          foundCommands.push("*🧩Alias:* " + cmd.alias.join(", "));
        }
        if (cmd.desc) {
          foundCommands.push("*🧩Description:* " + cmd.desc);
        }
        if (cmd.use) {
          foundCommands.push("*〽️Usa:*\n ```" + prefix + cmd.pattern + " " + cmd.use + "```");
        }
        if (cmd.usage) {
          foundCommands.push("*〽️Usage:*\n ```" + cmd.usage + "```");
        }
        await ctx.reply(foundCommands.join("\n"));
      }
    }
    var menuTitle;
    var separator;
    var menuFooter;
    var menuBullet;
    var commandDesc;
    var menuLine;
    var menuSection;
    let sorted = 0;
    if (Config.menu === "") {
      sorted = Math.floor(Math.random() * 4) + 1;
    }
    if (sorted == 1 || Config.menu.trim().startsWith("1") || Config.menu.toLowerCase().includes("aztec")) {
      menuTitle = "┏━━⟪ *" + Config.botname + "* ⟫━━⦿";
      separator = "┃ ✗";
      menuFooter = "┗━━━━━━━━━━━━━━━⦿";
      menuBullet = "┌──『";
      commandDesc = "』──❖\n";
      menuLine = " | ";
      menuSection = "\n└──────────────◉";
    } else if (sorted == 2 || Config.menu.trim().startsWith("2") || Config.menu.toLowerCase().includes("a17")) {
      menuTitle = "┌───═[ *" + Config.botname + "* ]═──▸\n│╭────────────···▸\n┴│▸";
      separator = "⬡│▸";
      menuFooter = "┬│▸\n│╰─────────────···▸\n└───────────────···▸";
      menuBullet = "┌───〈";
      commandDesc = "〉───◆\n│╭─────────────···▸\n┴│▸";
      menuLine = "⬡│▸ ";
      menuSection = "┬│▸\n│╰────────────···▸▸\n└───────────────···▸";
    } else {
      menuTitle = "╭────《  " + Config.botname + "  》────⊷\n│ ╭──────✧❁✧──────◆";
      separator = "│ │";
      menuFooter = "│ ╰──────✧❁✧──────◆\n╰══════════════════⊷";
      menuBullet = "╭────❏";
      commandDesc = "❏";
      menuLine = "│";
      menuSection = "╰━━━━━━━━━━━━━━──⊷";
    }
    const menu = {};
    commandList.map(async (item, index) => {
      if (item.dontAddCommandList === false && item.pattern !== undefined) {
        if (!menu[item.category]) {
          menu[item.category] = [];
        }
        menu[item.category].push(item.pattern);
      }
    });
    const menuHeader = ctx.time;
    const menuSubtitle = ctx.date;
    let menuCaption = menuTitle + "\n" + separator + " Theme:- " + tlang().title + "\n" + separator + " Owner:- " + Config.ownername + "\n" + separator + " Plugins:- " + commandList.length + "\n" + separator + " Uptime:- " + runtime(process.uptime()) + "\n" + separator + " Mem:- " + formatp(os.totalmem() - os.freemem()) + "/" + formatp(os.totalmem()) + "\n" + separator + " Time:- " + menuHeader + "\n" + separator + " Date:- " + menuSubtitle + "\n" + menuFooter + "\n\n";
    for (const category in menu) {
      menuCaption += menuBullet + " *" + tiny(category) + "* " + commandDesc + "\n";
      if (text.toLowerCase() == category.toLowerCase()) {
        menuCaption = menuBullet + " *" + tiny(category) + "* " + commandDesc + "\n";
        for (const categoryName of menu[category]) {
          menuCaption += menuLine + " " + fancytext(categoryName, 1) + "\n";
        }
        menuCaption += menuSection + "\n";
        break;
      } else {
        for (const categoryName of menu[category]) {
          menuCaption += menuLine + " " + fancytext(categoryName, 1) + "\n";
        }
        menuCaption += menuSection + "\n";
      }
    }
    menuCaption += Config.caption;
    let menuContent = {
      caption: menuCaption
    };
    return await ctx.sendUi(ctx.chat, menuContent, ctx);
  } catch (err) {
    await ctx.error(err + "\nCommand:menu", err);
  }
});
sᴜʜᴀɪʟ_ᴍᴅ.cmd({
  pattern: "list",
  desc: "list menu",
  category: "general",
  react: "🥀"
}, async ctx => {
  try {
    const {
      commands: menuBox
    } = require("../lib");
    let menuCaption = "\n  ╭━━〘 *" + Config.botname + "* 〙────⊷     \n  ┃ ✭ Theme: " + tlang().title + "\n  ┃ ✭ Prefix: " + prefix + "\n  ┃ ✭ Owner: " + Config.ownername + "\n  ┃ ✭ Commands: " + menuBox.length + "\n  ┃ ✭ Uptime: " + runtime(process.uptime()) + "\n  ┃ ✭ Mem: " + formatp(os.totalmem() - os.freemem()) + "/" + formatp(os.totalmem()) + "\n  ╰━━━━━━━━━━━━━━⊷\n";
    for (let i = 0; i < menuBox.length; i++) {
      if (menuBox[i].pattern == undefined) {
        continue;
      }
      menuCaption += "*" + (i + 1) + " " + fancytext(menuBox[i].pattern, 1) + "*\n";
      menuCaption += "  " + fancytext(menuBox[i].desc, 1) + "\n";
    }
    return await ctx.sendUi(ctx.chat, {
      caption: menuCaption + Config.caption
    });
  } catch (err) {
    await ctx.error(err + "\nCommand:list", err);
  }
});
