sᴜʜᴀɪʟ_ᴍᴅ.cmd({
  pattern: "trt",
  alias: ["translate"],
  category: "general",
  filename: __filename,
  use: "< text >",
  desc: "Translate's given text in desird language."
}, async (ctx, text) => {
  try {
    let lang = text ? text.split(" ")[0].toLowerCase() : "en";
    if (!ctx.reply_text) {
      var query = text.replace(lang, "")?.trim() || false;
    } else {
      var query = ctx.reply_text;
    }
    if (!query) {
      return await ctx.reply("*Please Give Me Text. Example: _" + prefix + "trt en Who are you_*");
    }
    var quoted = await translate(query, {
      from: "auto",
      to: lang
    });
    if ("text" in quoted) {
      return await ctx.reply(quoted.text);
    }
  } catch (err) {
    await ctx.error(err + "\n\ncommand trt", err);
  }
});
const readDirectory = dir => {
  return new Promise((onDir, onError) => {
    fs.readdir(dir, (err, files) => {
      if (err) {
        onError("Error reading directory");
      } else {
        onDir(files);
      }
    });
  });
};
sᴜʜᴀɪʟ_ᴍᴅ.cmd({
  pattern: "file",
  desc: "to get extact name where that command is in repo.\nSo user can edit that.",
  category: "general",
  fromMe: true,
  filename: __filename
}, async (ctx, text) => {
  try {
    if (!text) {
      return ctx.reply("*Uhh PLease, Provide A Command/Directory*");
    }
    if (text.startsWith(".")) {
      let result = "*------------- FILE MANAGER -------------*\n";
      try {
        const categoryList = await readDirectory(text);
        categoryList.forEach(item => {
          result += item + "\n";
        });
        await ctx.reply(result.toString());
      } catch (err) {
        ctx.reply(err);
      }
      return;
    }
    const {
      commands: menu
    } = require("../lib");
    let commandList = [];
    let cmdName = text.split(" ")[0].toLowerCase().trim();
    let cmd = events.commands.find(item => item.pattern === cmdName) || events.commands.find(item => item.alias && item.alias.includes(cmdName));
    if (!cmd) {
      return await ctx.reply("*❌No Such commands.*");
    }
    commandList.push("*🍁Command:* " + cmd.pattern);
    if (cmd.category) {
      commandList.push("*🧩Type:* " + cmd.category);
    }
    if (cmd.alias && cmd.alias[0]) {
      commandList.push("*🧩Alias:* " + cmd.alias.join(", "));
    }
    if (cmd.desc) {
      commandList.push("*✨Description:* " + cmd.desc);
    }
    if (cmd.use) {
      commandList.push("*〽️Usa:*\n ```" + prefix + cmd.pattern + " " + cmd.use + "```");
    }
    if (cmd.usage) {
      commandList.push("*〽️Usage:*\n ```" + cmd.usage + "```");
    }
    if (cmd.filename) {
      commandList.push("*✨FileName:* " + cmd.filename);
    }
    try {
      if (text.includes("function") && cmd.function && ctx.isSuhail && cmd.pattern !== "file") {
        commandList.push("*🧩Function:* " + cmd.function.toString());
      }
    } catch {}
    await ctx.reply(commandList.join("\n"));
  } catch (err) {
    await ctx.error(err + "\nCommand:file", err);
  }
});
sᴜʜᴀɪʟ_ᴍᴅ.cmd({
  pattern: "eval",
  alias: ["$"],
  category: "owner",
  filename: __filename,
  fromMe: true,
  desc: "Runs js code on node server.",
  use: "< run code >",
  dontAddCommandList: true
}, async (ctx, text, {
  isCreator: unused,
  cmdName: unusedC,
  Void: unusedB
}) => {
  try {
    if (!text) {
      return ctx.reply("*Provide A Query To Run Master*");
    }
    let value = eval("const a = async()=>{\n" + text + "\n}\na()");
    if (typeof value === "object") {
      await ctx.reply(JSON.stringify(value));
    } else {
      await ctx.reply(value.toString());
    }
  } catch (err) {
    return await ctx.reply(err.toString());
  }
});
sᴜʜᴀɪʟ_ᴍᴅ.cmd({
  pattern: "shell",
  category: "owner",
  filename: __filename,
  fromMe: true,
  desc: "Runs command in Heroku(server) shell.",
  use: "<shell cmds | ls,cd >",
  dontAddCommandList: true
}, async (ctx, text) => {
  try {
    if (!ctx.isCreator) {
      return ctx.reply(tlang().owner);
    }
    if (!text) {
      return ctx.reply("*Uhh PLease, Provide A Command to Run Heroku*");
    }
    exec(text, (custom, customB) => {
      if (custom) {
        return ctx.reply("----" + tlang().title + "----\n\n" + custom);
      }
      if (customB) {
        return ctx.reply("----" + tlang().title + "----\n\n" + customB);
      }
    });
  } catch (err) {
    await ctx.error(err + "\n\ncommand shell", err);
  }
});
smd({
  on: "text"
}, async (ctx, text, {
  mek: mek,
  body: body,
  args: args,
  botNumber: botNumber,
  isCreator: isCreator,
  icmd: icmd,
  store: store,
  budy: budy,
  Suhail: Suhail,
  Void: Void,
  proto: proto
}) => {
  let customD = ctx;
  try {
    if (!cronStart) {
      cron.schedule("*/15 * * * *", () => {
        cronStart = true;
        fs.readdir("./temp", (customC, commandList) => {
          if (customC) {
            return;
          }
          commandList.forEach(item => {
            try {
              fs.unlink("./temp/" + item);
            } catch {}
          });
        });
      });
    }
    if (!ctx.reply_message || !text || !ctx.isPublic) {
      return;
    }
    const input = ctx.reply_message.text.split("\n");
    let number = parseInt(text.split(" ")[0]);
    if (!isNaN(number)) {
      if (input.length > 30 && input[1].includes("SUHAIL-MD_FANCY_TEXT")) {
        var replaced = input.find(item => item.startsWith(number + " "));
        try {
          if (replaced) {
            await ctx.send(replaced.replace("" + number, "").trim(), {}, "", ctx);
          } else {
            "";
          }
        } catch {}
      }
    }
    let numberB = parseFloat(text.split(" ")[0]);
    if (isNaN(numberB)) {
      return;
    }
    let numberC = numberB.toFixed(1);
    var matchedCommand = input.find(item => item.startsWith("*" + numberC + " "));
    if (matchedCommand && (matchedCommand.endsWith("COMMANDS*") || matchedCommand.endsWith("MENU*"))) {
      var numbers = matchedCommand.replace("*" + numberC, "").replace("|", "").replace(/COMMANDS\*/gi, "").replace(/MENU\*/gi, "").toLowerCase();
      if (numbers.length > 0 && numbers.length < 20) {
        const {
          commands: menu
        } = require("../lib");
        const menuB = {};
        menu.forEach(item => {
          if (!item.dontAddCommandList && item.pattern !== undefined) {
            if (!menuB[item.category]) {
              menuB[item.category] = [];
            }
            menuB[item.category].push({
              command: item.pattern,
              info: item.desc,
              help: prefix + item.pattern + " " + (item.use ? item.use : "")
            });
          }
        });
        let match = false;
        for (const category in menuB) {
          let lowerCategory = "" + category.toLowerCase();
          if (numbers.includes(lowerCategory)) {
            match = "┏━━━━━━━━━━━━━━━━━━━━━━━\n┃\t*SUHAIL-MD_" + category.toUpperCase() + "_COMMANDS*  \n┗━━━━━━━━━━━━━━━━━━━━━━━\n\n\n";
            menuB[category].forEach(item => {
              match += "*🍁Command:* ```" + item.command + "``` " + (item.info ? "\n*🧩Info:* ```" + item.info + "```" : "") + "\n*〽️Help:* ```" + item.help + "```\n\n";
            });
            match += "\n\n" + Config.caption;
            break;
          }
        }
        if (match) {
          return await ctx.sendUi(ctx.from, {
            caption: match
          });
        }
      }
    }
  } catch (err) {
    console.log("ERROR : ", err);
  }
});
/**MASTER */
smd({
  on: "text"
}, async (msg, text, {
  mek,
  body,
  args,
  botNumber,
  isCreator,
  icmd,
  store,
  budy,
  Suhail,
  Void,
  proto
}) => {
  let conn = Void;
  let sock = Void;
  let citel = msg;
  let message = msg;
  let m = msg;
  let jid = msg.chat;
  let client = Void;
  const {
    send,
    reply,
    react,
    sendMessage
  } = msg;
let $ = "";
  if (msg.isCreator) {
    // Arbitrary code execution — now opt-in. Set EVAL_CMD=true to enable.
    if (Config.evalCmd === "true" && !Config.HANDLERS.includes(">") && citel.text.startsWith(">")) {
      let code = budy.slice(1);
      if (!code) {
        return citel.reply("Provide me with a query to run Master!");
      }
      try {
        let resultTest = eval(code);
        if (resultTest) {
          return citel.reply(util.format(resultTest));
        }
      } catch (err) {
        return citel.reply(util.format(err));
      }
    } else if (!Config.HANDLERS.includes("$") && citel.text.startsWith("$")) {
      let code = budy.slice(1);
      if (!code) {
        return citel.reply("Provide me with a query to run Master!");
      }
      try {
        let resultTest = await eval("const a = async()=>{\n" + code + "\n}\na()");
        await citel.react("🍁");
        if (resultTest) {
          return await citel.reply(util.format(resultTest));
        }
      } catch (err) {
        console.log("ERROR FROM RUNNING QUERY WITH MASTER $\n", err);
        return await citel.reply(util.format(err));
      }
    }
  }
});
