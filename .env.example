# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# OpenAI (chat / dalle / imagine fallback) — https://platform.openai.com/account/api-keys
# NEVER commit a real key here — this is a template file tracked by git.
OPENAI_API_KEY=your-openai-api-key-here

# Hugging Face user access token (used by the imagine/draw command) — https://huggingface.co/settings/tokens
# NEVER commit a real token here — this is a template file tracked by git.
HF_TOKEN=your-huggingface-token-here

# Optional
# SESSION_ID=
# SUDO=
# OWNER_NUMBER=
# PREFIX=.
# REMOVE_BG_KEY=
# MONGODB_URI=
