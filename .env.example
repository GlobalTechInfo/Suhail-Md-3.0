# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# OpenAI (chat / dalle / imagine fallback) — https://platform.openai.com/account/api-keys
OPENAI_API_KEY=

# Hugging Face user access token (used by the imagine/draw command) — https://huggingface.co/settings/tokens
HF_TOKEN=

# Telegram bot token used by the .tgs sticker downloader — create one with @BotFather
TELEGRAM_BOT_TOKEN=

# Optional
# SESSION_ID=
# SUDO=
# OWNER_NUMBER=
# PREFIX=.
# REMOVE_BG_KEY=
# MONGODB_URI=
